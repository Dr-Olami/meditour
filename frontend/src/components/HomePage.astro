---
import { getTranslations, type Locale } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { StepTimeline } from '../design-system/components/organisms/StepTimeline';
import { TreatmentCard } from '../design-system/components/organisms/TreatmentCard';
import { DoctorCard } from '../design-system/components/organisms/DoctorCard';
import { HospitalCard } from '../design-system/components/organisms/HospitalCard';
import { TestimonialCarousel } from '../design-system/components/organisms/TestimonialCarousel';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { HeroSection } from '../design-system/components/organisms/HeroSection';
import { StatementSection } from '../design-system/components/organisms/StatementSection';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { StatCounter } from '../design-system/components/organisms/StatCounter';
import { WhyUsSection } from '../design-system/components/organisms/WhyUsSection';
import { LeadForm } from '../design-system/components/organisms/LeadForm';
import { WhatsAppCTA } from '../design-system/components/organisms/WhatsAppCTA';
import { ServiceCardsSection } from '../design-system/components/organisms/ServiceCardsSection';
import CountriesServeSection from '../design-system/components/organisms/CountriesServeSection.astro';
import { Icon } from '../design-system/components/atoms/Icon';
import { Link } from '../design-system/components/atoms/Link';
import { getInquiryLink } from '../lib/whatsapp';
import { LEAD_SOURCE } from '../lib/crm';
import { LeadModalTrigger } from '../design-system/components/organisms/LeadModalTrigger';
import type { Doctor } from '../design-system/components/organisms/DoctorCard';
import type { Hospital } from '../design-system/components/organisms/HospitalCard';
import type { TestimonialItem } from '../design-system/components/molecules/TestimonialCard';
import type { CountryMetadata } from '../data/countries';

interface HomeTreatment {
  name: string;
  description: string;
  fromPrice?: string;
  category?: string;
  tags?: string[];
  href: string;
  image?: string;
}

interface HomeProcedure {
  name: string;
  summary?: string;
  fromPrice?: string;
  toPrice?: string;
  href: string;
}

interface HomeTreatmentProcedures {
  treatmentName: string;
  treatmentHref: string;
  procedures: HomeProcedure[];
}

interface Props {
  locale: Locale;
  treatments: HomeTreatment[];
  treatmentProcedures?: HomeTreatmentProcedures[];
  featuredDoctors: Doctor[];
  featuredHospitals: Hospital[];
  testimonials: TestimonialItem[];
  countries: CountryMetadata[];
  faqs: { question: string; answer: string }[];
}

const {
  locale,
  treatments,
  treatmentProcedures = [],
  featuredDoctors,
  featuredHospitals,
  testimonials,
  countries,
  faqs,
} = Astro.props;
const t = getTranslations(locale);
const prefix = locale === 'bn' ? '/bn' : '';

const navLinks = getNavLinks(locale);

const faq = faqs;

const stats = [
  { value: '3,500+', label: t.stats.patients },
  { value: '25+', label: t.stats.hospitals },
  { value: '98%', label: t.stats.success },
  { value: '24/7', label: t.stats.support },
];

const treatmentOptions = treatments.map((tx) => ({ value: tx.name, label: tx.name }));

const whatsappInquiryHref = getInquiryLink();

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com';
---

<Navbar
  brand={t.site.name}
  links={navLinks}
  cta={{ label: t.nav.cta, href: '#contact' }}
  locale={locale}
  currentPath={Astro.url.pathname}
  phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
  callLabel={t.nav.call}
  whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
  whatsappLabel={t.nav.whatsapp}
  client:load
/>

<!-- Hero -->
<HeroSection
  headline={t.hero.title}
  subheadline={t.hero.subtitle}
  eyebrow={t.site.name}
  primaryCta={{ label: t.hero.primaryCta, href: '#contact' }}
  data-anim="fade-in-up"
/>

<!-- Service cards -->
<ServiceCardsSection
  exploreLabel={t.serviceCards.explore}
  contactLabel={t.serviceCards.contact}
  topCard={{
    title: t.serviceCards.top.title,
    subtitle: t.serviceCards.top.subtitle,
    image: '/images/treatments/cardiology.webp',
    exploreHref: `${prefix}/second-opinion`,
    contactHref: '#contact',
  }}
  bottomCards={[
    {
      title: t.serviceCards.bottom[0].title,
      subtitle: t.serviceCards.bottom[0].subtitle,
      image: '/images/treatments/infertility-treatment.webp',
      exploreHref: `${prefix}/treatments/infertility-treatment`,
      contactHref: '#contact',
    },
    {
      title: t.serviceCards.bottom[1].title,
      subtitle: t.serviceCards.bottom[1].subtitle,
      image: '/images/treatments/organ-treatment.webp',
      exploreHref: `${prefix}/treatments/organ-treatment`,
      contactHref: '#contact',
    },
  ]}
  bottomWideCard={{
    title: t.serviceCards.bottomWide.title,
    subtitle: t.serviceCards.bottomWide.subtitle,
    image: '/images/treatments/cancer-treatment.webp',
    exploreHref: `${prefix}/treatments/cancer-treatment`,
    contactHref: '#contact',
  }}
/>

<!-- Doctor showcase — headline + wide imagery -->
<section class="bg-cream-100 pb-20 pt-8" data-anim="scroll-reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-0">
    {/* Centered headline — two lines, second line emphasized */}
    <div class="text-center" data-anim="stagger-children">
      <h2
        class="font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl md:text-5xl lg:text-6xl"
        data-anim="fade-in-up"
      >
        <span class="block">{t.doctorShowcase.headlineLine1}</span>
        <span class="block text-ink">
          {t.doctorShowcase.headlineLine2}
        </span>
      </h2>
      <p
        class="mt-6 text-base font-medium text-ink sm:mt-8 sm:text-xl md:mt-8 md:text-2xl"
        data-anim="fade-in-up"
      >
        <span class="block sm:inline">{t.doctorShowcase.subheadLine1a}</span>
        <span class="block sm:inline">{t.doctorShowcase.subheadLine1b}</span>
        <span class="block">{t.doctorShowcase.subheadLine2}</span>
      </p>
    </div>

    {/* Wide imagery card with bento CTA buttons */}
    <div class="mt-12 overflow-hidden rounded-card shadow-base" data-anim="fade-in-up">
      <div class="relative h-[480px] md:h-[640px] lg:h-[760px]">
        <img
          src="/images/patterns/doctor-showcase.webp"
          alt={t.doctorShowcase.headlineLine1 + ' ' + t.doctorShowcase.headlineLine2}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width={1280}
          height={760}
        />
        <div class="from-ink/80 via-ink/20 absolute inset-0 bg-gradient-to-t to-transparent"></div>
        {/* Bento CTA buttons — high contrast over imagery */}
        <div class="absolute bottom-0 left-0 right-0 flex justify-center gap-4 p-6 md:p-10">
          <LeadModalTrigger
            client:visible
            label={t.doctorShowcase.bookNow}
            modalTitle={t.leadModal.title}
            modalSubtitle={t.leadModal.subtitle}
            closeLabel={t.leadModal.close}
            source={LEAD_SOURCE.WEBSITE}
            variant="dark"
            className="rounded-pill px-7"
          />
          <a
            href={`tel:+${phoneNumber}`}
            class="inline-flex h-12 items-center justify-center rounded-pill bg-cream-100 px-7 text-sm font-semibold text-ink transition-opacity hover:opacity-90 md:text-base"
          >
            {t.doctorShowcase.callConcierge}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Us -->
<WhyUsSection title={t.whyUs.title} items={t.whyUs.items} client:visible />

<!-- Stats bar -->
<section id="stats" class="bg-cream-200 py-14" data-anim="scroll-reveal">
  <div class="container">
    <h2 class="mb-10 text-center font-display text-2xl font-bold text-ink" data-anim="fade-in-up">
      {t.stats.title}
    </h2>
    <StatCounter stats={stats} />
  </div>
</section>

<!-- Statement -->
<StatementSection
  statement={locale === 'bn'
    ? 'রোগীর যাত্রাটি কেবল চিকিৎসা নয় — এটি বিশ্বাস, যত্ন এবং সংযোগ।'
    : "A patient's journey is not just medical — it is trust, care, and connection."}
  caption={locale === 'bn' ? 'আমাদের দর্শন' : 'Our philosophy'}
/>

<!-- Countries We Serve — dark two-column band with flag grid -->
<CountriesServeSection
  locale={locale}
  countries={countries}
  countriesHref={`${prefix}/countries`}
/>

<!-- How it works -->
<section id="steps" class="bg-cream-100 py-20" data-anim="scroll-reveal">
  <div class="container">
    <h2
      class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl"
      data-anim="fade-in-up"
    >
      {t.steps.title}
    </h2>
    <StepTimeline steps={t.steps.items} />
  </div>
</section>

<!-- Treatments -->
<section id="treatments" class="bg-cream-200 py-20" data-anim="scroll-reveal">
  <div class="container">
    <div class="mb-10 flex items-end justify-between" data-anim="fade-in-up">
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{t.treatments.title}</h2>
      <Link href={`${prefix}/treatments`} class="text-ink/60 text-sm font-medium hover:text-ink"
        >{t.treatments.viewAll}</Link
      >
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-anim="stagger-cards">
      {
        treatments
          .slice(0, 3)
          .map((treatment) => <TreatmentCard treatment={treatment} data-anim="card-hover" />)
      }
    </div>

    {/* Procedure samples grouped by treatment */}
    {
      treatmentProcedures.length > 0 && (
        <div class="mt-12 space-y-10" data-anim="fade-in-up">
          {treatmentProcedures.map(
            (group) =>
              group.procedures.length > 0 && (
                <div>
                  <div class="mb-4 flex items-center gap-2">
                    <h3 class="font-display text-lg font-bold text-ink">{group.treatmentName}</h3>
                    <Link
                      href={group.treatmentHref}
                      class="text-xs font-medium text-violet-600 hover:underline"
                    >
                      {locale === 'bn' ? 'সব দেখুন' : 'View all'}
                    </Link>
                  </div>
                  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    {group.procedures.map((proc) => {
                      const price =
                        proc.fromPrice && proc.toPrice
                          ? `${proc.fromPrice} – ${proc.toPrice}`
                          : proc.fromPrice;
                      return (
                        <a
                          href={proc.href}
                          class="group rounded-card border border-cream-300 bg-cream-100 p-4 transition-all hover:border-violet-300 hover:shadow-base"
                        >
                          <p class="text-sm font-semibold text-ink">{proc.name}</p>
                          {proc.summary && (
                            <p class="text-ink/60 mt-1 line-clamp-2 text-xs">{proc.summary}</p>
                          )}
                          {price && (
                            <p class="mt-2 text-xs font-medium text-violet-600">
                              {locale === 'bn' ? 'খরচ' : 'Cost'}: {price}
                            </p>
                          )}
                          <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-violet-600 group-hover:underline">
                            {locale === 'bn' ? 'বিস্তারিত' : 'Learn more'}
                            <Icon name="arrow-right" size={12} />
                          </span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )
          )}
        </div>
      )
    }
  </div>
</section>

<!-- Doctors teaser -->
{
  featuredDoctors.length > 0 && (
    <section class="bg-cream-100 py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="mb-10 flex items-end justify-between" data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {locale === 'bn' ? 'আমাদের বিশেষজ্ঞরা' : 'Meet our specialists'}
          </h2>
          <Link href={`${prefix}/doctors`} class="text-ink/60 text-sm font-medium hover:text-ink">
            {locale === 'bn' ? 'সব বিশেষজ্ঞ দেখুন' : 'View all doctors'}
          </Link>
        </div>
        <div class="grid gap-6 lg:grid-cols-2" data-anim="stagger-cards">
          {featuredDoctors.map((doctor) => (
            <DoctorCard
              key={doctor.name}
              doctor={doctor}
              bookLabel={t.doctors.bookCta}
              whatsappLabel={t.doctors.detail.whatsappCta}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- Hospitals teaser -->
{
  featuredHospitals.length > 0 && (
    <section class="bg-cream-200 py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="mb-10 flex items-end justify-between" data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {locale === 'bn' ? 'আমাদের অংশীদার হাসপাতাল' : 'Our partner hospitals'}
          </h2>
          <Link href={`${prefix}/hospitals`} class="text-ink/60 text-sm font-medium hover:text-ink">
            {locale === 'bn' ? 'সব হাসপাতাল দেখুন' : 'View all hospitals'}
          </Link>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-anim="stagger-cards">
          {featuredHospitals.map((hospital) => (
            <HospitalCard
              key={hospital.slug}
              hospital={hospital}
              viewLabel={t.hospitals.viewHospital}
              locale={locale}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- Testimonials -->
<section id="testimonials" class="bg-cream-100 py-20" data-anim="scroll-reveal">
  <TestimonialCarousel title={t.testimonials.title} items={testimonials} client:visible />
</section>

<!-- FAQ -->
<section id="faq" class="bg-cream-200 py-20" data-anim="scroll-reveal">
  <div class="container max-w-3xl">
    <h2
      class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl"
      data-anim="fade-in-up"
    >
      {t.faq.title}
    </h2>
    <FAQAccordion items={faq} />
  </div>
</section>

<!-- CTA card -->
<TreatmentsCtaSection
  locale={locale}
  primaryCta={{ label: t.nav.cta, href: '#contact' }}
  secondaryCta={{ label: locale === 'bn' ? 'হোয়াটসঅ্যাপ' : 'WhatsApp', href: whatsappInquiryHref }}
/>

<!-- Contact form -->
<section id="contact" class="bg-cream-200 py-20" data-anim="scroll-reveal">
  <div class="container grid gap-12 lg:grid-cols-2">
    <div data-anim="fade-in-up">
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{t.cta.formTitle}</h2>
      <p class="text-ink/60 mt-4 text-lg">{t.cta.subtitle}</p>
      <div class="text-ink/60 mt-8 space-y-3">
        <p class="flex items-center gap-3">
          <Icon name="phone" size={20} />
          <Link href={`tel:+${phoneNumber}`}>+{phoneNumber}</Link>
        </p>
        <p class="flex items-center gap-3">
          <Icon name="mail" size={20} />
          <Link href={`mailto:${contactEmail}`}>{contactEmail}</Link>
        </p>
        <p class="flex items-center gap-3">
          <Icon name="whatsapp" size={20} />
          <WhatsAppCTA number={whatsappNumber} client:load
            >{locale === 'bn' ? 'হোয়াটসঅ্যাপ করুন' : 'WhatsApp us'}</WhatsAppCTA
          >
        </p>
      </div>
    </div>
    <div
      class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
      data-anim="fade-in-up"
    >
      <h3 class="mb-6 font-display text-xl font-semibold text-ink">{t.cta.formTitle}</h3>
      <LeadForm treatments={treatmentOptions} source={LEAD_SOURCE.GENERAL_CONTACT} client:visible />
    </div>
  </div>
</section>

<Footer
  brand={t.site.name}
  legalLinks={getFooterLegalLinks(locale)}
  conciergeLabel={t.footer.concierge}
  conciergePrefix={t.footer.conciergePrefix}
  conciergeSuffix={t.footer.conciergeSuffix}
  copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
  address={t.footer.address}
/>

<WhatsAppCTA number={whatsappNumber} variant="floating" client:load data-floating-cta />

<script>
  // Stick floating CTAs above the footer when it enters the viewport.
  // Instead of switching to absolute positioning, we keep position:fixed
  // and dynamically increase the `bottom` offset so the buttons ride
  // just above the footer's top edge as it scrolls into view.
  const footer = document.querySelector('footer');
  const floaters = document.querySelectorAll<HTMLElement>('[data-floating-cta]');

  function updateFloaters() {
    if (!footer || floaters.length === 0) return;
    const footerTop = footer.getBoundingClientRect().top;
    const windowHeight = window.innerHeight;

    if (footerTop < windowHeight) {
      // Footer has entered the viewport — push floaters up to sit above it
      const overlap = windowHeight - footerTop;
      floaters.forEach((el) => {
        el.style.bottom = `${overlap + 24}px`;
      });
    } else {
      // Footer not in view — reset to default fixed position
      floaters.forEach((el) => {
        el.style.bottom = '';
      });
    }
  }

  window.addEventListener('scroll', updateFloaters, { passive: true });
  window.addEventListener('resize', updateFloaters);
  updateFloaters();
</script>
