---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { TreatmentsPage } from '../components/TreatmentsPage';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getTreatments, getProcedures, entrySlug } from '../lib/content';
import { Icon } from '../design-system/components/atoms/Icon';

const t = getTranslations('en');

const navLinks = getNavLinks('en');

const [treatmentEntries, procedureEntries] = await Promise.all([
  getTreatments('en'),
  getProcedures('en'),
]);

const treatments = treatmentEntries.map((entry) => ({
  name: entry.data.name,
  description: entry.data.description,
  fromPrice: entry.data.fromPrice,
  category: entry.data.category,
  tags: entry.data.category ? [entry.data.category] : undefined,
  href: `/treatments/${entrySlug(entry)}`,
  image: entry.data.image,
}));

// Reason: List all procedures (ungrouped) below the treatment cards so
// patients can browse every available procedure from one page.
const procedures = procedureEntries.map((p) => {
  const parentSlug = p.data.parentTreatmentSlug;
  const pSlug = entrySlug(p).split('/').pop()!;
  return {
    name: p.data.name,
    summary: p.data.summary,
    fromPrice: p.data.fromPrice,
    toPrice: p.data.toPrice,
    href: `/treatments/${parentSlug}/${pSlug}`,
  };
});
---

<Layout
  title={`${t.treatments.title} — ${t.site.name}`}
  description={t.site.description}
  locale="en"
>
  <Navbar
    brand={t.site.name}
    links={navLinks}
    cta={{ label: t.nav.cta, href: '/#contact' }}
    locale="en"
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <TreatmentsPage
    title={t.treatments.title}
    subtitle={t.site.description}
    filterAll={t.doctors.filterAll}
    treatments={treatments}
    client:load
  />

  {/* ── ALL PROCEDURES (ungrouped) ─────────────────────────────────── */}
  {procedures.length > 0 && (
    <section class="bg-cream-100 py-16" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-2 font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.procedures.title}</h2>
        <p class="mb-8 text-sm text-ink/60">{t.treatments.procedures.viewAll}</p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-anim="stagger-cards">
          {procedures.map((proc) => {
            const price = proc.fromPrice && proc.toPrice
              ? `${proc.fromPrice} – ${proc.toPrice}`
              : proc.fromPrice;
            return (
              <a
                href={proc.href}
                class="group rounded-card border border-cream-300 bg-cream-100 p-4 transition-all hover:border-violet-300 hover:shadow-base"
              >
                <p class="text-sm font-semibold text-ink">{proc.name}</p>
                {proc.summary && (
                  <p class="mt-1 text-xs text-ink/60 line-clamp-2">{proc.summary}</p>
                )}
                {price && (
                  <p class="mt-2 text-xs font-medium text-violet-600">
                    {t.treatments.procedures.costInIndia}: {price}
                  </p>
                )}
                <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-violet-600 group-hover:underline">
                  {t.treatments.procedures.learnMore}
                  <Icon name="arrow-right" size={12} />
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <TreatmentsCtaSection
    locale="en"
    primaryCta={{ label: t.nav.cta, href: '/#contact' }}
    secondaryCta={{ label: t.footer.secondOpinion, href: '/second-opinion' }}
  />

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks('en')}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
