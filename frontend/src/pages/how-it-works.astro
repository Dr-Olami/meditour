---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { StepTimeline } from '../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/how-it-works`;

const journeySteps = [
  {
    title: 'Initial enquiry',
    description: "You contact us by form, WhatsApp, or phone and share your diagnosis, urgency, and goals. No commitment is required at this stage. Families often start with a simple question about whether India is the right option.",
  },
  {
    title: 'Medical report review',
    description: "We review reports, imaging summaries, and doctor notes to understand the clinical picture. If reports are incomplete, we tell you exactly what is missing so a hospital or specialist can respond usefully.",
  },
  {
    title: 'Hospital matching & quote',
    description: "We shortlist accredited hospitals and doctors, then share indicative package costs in writing. Quotes typically cover hospital fees, room category, surgeon fees where applicable, and length of stay — not hidden add-ons.",
  },
  {
    title: 'Medical visa & invitation',
    description: "Once you choose a pathway, we coordinate the hospital invitation letter and visa document checklist. Attendant visas for family members are arranged alongside the patient visa when required.",
  },
  {
    title: 'Travel & accommodation',
    description: "We help plan flights guidance, airport pickup, hotels near the hospital, and interpreter support. Recovery-friendly stay options are arranged for the patient and attendants based on expected discharge timing.",
  },
  {
    title: 'Treatment in India',
    description: "Our coordinators support admission, consent processes, billing clarity, and communication with the care team. You are not left alone at the hospital — our Bangalore team stays reachable throughout treatment.",
  },
  {
    title: 'Recovery & discharge',
    description: "We coordinate discharge instructions, medicines, follow-up appointments, and safe travel home. Physio, dietary guidance, and wound-care instructions are clarified before you leave the hospital.",
  },
  {
    title: 'Follow-up after return',
    description: "Remote follow-up coordination with the Indian hospital and local doctor when needed. Report sharing, second-line opinions, and re-admission planning can continue after you return home.",
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'How medical treatment in India works — step by step',
    url: pageUrl,
    description: 'From first enquiry to follow-up after you return home — the full pathway Khan Meditour coordinates for international patients and families.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'How it works', url: `${pageUrl}/` },
  ]),
];

const faqs = [
  {
    question: 'How long does the full process take from enquiry to treatment?',
    answer: 'It depends on the treatment type and visa processing time for your country. Typically, from initial enquiry to arrival in India takes 2–4 weeks. Urgent cases can be fast-tracked — we have coordinated admissions within 48 hours for emergency situations.',
  },
  {
    question: 'Do I need to pay anything before getting a quote?',
    answer: 'No. The initial consultation, report review, and hospital matching with indicative cost quotes are completely free. You only pay the hospital directly once you choose a pathway and agree to treatment.',
  },
  {
    question: 'What if my medical reports are incomplete?',
    answer: 'We tell you exactly what is missing. Many families start with partial reports — a diagnosis letter or scan summary is often enough for an initial opinion. We guide you on what additional tests or documents a hospital will need to give a useful response.',
  },
  {
    question: 'Can a family member travel with me?',
    answer: 'Yes. Attendant visas are arranged alongside the patient visa when required. We help coordinate accommodation for family members near the hospital and our team stays reachable for attendants throughout the stay.',
  },
  {
    question: 'What happens after I return home?',
    answer: 'Remote follow-up coordination continues with the Indian hospital and your local doctor. We facilitate report sharing, second-line opinions, and re-admission planning if needed. You are not left on your own after discharge.',
  },
  {
    question: 'Is Khan Meditour a hospital or a facilitator?',
    answer: 'We are a medical tourism facilitator. We do not employ the doctors or own the hospitals. Our role is to coordinate the entire pathway — from matching you with the right hospital and doctor, to visa, travel, admission support, and post-return follow-up.',
  },
];
---

<Layout
  title={`How It Works | ${t.site.name}`}
  description="From first enquiry to follow-up after you return home — the full pathway Khan Meditour coordinates for international patients and families."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'How it works' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            Patient journey
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            How medical treatment in India works — step by step
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            From first enquiry to follow-up after you return home — here is the full pathway Khan Meditour coordinates for international patients and families.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">
            Medical treatment in India typically follows eight steps: enquiry, medical report review, hospital matching and quote, medical visa, travel planning, treatment, recovery, and follow-up. Khan Meditour coordinates each stage so families are not navigating India alone.
          </p>
        </div>
      </div>
    </section>

    {/* ── STEP TIMELINE ────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          The 8-step pathway
        </h2>
        <StepTimeline steps={journeySteps} client:load />
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Next steps after understanding the patient journey.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/treatments" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Browse treatments</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">See procedures, durations, and recovery timelines for each treatment category.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">View all treatments <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Compare hospitals</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">JCI and NABH-accredited hospitals in Bangalore — see specialties and facilities.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Compare hospitals <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Document checklists, processing times, and attendant visas for your travel.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Visa guidance <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/travel-accommodation-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="plane" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Flights, airport pickup, stays, and daily logistics for a smooth arrival.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Travel support <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/cost-calculator" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Get indicative cost ranges for your treatment at accredited hospitals.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Estimate costs <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/emergency-urgent-cases" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-red-600/10">
                <Icon name="alert" size={20} className="text-red-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Urgent cases</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Fast-track support for time-sensitive cardiac, cancer, transplant, or neurosurgery cases.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Urgent pathway <Icon name="arrow-right" size={14} /></span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="Most families begin with reports or a quote request"
      body="You do not need to know every step before contacting us. Share your case and we will guide you through the right sequence for your treatment type and timeline."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Questions about your specific journey?"
      body="Tell us your diagnosis and timeline — we will map the right hospitals, visa steps, and cost range for your family."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
