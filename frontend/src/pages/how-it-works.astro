---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { StepTimeline } from '../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();
const _whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/how-it-works`;

const journeySteps = [
  {
    title: 'Initial enquiry',
    description:
      'You contact us by form, WhatsApp, or phone and share your diagnosis, urgency, and goals. No commitment is required at this stage. Many families start with a simple question about whether India is the right option — and that is exactly where the conversation should begin. We understand that reaching out for treatment abroad can feel overwhelming, and our first job is to listen, not to sell.',
    duration: 'Same day',
  },
  {
    title: 'Medical report review',
    description:
      'We review your reports, imaging summaries, and doctor notes to understand the clinical picture. If reports are incomplete, we tell you exactly what is missing so a hospital or specialist can respond usefully. At this stage we can also arrange a free second opinion from an Indian specialist before you commit to any hospital or travel plan.',
    duration: '1–3 days',
  },
  {
    title: 'Hospital matching & quote',
    description:
      'We shortlist accredited hospitals and doctors based on your condition, budget, and preferences, then share indicative package costs in writing. Quotes typically cover hospital fees, room category, surgeon fees where applicable, and length of stay — not hidden add-ons. We encourage you to verify each hospital accreditation independently at jointcommissioninternational.org or nabh.co before deciding.',
    duration: '2–5 days',
  },
  {
    title: 'Medical visa & invitation',
    description:
      'Once you choose a pathway, we coordinate the hospital invitation letter and visa document checklist. E-Medical Visas process in 3–5 business days for eligible countries; Bangladesh and Pakistan nationals apply through IVAC or the Indian High Commission. Attendant visas for family members are arranged alongside the patient visa when required.',
    duration: '3–15 days',
  },
  {
    title: 'Travel & accommodation',
    description:
      'We help plan flight guidance, airport pickup, hotels or serviced apartments near the hospital, and interpreter support. Recovery-friendly stay options are arranged for the patient and attendants based on expected discharge timing. We also advise on medical travel insurance that covers complications — standard travel insurance typically does not.',
    duration: '1–2 weeks',
  },
  {
    title: 'Treatment in India',
    description:
      'Our coordinators support admission, consent processes, billing clarity, and communication with the care team. Being treated in a foreign hospital can feel isolating — you are not left alone. Our Bangalore team stays reachable throughout treatment and helps bridge any language or cultural gap between your family and the hospital staff.',
    duration: '2–6 weeks (procedure-dependent)',
  },
  {
    title: 'Recovery & discharge',
    description:
      'We coordinate discharge instructions, medicines, follow-up appointments, and safe travel home. Physio, dietary guidance, and wound-care instructions are clarified before you leave the hospital. We do not let you fly home until your surgeon clears you for travel — flying too soon after major surgery increases the risk of deep vein thrombosis and other complications.',
    duration: '10–14 days post-discharge',
  },
  {
    title: 'Follow-up after return',
    description:
      'Remote follow-up coordination continues with the Indian hospital and your local doctor when needed. Report sharing, second-line opinions, and re-admission planning can continue after you return home. The fear of being abandoned after discharge is common — you are not on your own once you leave India. We stay reachable for as long as your recovery requires.',
    duration: 'Ongoing',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'How to Plan Medical Treatment in India — Step by Step',
    url: pageUrl,
    description:
      'Complete 8-step guide to planning medical treatment in India from abroad. Timeline, hospital accreditation, medical visa, travel, treatment, recovery, and follow-up coordination for international patients.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'How it works', url: `${pageUrl}/` },
  ]),
];

const faqs = [
  {
    question: 'How long does the full process take from enquiry to treatment?',
    answer:
      'It depends on the treatment type and visa processing time for your country. Typically, from initial enquiry to arrival in India takes 2–4 weeks. Once in India, most surgical procedures require 2–6 weeks including pre-surgical evaluation, the procedure itself, and post-discharge recovery. Urgent cases can be fast-tracked — we have coordinated admissions within 48 hours for emergency situations such as cardiac emergencies or advanced cancer.',
  },
  {
    question: 'Do I need to pay anything before getting a quote?',
    answer:
      'No. The initial consultation, report review, hospital matching, and indicative cost quotes are completely free. You only pay the hospital directly once you choose a pathway and agree to treatment. Khan Meditour does not add markup to hospital bills — the cost you see is the cost the hospital charges.',
  },
  {
    question: 'What if my medical reports are incomplete?',
    answer:
      'We tell you exactly what is missing. Many families start with partial reports — a diagnosis letter or scan summary is often enough for an initial opinion. We guide you on what additional tests or documents a hospital will need to give a useful response. We can also arrange a free second opinion from an Indian specialist based on whatever reports you have.',
  },
  {
    question: 'Can a family member travel with me?',
    answer:
      'Yes. Most nationalities allow up to 2 attendants on a Medical Attendant Visa (MX-Visa). Bangladesh nationals can bring up to 3 attendants under a special bilateral provision. We help coordinate accommodation for family members near the hospital and our team stays reachable for attendants throughout the stay.',
  },
  {
    question: 'How do I verify a hospital is safe and accredited?',
    answer:
      'We only shortlist hospitals with active JCI or NABH accreditation, but we encourage you to verify independently. JCI accreditation can be checked at jointcommissioninternational.org and NABH accreditation at nabh.co. Fewer than 40 hospitals in India hold JCI accreditation — the global gold standard for patient safety. We share accreditation details and surgeon credentials for every hospital we recommend so you can confirm before committing.',
  },
  {
    question: 'Do I need medical travel insurance?',
    answer:
      'Yes, we strongly recommend specialist medical travel insurance that covers surgical complications, not standard travel insurance. Standard travel policies typically exclude medical treatment and complications abroad. Medical travel insurance covers unexpected complications, extended hospital stays, and emergency evacuation if needed. We can advise on suitable policies for your procedure and nationality.',
  },
  {
    question: 'What if there are complications during treatment?',
    answer:
      'Complications are rare at accredited hospitals but can happen with any surgical procedure. If complications arise, the treating hospital and surgeon manage them directly — Khan Meditour does not make clinical decisions. Our role is to coordinate communication between you, the hospital, and your family back home, help you understand what is happening, and ensure billing remains transparent. We also help arrange extended stays or additional procedures if the surgeon recommends them.',
  },
  {
    question: 'How long should I stay in India after surgery before flying home?',
    answer:
      'Most surgeons recommend waiting 10–14 days after major surgery before flying, due to the risk of deep vein thrombosis and other post-operative complications. The exact duration depends on the procedure — cardiac surgery may require longer, while minor procedures may allow earlier travel. We do not let you fly home until your surgeon clears you for travel. We coordinate recovery accommodation near the hospital during this period.',
  },
  {
    question: 'What happens after I return home?',
    answer:
      'Remote follow-up coordination continues with the Indian hospital and your local doctor. We facilitate report sharing, second-line opinions, and re-admission planning if needed. Many Indian hospitals now offer teleconsultation so your local doctor can consult with your Indian specialist. You are not left on your own after discharge — we stay reachable for as long as your recovery requires.',
  },
  {
    question: 'Is Khan Meditour a hospital or a facilitator?',
    answer:
      'We are a medical tourism facilitator. We do not employ the doctors or own the hospitals. Our role is to coordinate the entire pathway — from matching you with the right accredited hospital and doctor, to visa, travel, admission support, and post-return follow-up. All medical decisions, diagnosis, and treatment are provided by the selected hospital and treating doctors. This distinction matters: we advocate for you, but clinical care is always the hospital responsibility.',
  },
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`How to Plan Medical Treatment in India | Step-by-Step Guide | ${t.site.name}`}
  description="Complete 8-step guide to planning medical treatment in India from abroad. Hospital selection, medical visa, travel, treatment, recovery timeline, and follow-up coordination for international patients and families."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'How it works' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            Patient journey
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl"
            data-anim="headline-reveal"
          >
            How to plan medical treatment in India
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            Planning treatment in another country can feel overwhelming — but it follows a clear,
            predictable sequence. From first enquiry to follow-up after you return home, here is the
            full pathway Khan Meditour coordinates so you are never navigating India alone.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div
          class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="text-ink/80 mt-3 text-base leading-relaxed">
            Medical treatment in India typically follows eight steps: enquiry, medical report
            review, hospital matching and quote, medical visa, travel planning, treatment,
            recovery, and follow-up. From first enquiry to arrival in India usually takes
            <strong>2–4 weeks</strong>; most surgical procedures require <strong>2–6 weeks</strong>
            in India including recovery. The initial consultation, report review, and cost quotes
            are <strong>completely free</strong> — you only pay the hospital directly once you
            agree to treatment. Khan Meditour coordinates each stage so families are not navigating
            India alone.
          </p>
        </div>
      </div>
    </section>

    {/* ── STEP TIMELINE ────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          The 8-step pathway
        </h2>
        <StepTimeline steps={journeySteps} client:load />
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Explore further
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          Next steps after understanding the patient journey.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a
            href="/treatments"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="stethoscope" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Browse treatments</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              See procedures, durations, and recovery timelines for each treatment category.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >View all treatments <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/hospitals"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="hospital" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Compare hospitals</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              JCI and NABH-accredited hospitals in Bangalore — see specialties and facilities.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Compare hospitals <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/medical-visa-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="document" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Document checklists, processing times, and attendant visas for your travel.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Visa guidance <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/travel-accommodation-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="plane" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Flights, airport pickup, stays, and daily logistics for a smooth arrival.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Travel support <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/cost-calculator"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="stethoscope" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Get indicative cost ranges for your treatment at accredited hospitals.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Estimate costs <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/emergency-urgent-cases"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="alert" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Urgent cases</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Fast-track support for time-sensitive cardiac, cancer, transplant, or neurosurgery
              cases.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Urgent pathway <Icon name="arrow-right" size={14} /></span
            >
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2
          class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="Most families begin with reports or a quote request"
      body="You do not need to know every step before contacting us. Share your case and we will guide you through the right sequence for your treatment type and timeline."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Questions about your specific journey?"
      body="Tell us your diagnosis and timeline — we will map the right hospitals, visa steps, and cost range for your family."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
