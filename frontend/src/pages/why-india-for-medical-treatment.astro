---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/why-india-for-medical-treatment`;

const advantages = [
  {
    title: 'Significant cost savings',
    detail:
      'Treatment in India typically costs 60–90% less than the US, UK, or Europe — and 40–70% less than Thailand, Turkey, or Singapore. The same procedure, accredited hospitals, at a fraction of the price.',
    icon: 'check',
  },
  {
    title: 'Internationally accredited hospitals',
    detail:
      'India has 60+ JCI-accredited hospitals (the same accreditation used by Johns Hopkins, Mayo Clinic, and Cleveland Clinic) and 700+ NABH-accredited facilities. Apollo, Fortis, Manipal, and Narayana meet global quality standards for cardiac, oncology, transplant, and orthopaedic care.',
    icon: 'check',
  },
  {
    title: 'Highly experienced specialists',
    detail:
      'Indian surgeons often train or practise in the US, UK, or Germany. Many have performed thousands of procedures — volumes that build expertise rarely matched elsewhere. JCI-accredited cardiac centres report 98–99% success rates for CABG, and liver transplant centres report 90–95% success rates.',
    icon: 'check',
  },
  {
    title: 'Shorter waiting times',
    detail:
      'In the UK, Canada, and Australia, patients wait months for elective surgery — NHS liver transplant waits can exceed 18 months. In India, treatment can often begin within days of enquiry — critical for cancer, cardiac, and transplant cases.',
    icon: 'check',
  },
  {
    title: 'English-speaking care teams',
    detail:
      'Doctors, nurses, and hospital staff speak English fluently. Interpreters are available for Bengali, Arabic, French, Amharic, Hausa, and other languages when needed — so nothing is lost in translation.',
    icon: 'check',
  },
  {
    title: 'Advanced technology & infrastructure',
    detail:
      'Leading Indian hospitals use the same da Vinci robotic surgery, CyberKnife, PET-MRI, and transplant technology found in Western hospitals — often newer equipment, installed more recently. The government’s "Heal in India" initiative continues to invest in medical infrastructure.',
    icon: 'check',
  },
];

const treatmentComparisons = [
  {
    procedure: 'Coronary artery bypass (CABG)',
    usa: '$70,000–$200,000',
    india: '$5,000–$10,000',
    savings: '~90%',
  },
  {
    procedure: 'Knee replacement (single)',
    usa: '$30,000–$70,000',
    india: '$5,000–$9,000',
    savings: '~85%',
  },
  { procedure: 'Hip replacement', usa: '$40,000–$65,000', india: '$5,000–$9,000', savings: '~85%' },
  {
    procedure: 'IVF cycle (with medication)',
    usa: '$12,000–$25,000',
    india: '$2,500–$4,500',
    savings: '~80%',
  },
  {
    procedure: 'Liver transplant',
    usa: '$300,000–$850,000',
    india: '$25,000–$45,000',
    savings: '~90%',
  },
  { procedure: 'Spinal fusion', usa: '$50,000–$100,000', india: '$4,000–$8,000', savings: '~90%' },
];

const faqs = [
  {
    question: 'Is the quality of Indian hospitals really comparable to Western hospitals?',
    answer:
      'Yes. India has over 60 JCI-accredited hospitals (the same accreditation used by Johns Hopkins, Mayo Clinic, and Cleveland Clinic) and over 700 NABH-accredited facilities. Leading hospitals like Apollo, Fortis, Manipal, and Narayana use identical technology and protocols to Western institutions. Many Indian specialists have trained or worked in the US and UK. JCI-accredited cardiac centres report 98–99% success rates for CABG, and liver transplant centres report 90–95% success rates.',
  },
  {
    question: 'Why is treatment in India so much cheaper?',
    answer:
      'Lower costs are driven by: lower doctor salaries (without compromising expertise), lower infrastructure and administrative costs, favourable currency exchange rates, and higher surgical volumes that reduce per-case overhead. The quality of care is not lower — the cost base is. A senior cardiac surgeon in India earns $50,000–$150,000 per year versus $400,000–$700,000 in the US; that differential runs through every layer of hospital personnel.',
  },
  {
    question: 'Will language be a barrier?',
    answer:
      'No. English is widely spoken by doctors, nurses, and hospital staff at major Indian hospitals. For patients who prefer their native language, we arrange interpreters for Bengali, Arabic, French, Amharic, Hausa, and other languages at no extra coordination charge.',
  },
  {
    question: 'Is India safe for medical tourists?',
    answer:
      'Major treatment cities like Bangalore, Chennai, and Mumbai have well-established medical tourism infrastructure. Hospitals have dedicated international patient departments. Our Bangalore team stays reachable on WhatsApp throughout your stay, coordinates airport pickup, and helps with daily logistics so you are not navigating alone.',
  },
  {
    question: 'What treatments is India most known for?',
    answer:
      'India is a global leader in cardiac surgery (bypass, valve, angioplasty), orthopaedics (joint replacement), oncology, IVF and fertility, organ transplant (liver, kidney), ophthalmology, and neurosurgery. Bangalore in particular has concentrated expertise across all these specialties, with Apollo, Fortis, Manipal, Narayana, and Sparsh all located in the city.',
  },
  {
    question: 'How do I know which hospital is right for me?',
    answer:
      'That is exactly what we do. Based on your diagnosis, budget, and preferences, we shortlist accredited hospitals and specialists, share indicative cost quotes in writing, and help you compare options. You choose the pathway — we coordinate the rest.',
  },
  {
    question: 'How many patients travel to India for treatment each year?',
    answer:
      'In 2025, 507,244 foreign nationals arrived in India specifically for medical treatment — about 5.5% of all foreign tourist arrivals. Between 2023 and 2025, over 1.81 million medical travellers visited India. The top source countries are Bangladesh (325,127 in 2025), Iraq (30,989), Uzbekistan (13,699), Somalia (11,506), Oman (9,738), Kenya (9,357), Nigeria (8,251), and Maldives (7,016). India’s medical tourism market was valued at $8.7 billion in 2025 and is projected to reach $13–16 billion by 2030.',
  },
  {
    question: 'What is the e-Medical Visa and how long is it valid?',
    answer:
      'India’s e-Medical Visa is an online visa available to citizens of 176 countries. As of 2026, the validity has been extended from 60 days to one year, with multiple entries permitted (previously triple entry). Processing takes 3–5 business days. The e-Medical Attendant Visa allows a family member to accompany the patient. We provide invitation letters and document checklists to support your application. Pakistani passport holders and some nationals must apply through an Indian mission rather than online.',
  },
  {
    question: 'How do India’s costs compare to Thailand, Turkey, or Singapore?',
    answer:
      'India is typically 40–70% cheaper than Thailand, Turkey, and Singapore for the same procedures. For example, CABG in India costs $5,000–$10,000 versus $12,000–$20,000 in Thailand and $18,000–$35,000 in Singapore. Liver transplant in India costs $25,000–$45,000 versus $80,000–$120,000 in Singapore. The quality at JCI-accredited hospitals is comparable across all four destinations — the difference is the cost base, not the standard of care.',
  },
  {
    question: 'What success rates do Indian hospitals achieve for major procedures?',
    answer:
      'JCI-accredited cardiac centres in India report 98–99% success rates for coronary artery bypass grafting (CABG), comparable to leading US and European hospitals. Liver transplant centres report 90–95% success rates, with India performing over 2,500 liver transplants annually. These outcomes reflect high surgical volumes — Indian surgeons often perform more procedures in a month than some Western hospitals do in a year — and the use of identical technology and protocols to Western institutions.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Why India for Medical Treatment — Cost, Quality, and Access for International Patients',
    url: pageUrl,
    description:
      'Why international patients choose India for medical treatment — 60+ JCI-accredited hospitals, 60–90% cost savings, 98–99% cardiac success rates, 1-year e-Medical Visa, and treatment within days not months.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Why India', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`Why India for Medical Treatment — Cost, Quality & Access | ${t.site.name}`}
  description="Why 500,000+ international patients choose India for medical treatment each year — 60+ JCI-accredited hospitals, 60–90% cost savings vs the USA, 98–99% cardiac success rates, 1-year e-Medical Visa, and treatment within days not months."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Why India' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            Why India
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            Why families choose India for medical treatment
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            World-class hospitals, globally trained specialists, and treatment costs that make
            quality care accessible — here is why over 500,000 patients from 50+ countries travel to
            India every year for treatment.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div
          class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="text-ink/80 mt-3 text-base leading-relaxed">
            India combines 60+ JCI-accredited hospitals, surgeons with global training, advanced
            technology, and costs 60–90% lower than Western countries — and 40–70% lower than
            Thailand, Turkey, or Singapore. In 2025, <strong>507,244 international patients</strong>
            arrived for treatment. The e-Medical Visa is now valid for <strong
              >one year with multiple entries</strong
            >, available to 176 countries. JCI-accredited cardiac centres report 98–99% success
            rates for CABG. For many families, India is the only place where life-saving treatment
            is both high-quality and affordable — with waiting times of days, not months.
          </p>
        </div>
      </div>
    </section>

    {/* ── ADVANTAGES GRID ──────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Six reasons patients choose India
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            advantages.map((item) => (
              <div
                class="rounded-card border border-cream-300 bg-cream-100 p-6"
                data-anim="fade-in-up"
              >
                <div class="flex items-start gap-3">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-violet-600">
                    <Icon name={item.icon} size={16} className="text-white" />
                  </span>
                  <div>
                    <h3 class="font-display text-lg font-bold text-ink">{item.title}</h3>
                    <p class="text-ink/70 mt-2 text-sm leading-relaxed">{item.detail}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── STATS BAND ───────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6">
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">507K+</p>
            <p class="text-ink/60 mt-1 text-xs">medical arrivals (2025)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">60+</p>
            <p class="text-ink/60 mt-1 text-xs">JCI-accredited hospitals</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">176</p>
            <p class="text-ink/60 mt-1 text-xs">e-Medical Visa countries</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">$8.7B</p>
            <p class="text-ink/60 mt-1 text-xs">market size (2025)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">98–99%</p>
            <p class="text-ink/60 mt-1 text-xs">CABG success (JCI)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">1 year</p>
            <p class="text-ink/60 mt-1 text-xs">e-Medical Visa validity</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── COST COMPARISON TABLE ────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Cost comparison: India vs USA
        </h2>
        <p class="text-ink/60 mb-8 text-sm" data-anim="fade-in-up">
          Indicative package costs. Actual prices vary by hospital, surgeon, room category, and case
          complexity. We share confirmed quotes in writing before you travel.
        </p>
        {/* Mobile: cards */}
        <div class="space-y-4 md:hidden" data-anim="fade-in-up">
          {
            treatmentComparisons.map((row) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <h3 class="font-display text-base font-bold text-ink">{row.procedure}</h3>
                <dl class="mt-3 space-y-2 text-sm">
                  <div class="flex items-center justify-between gap-4">
                    <dt class="text-ink/50">USA</dt>
                    <dd class="text-ink/80 font-medium">{row.usa}</dd>
                  </div>
                  <div class="flex items-center justify-between gap-4">
                    <dt class="text-ink/50">India</dt>
                    <dd class="text-ink/80 font-medium">{row.india}</dd>
                  </div>
                  <div class="flex items-center justify-between gap-4 border-t border-cream-300 pt-2">
                    <dt class="text-ink/50">Savings</dt>
                    <dd class="font-semibold text-violet-600">{row.savings}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>

        {/* Desktop: table */}
        <div
          class="hidden overflow-x-auto rounded-card border border-cream-300 bg-cream-100 md:block"
          data-anim="fade-in-up"
        >
          <table class="w-full text-left text-sm">
            <thead class="bg-cream-200/50 border-b border-cream-300">
              <tr>
                <th class="px-4 py-3 font-semibold text-ink">Procedure</th>
                <th class="px-4 py-3 font-semibold text-ink">USA (typical)</th>
                <th class="px-4 py-3 font-semibold text-ink">India (typical)</th>
                <th class="px-4 py-3 font-semibold text-violet-600">Savings</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-300">
              {
                treatmentComparisons.map((row) => (
                  <tr class="hover:bg-cream-200/30">
                    <td class="px-4 py-3 font-medium text-ink">{row.procedure}</td>
                    <td class="text-ink/70 px-4 py-3">{row.usa}</td>
                    <td class="text-ink/70 px-4 py-3">{row.india}</td>
                    <td class="px-4 py-3 font-semibold text-violet-600">{row.savings}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Explore further
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          Guides and resources to help you plan treatment in India with confidence.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Country guides */}
          <a
            href="/countries"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="globe" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Country guides</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Dedicated guidance for patients from Bangladesh, the Gulf, Africa, the UK, and the US
              — with visa steps, costs, and travel notes for your region.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Browse country guides
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a
            href="/hospitals"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="hospital" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Hospitals in India</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              JCI and NABH-accredited hospitals in Bangalore — Apollo, Fortis, Manipal, and
              Narayana. Compare specialties, infrastructure, and patient facilities.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Compare hospitals
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Treatments */}
          <a
            href="/treatments"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="stethoscope" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Treatments available</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Cardiac surgery, oncology, orthopaedics, IVF, transplant, neurosurgery and more — with
              indicative costs, duration, and recovery timelines.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Browse treatments
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* How it works */}
          <a
            href="/how-it-works"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="list" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              The 8-step pathway from first enquiry to follow-up after return — enquiry, report
              review, hospital matching, visa, travel, treatment, recovery, and follow-up.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              See the full journey
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Medical visa */}
          <a
            href="/medical-visa-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="document" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Step-by-step visa guidance — invitation letters, document checklists, e-visa vs
              embassy processing, and attendant visas for family members.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Visa guidance
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Travel & accommodation */}
          <a
            href="/travel-accommodation-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="plane" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Flight guidance, airport pickup, hospital-area stays, interpreters, and daily
              logistics — so your arrival in India is smooth and stress-free.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Travel support
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </div>
