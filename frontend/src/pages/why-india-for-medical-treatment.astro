---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/why-india-for-medical-treatment`;

const advantages = [
  {
    title: 'Significant cost savings',
    detail: 'Treatment in India typically costs 60–90% less than the US, UK, or Europe — and 40–70% less than Thailand or Turkey. The same procedure, accredited hospitals, at a fraction of the price.',
    icon: 'check',
  },
  {
    title: 'Internationally accredited hospitals',
    detail: 'India has 40+ JCI-accredited and 500+ NABH-accredited hospitals. Apollo, Fortis, Manipal, and Narayana meet global quality standards for cardiac, oncology, transplant, and orthopaedic care.',
    icon: 'check',
  },
  {
    title: 'Highly experienced specialists',
    detail: 'Indian surgeons often train or practise in the US, UK, or Germany. Many have performed thousands of procedures — volumes that build expertise rarely matched elsewhere.',
    icon: 'check',
  },
  {
    title: 'Shorter waiting times',
    detail: 'In the UK, Canada, and Australia, patients wait months for elective surgery. In India, treatment can often begin within days of enquiry — critical for cancer, cardiac, and transplant cases.',
    icon: 'check',
  },
  {
    title: 'English-speaking care teams',
    detail: 'Doctors, nurses, and hospital staff speak English fluently. Interpreters are available for Bengali, Arabic, French, Amharic, and other languages when needed.',
    icon: 'check',
  },
  {
    title: 'Advanced technology & infrastructure',
    detail: 'Leading Indian hospitals use the same robotic surgery, CyberKnife, PET-MRI, and transplant technology found in Western hospitals — often newer equipment, installed more recently.',
    icon: 'check',
  },
];

const treatmentComparisons = [
  { procedure: 'Coronary artery bypass (CABG)', usa: '$150,000+', india: '$5,000–$8,000', savings: '~90%' },
  { procedure: 'Knee replacement (single)', usa: '$40,000–$60,000', india: '$4,000–$7,000', savings: '~85%' },
  { procedure: 'Hip replacement', usa: '$35,000–$50,000', india: '$4,000–$6,500', savings: '~85%' },
  { procedure: 'IVF cycle (with medication)', usa: '$15,000–$25,000', india: '$2,500–$4,500', savings: '~80%' },
  { procedure: 'Liver transplant', usa: '$300,000–$575,000', india: '$35,000–$50,000', savings: '~85%' },
  { procedure: 'Spinal fusion', usa: '$80,000–$150,000', india: '$6,000–$11,000', savings: '~90%' },
];

const faqs = [
  {
    question: 'Is the quality of Indian hospitals really comparable to Western hospitals?',
    answer: 'Yes. India has over 40 JCI-accredited hospitals (the same accreditation used by Johns Hopkins, Mayo Clinic, and Cleveland Clinic) and over 500 NABH-accredited facilities. Leading hospitals like Apollo, Fortis, Manipal, and Narayana use identical technology and protocols to Western institutions. Many Indian specialists have trained or worked in the US and UK.',
  },
  {
    question: 'Why is treatment in India so much cheaper?',
    answer: 'Lower costs are driven by: lower doctor salaries (without compromising expertise), lower infrastructure and administrative costs, favourable currency exchange rates, and higher surgical volumes that reduce per-case overhead. The quality of care is not lower — the cost base is.',
  },
  {
    question: 'Will language be a barrier?',
    answer: 'No. English is widely spoken by doctors, nurses, and hospital staff at major Indian hospitals. For patients who prefer their native language, we arrange interpreters for Bengali, Arabic, French, Amharic, Hausa, and other languages at no extra coordination charge.',
  },
  {
    question: 'Is India safe for medical tourists?',
    answer: 'Major treatment cities like Bangalore, Chennai, and Mumbai have well-established medical tourism infrastructure. Hospitals have dedicated international patient departments. Our Bangalore team stays reachable on WhatsApp throughout your stay, coordinates airport pickup, and helps with daily logistics so you are not navigating alone.',
  },
  {
    question: 'What treatments is India most known for?',
    answer: 'India is a global leader in cardiac surgery (bypass, valve, angioplasty), orthopaedics (joint replacement), oncology, IVF and fertility, organ transplant (liver, kidney), ophthalmology, and neurosurgery. Bangalore in particular has concentrated expertise across all these specialties.',
  },
  {
    question: 'How do I know which hospital is right for me?',
    answer: 'That is exactly what we do. Based on your diagnosis, budget, and preferences, we shortlist accredited hospitals and specialists, share indicative cost quotes in writing, and help you compare options. You choose the pathway — we coordinate the rest.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Why India for Medical Treatment',
    url: pageUrl,
    description: 'Why international patients choose India for medical treatment — cost savings, accredited hospitals, experienced specialists, shorter waiting times, and advanced technology.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Why India', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`Why India for Medical Treatment | ${t.site.name}`}
  description="Why international patients choose India for medical treatment — cost savings, accredited hospitals, experienced specialists, shorter waiting times, and advanced technology."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Why India' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            Why India
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            Why families choose India for medical treatment
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            World-class hospitals, globally trained specialists, and treatment costs that make quality care accessible — here is why patients from 30+ countries travel to India every year.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">
            India combines internationally accredited hospitals, surgeons with global training, advanced technology, and costs 60–90% lower than Western countries. For many families, India is the only place where life-saving treatment — cardiac surgery, cancer care, transplant — is both high-quality and affordable. Waiting times are days, not months.
          </p>
        </div>
      </div>
    </section>

    {/* ── ADVANTAGES GRID ──────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Six reasons patients choose India
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {advantages.map((item) => (
            <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
              <div class="flex items-start gap-3">
                <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-violet-600">
                  <Icon name={item.icon} size={16} className="text-white" />
                </span>
                <div>
                  <h3 class="font-display text-lg font-bold text-ink">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink/70">{item.detail}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── COST COMPARISON TABLE ────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Cost comparison: India vs USA
        </h2>
        <p class="mb-8 text-sm text-ink/60" data-anim="fade-in-up">
          Indicative package costs. Actual prices vary by hospital, surgeon, room category, and case complexity. We share confirmed quotes in writing before you travel.
        </p>
        {/* Mobile: cards */}
        <div class="space-y-4 md:hidden" data-anim="fade-in-up">
          {treatmentComparisons.map((row) => (
            <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
              <h3 class="font-display text-base font-bold text-ink">{row.procedure}</h3>
              <dl class="mt-3 space-y-2 text-sm">
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-ink/50">USA</dt>
                  <dd class="font-medium text-ink/80">{row.usa}</dd>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-ink/50">India</dt>
                  <dd class="font-medium text-ink/80">{row.india}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-t border-cream-300 pt-2">
                  <dt class="text-ink/50">Savings</dt>
                  <dd class="font-semibold text-violet-600">{row.savings}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        {/* Desktop: table */}
        <div class="hidden overflow-x-auto rounded-card border border-cream-300 bg-cream-100 md:block" data-anim="fade-in-up">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-cream-300 bg-cream-200/50">
              <tr>
                <th class="px-4 py-3 font-semibold text-ink">Procedure</th>
                <th class="px-4 py-3 font-semibold text-ink">USA (typical)</th>
                <th class="px-4 py-3 font-semibold text-ink">India (typical)</th>
                <th class="px-4 py-3 font-semibold text-violet-600">Savings</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-300">
              {treatmentComparisons.map((row) => (
                <tr class="hover:bg-cream-200/30">
                  <td class="px-4 py-3 font-medium text-ink">{row.procedure}</td>
                  <td class="px-4 py-3 text-ink/70">{row.usa}</td>
                  <td class="px-4 py-3 text-ink/70">{row.india}</td>
                  <td class="px-4 py-3 font-semibold text-violet-600">{row.savings}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Guides and resources to help you plan treatment in India with confidence.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Country guides */}
          <a href="/countries" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Country guides</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Dedicated guidance for patients from Bangladesh, the Gulf, Africa, the UK, and the US — with visa steps, costs, and travel notes for your region.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Browse country guides
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a href="/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Hospitals in India</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              JCI and NABH-accredited hospitals in Bangalore — Apollo, Fortis, Manipal, and Narayana. Compare specialties, infrastructure, and patient facilities.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Compare hospitals
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Treatments */}
          <a href="/treatments" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Treatments available</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Cardiac surgery, oncology, orthopaedics, IVF, transplant, neurosurgery and more — with indicative costs, duration, and recovery timelines.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Browse treatments
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* How it works */}
          <a href="/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              The 8-step pathway from first enquiry to follow-up after return — enquiry, report review, hospital matching, visa, travel, treatment, recovery, and follow-up.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              See the full journey
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Medical visa */}
          <a href="/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Step-by-step visa guidance — invitation letters, document checklists, e-visa vs embassy processing, and attendant visas for family members.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Visa guidance
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Travel & accommodation */}
          <a href="/travel-accommodation-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="plane" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Flight guidance, airport pickup, hospital-area stays, interpreters, and daily logistics — so your arrival in India is smooth and stress-free.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Travel support
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="See what India can offer for your case"
      body="Share your diagnosis and we will match you with accredited hospitals, share indicative cost quotes, and compare options — so you can decide if India is right for your family."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Still deciding if India is right for you?"
      body="Tell us your treatment type and what matters most — cost, waiting time, or hospital reputation. We will give you an honest comparison of India versus your local options."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
