---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { CostCalculator } from '../design-system/components/organisms/CostCalculator';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getTreatments, entrySlug } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { TREATMENT_COST_DATA } from '../lib/treatment-cost-data';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const calculatorTreatments = treatmentEntries
  .filter((entry) => entry.data.fromPrice && entry.data.toPrice)
  .map((entry) => ({
    name: entry.data.name,
    slug: entrySlug(entry),
    fromPrice: entry.data.fromPrice!,
    toPrice: entry.data.toPrice!,
    category: entry.data.category,
    duration: entry.data.duration,
    hospitalStay: entry.data.hospitalStay,
    recoveryTime: entry.data.recoveryTime,
  }));

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/cost-calculator`;

const calculatorLabels = {
  selectTreatment: 'Select a treatment',
  placeholder: 'Choose a treatment to see cost range',
  yourEstimate: 'Your estimate',
  planningRange: 'planning range',
  verified: 'Verified',
  treatment: 'Treatment',
  indiaRange: 'India package range',
  usRange: 'Typical US range',
  indicativeSavings: 'Indicative savings',
  category: 'Category',
  quoteWindow: 'Typical quote window',
  quoteWindowValue: '24–48 hrs',
  inTheRange: "What's usually in the range",
  getExactQuote: 'Get an exact quote for your case',
  disclaimer: 'Estimates are indicative package ranges. Final quotes follow medical review at a partner hospital. Flights are not included.',
  selectPrompt: 'Select a treatment on the left to see your indicative cost range, US comparison, and package breakdown.',
};

const faqs = [
  {
    question: 'Are these prices guaranteed?',
    answer: 'No. These are indicative package ranges based on typical cases at our partner hospitals. Your final quote depends on the specific hospital, surgeon, room category, case complexity, and any complications. We share confirmed quotes in writing after medical review of your reports.',
  },
  {
    question: 'What does the package price usually cover?',
    answer: 'Typical packages include hospital fees (room, operating theatre, nursing), surgeon and anaesthetist fees, pre-operative diagnostics, medicines during the hospital stay, and basic admission support. It does not include international flights, accommodation outside the hospital, or post-discharge medicines at home.',
  },
  {
    question: 'Why is there such a wide range for some treatments?',
    answer: 'The range reflects different case complexities. For example, cardiology ranges from $1,500 for a simple angiogram to $7,000 for a complex bypass. Cancer treatment ranges from $3,000 for early-stage therapy to $15,000+ for advanced multi-modal treatment. Your specific case complexity determines where in the range you fall.',
  },
  {
    question: 'Can I get an exact quote before travelling?',
    answer: 'Yes. Share your medical reports via WhatsApp or our contact form. We send them to the relevant hospital for review and come back with a written quote — usually within 24–48 hours. The quote will specify exactly what is included and any variables that could affect the final cost.',
  },
  {
    question: 'Do I pay Khan Meditour or the hospital?',
    answer: 'You pay the hospital directly. Khan Meditour does not charge patients for coordination — hospital matching, report review, visa support, and travel planning are all free. Our role is to make the pathway clear and help you compare options.',
  },
  {
    question: 'What if my treatment costs more than the estimate?',
    answer: 'If complications arise during treatment that increase costs, the hospital will inform you before proceeding with any additional procedures. We help you understand the revised costs and communicate with the hospital billing team. There are no hidden add-ons — everything is discussed before it happens.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Medical Treatment Cost Calculator',
    url: pageUrl,
    description: 'Estimate the cost of medical treatment in India. Select a treatment to see indicative package ranges for cardiac, oncology, orthopaedics, IVF, transplant and more.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Cost Calculator', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`Cost Calculator | ${t.site.name}`}
  description="Estimate the cost of medical treatment in India. Select a treatment to see indicative package ranges for cardiac, oncology, orthopaedics, IVF, transplant and more."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Cost Calculator' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            Cost estimator
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            Medical treatment cost calculator
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            Select a treatment to see indicative package cost ranges at our partner hospitals in India. Get a personalised quote in writing within 24–48 hours.
          </p>
        </div>
      </div>
    </section>

    {/* ── CALCULATOR ───────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <CostCalculator
            treatments={calculatorTreatments}
            costData={TREATMENT_COST_DATA}
            labels={calculatorLabels}
            client:load
          />
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Now that you have a cost range, here are the next steps most families take.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Treatments */}
          <a href="/treatments" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Browse treatments</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              See procedures, durations, hospital stays, and recovery timelines for each treatment category.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              View all treatments
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a href="/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Compare hospitals</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              JCI and NABH-accredited hospitals in Bangalore — Apollo, Fortis, Manipal, and Narayana. See specialties and facilities.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Compare hospitals
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Why India */}
          <a href="/why-india-for-medical-treatment" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Why India is cheaper</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Understand why treatment in India costs 60–90% less than the US or UK — without compromising on quality or technology.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              See the comparison
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* How it works */}
          <a href="/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              The 8-step pathway from first enquiry to follow-up — so you know what happens after you see a cost estimate.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              See the full journey
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Medical visa */}
          <a href="/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Document checklists, processing times, and attendant visas — everything you need to plan your travel to India.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Visa guidance
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Country guides */}
          <a href="/countries" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Country guides</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Region-specific guidance for patients from Bangladesh, the Gulf, Africa, the UK, and the US — with visa steps and travel notes.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Browse country guides
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="Get a personalised cost estimate"
      body="Share your reports and we will send them to the right hospital for a written quote — usually within 24–48 hours. No commitment required."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Not sure which treatment you need?"
      body="Tell us your diagnosis or symptoms — we will help you understand the right treatment pathway and what it is likely to cost."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
