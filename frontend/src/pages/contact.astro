---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { LeadForm } from '../design-system/components/organisms/LeadForm';
import { WhatsAppCTA } from '../design-system/components/organisms/WhatsAppCTA';
import { Icon } from '../design-system/components/atoms/Icon';
import { Link } from '../design-system/components/atoms/Link';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getTreatments, entrySlug } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { LEAD_SOURCE } from '../lib/crm';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'khan@meditour.com';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/contact`;

const jsonLd = [
  medicalWebPage({
    name: 'Contact Us',
    url: pageUrl,
    description: 'Get in touch with Khan Meditour for a free consultation. Share your reports on WhatsApp or email, and we will reply within 24 hours.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Contact', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`Contact Us | ${t.site.name}`}
  description="Get in touch with Khan Meditour for a free consultation. Share your reports on WhatsApp or email, and we will reply within 24 hours."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact-form' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Contact' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            {t.nav.contact}
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            Get in touch
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            Reach Khan Meditour on <a href="tel:+8801611892986" class="font-semibold text-ink hover:text-violet-600">Call +880 1611892986</a> or <a href={whatsappInquiryHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-ink hover:text-violet-600">WhatsApp +8801611892986</a> for a free consultation. Or submit the form below — share your medical reports and receive hospital options and a cost estimate within 24–48 hours from our Bangalore team.
          </p>
        </div>
      </div>
    </section>

    {/* ── CONTACT FORM + INFO ──────────────────────────────────────── */}
    <section id="contact-form" class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-12 lg:grid-cols-2">
        {/* Left: contact info */}
        <div data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {t.cta.formTitle}
          </h2>
          <p class="mt-4 text-lg text-ink/60">{t.cta.subtitle}</p>

          <div class="mt-8 space-y-4 text-ink/70">
            <a href={`tel:${whatsappNumber}`} class="flex items-center gap-3 transition-colors hover:text-ink">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="phone" size={20} />
              </span>
              <span class="text-base font-medium">{whatsappNumber}</span>
            </a>
            <a href={`mailto:${contactEmail}`} class="flex items-center gap-3 transition-colors hover:text-ink">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="mail" size={20} />
              </span>
              <span class="text-base font-medium">{contactEmail}</span>
            </a>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="whatsapp" size={20} />
              </span>
              <WhatsAppCTA number={whatsappNumber} client:load>
                WhatsApp us
              </WhatsAppCTA>
            </div>
          </div>

          {/* Response time note */}
          <div class="mt-8 rounded-card border border-cream-300 bg-cream-100 p-5">
            <p class="text-sm text-ink/70">
              <span class="font-semibold text-ink">Response time:</span> We typically reply within 24 hours. For urgent cases, WhatsApp is the fastest channel.
            </p>
          </div>

          {/* What to share checklist */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              What to share
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">A few details help us help you faster</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Recent medical reports and imaging summaries</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Current diagnosis or doctor's recommendation</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Your nationality (for visa guidance)</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Best contact number and WhatsApp</span>
              </li>
            </ul>
            <p class="mt-4 text-xs text-ink/50">
              WhatsApp is usually the fastest way to hear back from our care team.
            </p>
          </div>
        </div>

        {/* Right: lead form */}
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Free consultation
          </p>
          <h3 class="mt-2 font-display text-2xl font-bold text-ink">Tell us about your case</h3>
          <p class="mt-2 text-sm text-ink/60">
            Share a few details and we will reply within 24–48 hours with hospital options and a cost estimate — or <a href={whatsappInquiryHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-violet-600 hover:text-violet-700">WhatsApp us now</a>.
          </p>
          <div class="mt-6">
            <LeadForm
              source={LEAD_SOURCE.GENERAL_CONTACT}
              treatments={treatmentOptions}
              client:load
            />
          </div>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Not sure where to start? These pages will help.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">The 8-step patient journey from first enquiry to follow-up after return.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">See the journey <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/second-opinion" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Free second opinion</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Not sure about your diagnosis? Get an honest second opinion before deciding.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Get second opinion <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/cost-calculator" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Get indicative cost ranges for your treatment before reaching out.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Estimate costs <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Medical visa assistance</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Document checklists and processing times for your medical visa.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Visa guidance <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/emergency-urgent-cases" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-red-600/10">
                <Icon name="alert" size={20} className="text-red-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Urgent cases</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Fast-track support for time-sensitive cardiac, cancer, or transplant cases.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Urgent pathway <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/why-india-for-medical-treatment" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Why India</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Understand why India is a global leader in medical tourism.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Read more <Icon name="arrow-right" size={14} /></span>
          </a>
        </div>
      </div>
    </section>

    {/* ── CTA card ─────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Prefer to message us now?"
      body="Share your reports and we'll help you compare hospital options, clarify costs, and organize visa, travel, and recovery support — usually within 24–48 hours."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '#contact-form' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />

  <WhatsAppCTA number={whatsappNumber} variant="floating" client:load data-floating-cta />
</Layout>
