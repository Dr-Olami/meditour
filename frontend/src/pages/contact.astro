---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { LeadForm } from '../design-system/components/organisms/LeadForm';
import { WhatsAppCTA } from '../design-system/components/organisms/WhatsAppCTA';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getTreatments } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { LEAD_SOURCE } from '../lib/crm';
import { medicalWebPage, breadcrumbs, faqPage, localBusiness } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/contact`;

// Languages spoken by Khan Meditour coordinators.
const languagesSpoken = [
  { name: 'English', native: 'English', note: 'Primary coordination language' },
  { name: 'Bengali', native: 'বাংলা', note: 'For Bangladeshi patients' },
  { name: 'Hindi', native: 'हिन्दी', note: 'On-the-ground in India' },
  { name: 'Hausa', native: 'Harshen Hausa', note: 'For Nigerian / West African patients' },
  { name: 'Swahili', native: 'Kiswahili', note: 'For East African patients' },
  { name: 'Yoruba', native: 'Yorùbá', note: 'For Nigerian patients' },
  { name: 'Igbo', native: 'Igbo', note: 'For Nigerian patients' },
];

// Areas served — countries Khan Meditour has coordinated care for.
// `slug` links to dedicated country guides at /countries/[slug]; null = no guide yet.
const areasServed = [
  { name: 'Bangladesh', slug: 'bangladesh' },
  { name: 'Nigeria', slug: 'nigeria' },
  { name: 'Kenya', slug: 'kenya' },
  { name: 'Uganda', slug: 'uganda' },
  { name: 'Tanzania', slug: 'tanzania' },
  { name: 'Rwanda', slug: 'rwanda' },
  { name: 'Ethiopia', slug: 'ethiopia' },
  { name: 'Ghana', slug: 'ghana' },
  { name: 'Cameroon', slug: 'cameroon' },
  { name: 'Sudan', slug: 'sudan' },
  { name: 'Zimbabwe', slug: 'zimbabwe' },
  { name: 'Iraq', slug: 'iraq' },
  { name: 'Yemen', slug: 'yemen' },
  { name: 'Oman', slug: 'oman' },
  { name: 'United Arab Emirates', slug: 'uae' },
  { name: 'Saudi Arabia', slug: 'saudi-arabia' },
  { name: 'Kuwait', slug: 'kuwait' },
  { name: 'Qatar', slug: 'qatar' },
  { name: 'Bahrain', slug: 'bahrain' },
  { name: 'Jordan', slug: 'jordan' },
  { name: 'Egypt', slug: 'egypt' },
  { name: 'Iran', slug: 'iran' },
  { name: 'Maldives', slug: 'maldives' },
  { name: 'Sri Lanka', slug: 'sri-lanka' },
  { name: 'Nepal', slug: 'nepal' },
  { name: 'Afghanistan', slug: 'afghanistan' },
  { name: 'USA', slug: 'usa' },
  { name: 'UK', slug: 'uk' },
  { name: 'Canada', slug: 'canada' },
  { name: 'Australia', slug: 'australia' },
  { name: 'Kazakhstan', slug: 'kazakhstan' },
  { name: 'Sierra Leone', slug: null },
  { name: 'Mauritius', slug: null },
];

// Business hours — concierge line is 24/7, office hours for routine coordination.
const officeHours = 'Mon–Sat, 9:00 AM – 7:00 PM IST';
const conciergeHours = '24/7 for urgent and emergency cases';

const faqs = [
  {
    question: 'How quickly do you respond to enquiries?',
    answer:
      'We typically reply within 24 hours for routine enquiries — often much faster on WhatsApp. For urgent cases (cardiac, cancer, transplant, neurosurgery), our concierge line is monitored 24/7 and we usually acknowledge receipt within hours, not days.',
  },
  {
    question: 'What should I send when I first contact you?',
    answer:
      "Send whatever you have: recent medical reports, imaging summaries (CT/MRI/echo), current diagnosis or doctor's recommendation, your nationality (for visa guidance), and your best WhatsApp number. Even partial files help us start hospital outreach while you gather the rest.",
  },
  {
    question: 'What languages do your coordinators speak?',
    answer:
      'English, Bengali, Hindi, Hausa, Swahili, Yoruba, and Igbo. We coordinate in the language you are most comfortable with — you do not need to struggle with English to get help. Hospital interpreters are also available for Arabic, French, and Russian at partner hospitals.',
  },
  {
    question: 'Which countries do you serve?',
    answer:
      'We have coordinated care for patients from Bangladesh, Nigeria, Kenya, Uganda, Tanzania, Rwanda, Ethiopia, Ghana, Sierra Leone, Iraq, Yemen, Oman, the UAE, Saudi Arabia, the Maldives, and Mauritius. If your country is not listed, contact us — we can usually help.',
  },
  {
    question: 'How is my medical data handled?',
    answer:
      'Your medical reports and personal information are shared only with the hospitals and specialists reviewing your case — never sold, never shared with third parties, and never used for marketing without your consent. We use secure channels for document transfer and delete reports on request after your case is closed.',
  },
  {
    question: 'Do you charge for coordination?',
    answer:
      'No. Our coordination service is free for patients. You pay the hospital directly for treatment. We do not charge for hospital matching, report review, visa coordination, or travel planning. Our role is to make the pathway faster and clearer for your family.',
  },
  {
    question: 'Where is your office, and what are your hours?',
    answer:
      'Our team is based in Bangalore, Karnataka, India. Office hours for routine coordination are Monday to Saturday, 9:00 AM to 7:00 PM IST. Our concierge line for urgent and emergency cases is available 24/7 on WhatsApp.',
  },
  {
    question: 'How do I make a complaint?',
    answer:
      'We take complaints seriously. Email complaints@khanmeditour.com with the subject "Complaint" and a description of your concern. A senior coordinator will acknowledge within 24 hours and investigate. You can also raise a complaint via WhatsApp to our concierge line, marked as a complaint.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Contact Khan Meditour — Medical Tourism India',
    url: pageUrl,
    description:
      'Contact Khan Meditour for free medical tourism consultation to India. Bangalore-based coordinators speaking English, Bengali, Hindi, Hausa, Swahili, Yoruba, and Igbo. Reply within 24 hours.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Contact', url: `${pageUrl}/` },
  ]),
  localBusiness({
    name: t.site.name,
    url: `${siteUrl}/`,
    description:
      'Medical tourism facilitator based in Bangalore, India. Free coordination for international patients seeking treatment at JCI- and NABH-accredited hospitals.',
    telephone: `+${phoneNumber}`,
    whatsapp: `+${whatsappNumber}`,
    email: contactEmail,
    address: {
      streetAddress: 'Bangalore',
      addressLocality: 'Bangalore',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
    areaServed: areasServed.map((c) => c.name),
    availableLanguage: languagesSpoken.map((l) => l.name),
    openingHours: officeHours,
    specialties: ['Medical Tourism Coordination'],
  }),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`Contact Khan Meditour — Medical Tourism India | Free Consultation`}
  description="Contact Khan Meditour for free medical tourism consultation to India. Bangalore-based coordinators speaking English, Bengali, Hindi, Hausa, Swahili, Yoruba, and Igbo. Reply within 24 hours."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact-form' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Contact' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            {t.nav.contact}
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            Contact Khan Meditour — Medical Tourism to India
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            Free consultation for international patients seeking treatment in India. Reach us on <a
              href={`tel:+${phoneNumber}`}
              class="font-semibold text-ink hover:text-violet-600">Call +91 9606624861</a
            > or <a
              href={whatsappInquiryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-ink hover:text-violet-600">WhatsApp +8801611892986</a
            >. Our Bangalore-based coordinators speak English, Bengali, Hindi, Hausa, Swahili,
            Yoruba, and Igbo — and reply within 24 hours.
          </p>
        </div>
      </div>
    </section>

    {/* ── CONTACT FORM + INFO ──────────────────────────────────────── */}
    <section id="contact-form" class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-12 lg:grid-cols-2">
        {/* Left: contact info */}
        <div data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {t.cta.formTitle}
          </h2>
          <p class="text-ink/60 mt-4 text-lg">{t.cta.subtitle}</p>

          <div class="text-ink/70 mt-8 space-y-4">
            <a
              href={`tel:+${phoneNumber}`}
              class="flex items-center gap-3 transition-colors hover:text-ink"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="phone" size={20} />
              </span>
              <span class="text-base font-medium">+{phoneNumber}</span>
            </a>
            <a
              href={`mailto:${contactEmail}`}
              class="flex items-center gap-3 transition-colors hover:text-ink"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="mail" size={20} />
              </span>
              <span class="text-base font-medium">{contactEmail}</span>
            </a>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="whatsapp" size={20} />
              </span>
              <WhatsAppCTA number={whatsappNumber} client:load> WhatsApp us </WhatsAppCTA>
            </div>
          </div>

          {/* Response time note */}
          <div class="mt-8 rounded-card border border-cream-300 bg-cream-100 p-5">
            <p class="text-ink/70 text-sm">
              <span class="font-semibold text-ink">Response time:</span> We typically reply within 24
              hours. For urgent cases, WhatsApp is the fastest channel.
            </p>
          </div>

          {/* What to share checklist */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              What to share
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">
              A few details help us help you faster
            </h3>
            <ul class="mt-4 space-y-3">
              <li class="text-ink/70 flex items-start gap-3 text-sm">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Recent medical reports and imaging summaries</span>
              </li>
              <li class="text-ink/70 flex items-start gap-3 text-sm">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Current diagnosis or doctor's recommendation</span>
              </li>
              <li class="text-ink/70 flex items-start gap-3 text-sm">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Your nationality (for visa guidance)</span>
              </li>
              <li class="text-ink/70 flex items-start gap-3 text-sm">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>Best contact number and WhatsApp</span>
              </li>
            </ul>
            <p class="text-ink/50 mt-4 text-xs">
              WhatsApp is usually the fastest way to hear back from our care team.
            </p>
          </div>

          {/* Languages spoken */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Languages we speak
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">
              Coordinate in your language
            </h3>
            <p class="text-ink/60 mt-2 text-sm">
              You do not need to struggle with English to get help. Our coordinators speak:
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {
                languagesSpoken.map((lang) => (
                  <li class="inline-flex items-center gap-2 rounded-full border border-cream-300 bg-cream-50 px-3 py-1.5 text-sm">
                    <span class="font-semibold text-ink">{lang.native}</span>
                    <span class="text-ink/50 text-xs">— {lang.note}</span>
                  </li>
                ))
              }
            </ul>
            <p class="text-ink/50 mt-3 text-xs">
              Hospital interpreters are also available for Arabic, French, and Russian at partner
              hospitals.
            </p>
          </div>

          {/* Office address + hours */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Office & hours
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">
              Bangalore, Karnataka, India
            </h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                  Office hours
                </dt>
                <dd class="text-ink/70 mt-0.5">{officeHours}</dd>
              </div>
              <div>
                <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                  Concierge line
                </dt>
                <dd class="text-ink/70 mt-0.5">{conciergeHours}</dd>
              </div>
              <div>
                <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                  Time zone
                </dt>
                <dd class="text-ink/70 mt-0.5">India Standard Time (IST, UTC+5:30)</dd>
              </div>
            </dl>
          </div>

          {/* Areas served */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Countries we serve
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">
              Patients from {areasServed.length}+ countries
            </h3>
            <p class="text-ink/60 mt-2 text-sm">
              We have coordinated care for patients from {areasServed.length} countries. Click your country
              for a dedicated guide with costs, visa info, and flight times:
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                areasServed.map((country) => (
                  <li>
                    {country.slug ? (
                      <a
                        href={`/countries/${country.slug}`}
                        class="text-ink/70 inline-flex items-center rounded-full border border-cream-300 bg-cream-50 px-3 py-1 text-xs transition-colors hover:border-violet-300 hover:text-violet-700"
                      >
                        {country.name}
                      </a>
                    ) : (
                      <span class="text-ink/70 inline-flex items-center rounded-full border border-cream-300 bg-cream-50 px-3 py-1 text-xs">
                        {country.name}
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
            <p class="text-ink/50 mt-3 text-xs">
              Your country not listed? <a
                href={whatsappInquiryHref}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-violet-600 hover:text-violet-700">Contact us</a
              > — we can usually help. See the full list on our <a
                href="/countries"
                class="font-semibold text-violet-600 hover:text-violet-700">countries page</a
              >.
            </p>
          </div>
        </div>

        {/* Right: lead form */}
        <div
          class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8 lg:sticky lg:top-8 lg:self-start"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Free consultation
          </p>
          <h3 class="mt-2 font-display text-2xl font-bold text-ink">Tell us about your case</h3>
          <p class="text-ink/60 mt-2 text-sm">
            Share a few details and we will reply within 24–48 hours with hospital options and a
            cost estimate — or <a
              href={whatsappInquiryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-violet-600 hover:text-violet-700">WhatsApp us now</a
            >.
          </p>
          <div class="mt-6">
            <LeadForm
              source={LEAD_SOURCE.GENERAL_CONTACT}
              treatments={treatmentOptions}
              client:load
            />
          </div>
        </div>
      </div>
    </section>

    {/* ── WHO WE ARE: TRUST BLOCK ─────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Who we are
        </h2>
        <p class="text-ink/70 mb-8 max-w-2xl text-sm leading-relaxed" data-anim="fade-in-up">
          Khan Meditour is a medical tourism facilitator based in Bangalore, India. We connect
          international patients with JCI- and NABH-accredited partner hospitals for treatment
          across oncology, cardiac, transplant, neurosurgery, orthopedics, and more. We are not a
          hospital and do not provide clinical care — we coordinate the pathway so you can focus on
          treatment while we handle hospital matching, visa, travel, and recovery logistics.
        </p>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5" data-anim="fade-in-up">
            <p class="font-display text-2xl font-bold text-ink">Free</p>
            <p class="text-ink/60 mt-1 text-xs">
              Coordination for patients — you pay the hospital directly
            </p>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5" data-anim="fade-in-up">
            <p class="font-display text-2xl font-bold text-ink">7 languages</p>
            <p class="text-ink/60 mt-1 text-xs">
              English, Bengali, Hindi, Hausa, Swahili, Yoruba, Igbo
            </p>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5" data-anim="fade-in-up">
            <p class="font-display text-2xl font-bold text-ink">30+ countries</p>
            <p class="text-ink/60 mt-1 text-xs">
              Patients served across South Asia, Africa, and the Gulf
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── DATA PRIVACY & GRIEVANCE ─────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Your data & your rights
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Data privacy
            </p>
            <h3 class="mt-2 font-display text-lg font-bold text-ink">
              How we handle your medical reports
            </h3>
            <ul class="text-ink/70 mt-3 space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <Icon name="check" size={16} className="mt-0.5 text-violet-600" />
                <span
                  >Reports are shared only with hospitals and specialists reviewing your case</span
                >
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={16} className="mt-0.5 text-violet-600" />
                <span
                  >Never sold, never shared with third parties, never used for marketing without
                  consent</span
                >
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={16} className="mt-0.5 text-violet-600" />
                <span>Secure channels used for document transfer</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={16} className="mt-0.5 text-violet-600" />
                <span>Reports deleted on request after your case is closed</span>
              </li>
            </ul>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Complaints
            </p>
            <h3 class="mt-2 font-display text-lg font-bold text-ink">
              Not happy with our service?
            </h3>
            <p class="text-ink/70 mt-3 text-sm">
              Email <a
                href="mailto:complaints@khanmeditour.com"
                class="font-semibold text-violet-600 hover:text-violet-700"
                >complaints@khanmeditour.com</a
              > with the subject "Complaint" and a description of your concern. A senior coordinator will
              acknowledge within 24 hours and investigate.
            </p>
            <p class="text-ink/70 mt-3 text-sm">
              You can also raise a complaint via WhatsApp to our concierge line, marked as a
              complaint.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Explore further
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
