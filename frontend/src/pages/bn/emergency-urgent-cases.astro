      'বেশিরভাগ দেশের হেলথ ইনস্যুরেন্স বিদেশে চিকিৎসা কভার করে না। সাধারণ ট্রাভেল ইনস্যুরেন্স সাধারণত পূর্ব-বিদ্যমান রোগ ও পরিকল্পিত মেডিকেল প্রক্রিয়া বাদ দেয়, এবং দেশে ফেরার পর জটিলতা সাধারণত কভার করে না। আপনার দরকার বিশেষ মেডিকেল ট্রাভেল ইনস্যুরেন্স যা স্পষ্টভাবে মেডিকেল ট্যুরিজম জটিলতা ও মেডিকেল ইভাকুয়েশন কভার করে। ভারত ভ্রমণের জন্য অন্তত $১,০০,০০০ মেডিকেল ও $৫,০০,০০০ ইভাকুয়েশন কভারেজ সুপারিশ করা হয়। আমরা ক্লেম ডকুমেন্টেশন সমন্বয়ে সাহায্য করি — হাসপাতালের চিঠি, রিপোর্ট, আইটেমাইজড বিল — কিন্তু আমরা বীমা বিক্রি করি না এবং ক্লেম অনুমোদন গ্যারান্টি দিতে পারি না। ভ্রমণের আগে আপনার ইনস্যুরারকে জিজ্ঞেস করুন।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'জরুরি ও তাত্ক্ষণিক মেডিকেল কেস',
    url: pageUrl,
    description:
      'ভারতে সময়-সংবেদনশীল মেডিকেল ভ্রমণের জন্য দ্রুত-ট্র্যাক সহায়তা — অনকোলজি, কার্ডিয়াক, ট্রান্সপ্লান্ট এবং নিউরোসার্জারি কেস যা অপেক্ষা করতে পারে না।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'জরুরি ও তাত্ক্ষণিক কেস', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`জরুরি ও তাত্ক্ষণিক কেস | ${t.site.name}`}
  description="ভারতে সময়-সংবেদনশীল মেডিকেল ভ্রমণের জন্য দ্রুত-ট্র্যাক সহায়তা — অনকোলজি, কার্ডিয়াক, ট্রান্সপ্লান্ট এবং নিউরোসার্জারি কেস যা অপেক্ষা করতে পারে না।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO (warning-red soft background) ───────────────────────── */}
    <section class="relative overflow-hidden bg-red-50 text-ink">
      <div
        class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-red-200/40 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-red-100/50 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'জরুরি ও তাত্ক্ষণিক কেস' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div
          class="rounded-2xl border border-red-200 bg-white/80 px-6 py-12 shadow-base md:px-12 md:py-14"
          data-anim="stagger-children"
        >
          <span
            class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-red-700"
          >
            <Icon name="alert" size={14} />
            জরুরি পথ
          </span>
          <h1
            class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            সময়-সংবেদনশীল কেসের জন্য দ্রুত-ট্র্যাক সহায়তা
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            ক্যানসার, কার্ডিয়াক, ট্রান্সপ্লান্ট, বা নিউরোসার্জারি অপেক্ষা করতে পারে না হলে,
            অবিলম্বে আমাদের সাথে যোগাযোগ করুন। আমরা জরুরি অনুসন্ধানকে হাসপাতাল ম্যাচিং, আমন্ত্রণ
            পত্র এবং ভ্রমণ পরিকল্পনার জন্য অগ্রাধিকার দেই।
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={whatsappInquiryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-card bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-700"
              data-anim="press-button"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp জরুরি লাইন
            </a>
            <a
              href={`tel:+${phoneNumber}`}
              class="inline-flex items-center justify-center gap-2 rounded-card border-2 border-red-600 px-6 py-3 text-sm font-semibold text-red-700 hover:bg-red-50"
              data-anim="press-button"
            >
              <Icon name="phone" size={18} />
              কল +{phoneNumber}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── TWO-COLUMN: LEFT INFO + RIGHT LEAD FORM ──────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-8 lg:grid-cols-2 lg:gap-12">
        {/* ── LEFT: stacked info cards ─────────────────────────────── */}
        <div class="space-y-6">
          {/* Important warning */}
          <div class="rounded-card border border-red-200 bg-red-50 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-red-700">গুরুত্বপূর্ণ</p>
            <p class="text-ink/80 mt-3 text-sm leading-relaxed">
              এই পৃষ্ঠাটি জরুরি মেডিকেল ভ্রমণ সমন্বয়ের জন্য — আপনার দেশে জরুরি অ্যাম্বুলেন্স সেবা
              নয়। কেউ তাৎক্ষণিক জীবন-হুমকিতে থাকলে, প্রথমে স্থানীয় জরুরি সেবায় কল করুন, তারপর
              ভারতে চিকিৎসা পরিকল্পনার জন্য আমাদের সাথে যোগাযোগ করুন।
            </p>
          </div>

          {/* Common urgent pathways */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              সাধারণ জরুরি পথ
            </p>
            <h2 class="mt-2 font-display text-xl font-bold text-ink">
              যে কেসগুলো আমরা সবচেয়ে বেশি দ্রুত-ট্র্যাক করি
            </h2>
            <ul class="mt-4 space-y-3">
              {
                urgentPathways.map((item) => (
                  <li class="text-ink/80 flex items-start gap-3 text-sm">
                    <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <p class="text-ink/60 mt-4 text-sm">
              উপলব্ধ রিপোর্ট অবিলম্বে শেয়ার করুন — আংশিক ফাইলও আমাদের হাসপাতালের সাথে যোগাযোগ শুরু
              করতে সাহায্য করে যখন আপনি বাকি ডকুমেন্ট সংগ্রহ করেন।
            </p>
          </div>

          {/* What happens on an urgent enquiry */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-ink">
              জরুরি অনুসন্ধানে কী হয়
            </p>
            <ol class="mt-4 space-y-4">
              {
                urgentSteps.map((step, index) => (
                  <li class="text-ink/80 flex items-start gap-4 text-sm">
                    <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border-2 border-ink text-xs font-bold text-ink">
                      {index + 1}
                    </span>
                    <span class="pt-0.5">{step}</span>
                  </li>
                ))
              }
            </ol>
            <p class="text-ink/60 mt-5 text-sm">
              সম্পূর্ণ যাত্রা জানতে আমাদের <a
                href="/bn/how-it-works"
                class="font-semibold text-violet-600 hover:text-violet-700">কীভাবে কাজ করে পৃষ্ঠা</a
              > দেখুন।
            </p>
          </div>
        </div>

        {/* ── RIGHT: lead form ─────────────────────────────────────── */}
        <div
          class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8 lg:sticky lg:top-8 lg:self-start"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-red-600">
            জরুরি অনুসন্ধান
          </p>
          <h2 class="mt-2 font-display text-2xl font-bold text-ink">এখনই আপনার কেস পাঠান</h2>
          <p class="text-ink/60 mt-2 text-sm">
            আপনার কেস জরুরি হিসেবে চিহ্নিত করুন। একজন কোঅর্ডিনেটর WhatsApp-এ গ্রহণ নিশ্চিত করবেন —
            সাধারণত দিনের মধ্যে, দিন নয়।
          </p>
          <div class="mt-6">
            <LeadForm source={LEAD_SOURCE.EMERGENCY} treatments={treatmentOptions} client:load />
          </div>
        </div>
      </div>
    </section>

    {/* ── WHEN A CASE IS GENUINELY URGENT ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-5xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          কোন কেস সত্যিকারের জরুরি
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          "জরুরি" একটি ক্লিনিক্যাল বিচার, অনুভূতি নয়। নিচের টেবিলে ব্যাখ্যা করা হয়েছে কোন
          অবস্থাগুলো সত্যিকারের দ্রুত-ট্র্যাক যোগ্য এবং কেন সময় গুরুত্বপূর্ণ। আপনার পরিস্থিতি
          এগুলোর একটির সাথে মিললে অবিলম্বে আমাদের যোগাযোগ করুন — এবং যে রিপোর্ট আছে শেয়ার করুন।
        </p>
        {/* Mobile: stacked cards */}
        <div class="space-y-4 md:hidden">
          {
            urgencyConditions.map((c) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <div class="flex items-start justify-between gap-3">
                  <p class="text-sm font-semibold text-ink">{c.condition}</p>
                  {c.fastTrack ? (
                    <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">
                      <Icon name="check" size={10} /> হ্যাঁ
                    </span>
                  ) : (
                    <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">
                      আগে স্থিতিশীল করুন
                    </span>
                  )}
                </div>
                <dl class="mt-3 space-y-2 text-sm">
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      উদাহরণ
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{c.examples}</dd>
                  </div>
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      কেন সময় গুরুত্বপূর্ণ
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{c.whyUrgent}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>
        {/* Desktop: table */}
        <div class="hidden md:block">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
              <tr class="text-ink/60 border-b border-cream-300 text-xs uppercase tracking-widest">
                <th class="py-3 pr-4 font-semibold">অবস্থা</th>
                <th class="py-3 pr-4 font-semibold">উদাহরণ</th>
                <th class="py-3 pr-4 font-semibold">কেন সময় গুরুত্বপূর্ণ</th>
                <th class="py-3 font-semibold">দ্রুত-ট্র্যাক?</th>
              </tr>
            </thead>
            <tbody>
              {
                urgencyConditions.map((c) => (
                  <tr class="border-b border-cream-200 align-top">
                    <td class="py-4 pr-4 font-semibold text-ink">{c.condition}</td>
                    <td class="text-ink/70 py-4 pr-4">{c.examples}</td>
                    <td class="text-ink/70 py-4 pr-4">{c.whyUrgent}</td>
                    <td class="py-4">
                      {c.fastTrack ? (
                        <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">
                          <Icon name="check" size={10} /> হ্যাঁ
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">
                          আগে স্থিতিশীল করুন
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-ink/50 mt-6 text-xs">
          এই টেবিল একটি সাধারণ গাইড, মেডিকেল পরামর্শ নয়। আপনার রিপোর্টের ভিত্তিতে চিকিৎসক হাসপাতালই
          চূড়ান্ত সিদ্ধান্ত নেয় কেসটি দ্রুত-ট্র্যাক যোগ্য কিনা।
        </p>
      </div>
    </section>

    {/* ── EMERGENCY MEDICAL VISA REALITY ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-5xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          জরুরি মেডিকেল ভিসা: সত্যিকারের চিত্র
        </h2>
        <p class="text-ink/60 mb-3 max-w-2xl text-sm" data-anim="fade-in-up">
          ভারতে আলাদা "জরুরি মেডিকেল ভিসা" ক্যাটাগরি নেই। হাসপাতালের আমন্ত্রণ পত্র ও চিকিৎসকের জরুরি
          চিঠিতে সময়-সংবেদনশীলতা স্পষ্টভাবে দলিল থাকলে স্ট্যান্ডার্ড মেডিকেল ভিসা অগ্রাধিকার পেতে
          পারে। নিচের সময়গুলো নির্দেশক — কোনো ফ্যাসিলিটেটর, হাসপাতাল বা দূতাবাস ভিসা অনুমোদন
          গ্যারান্টি দিতে পারে না।
        </p>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          আমরা আমন্ত্রণ পত্র ত্বরান্বিত করি এবং দূতাবাস বা ই-ভিসা পোর্টালের সাথে সমন্বয় করি। ভিসা
          অনুমোদনের সময় ভারত সরকার ও আপনার আবেদনের দেশের উপর নির্ভর করে।
        </p>
        {/* Mobile: stacked cards */}
        <div class="space-y-4 md:hidden">
          {
            visaOptions.map((v) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <p class="text-sm font-semibold text-ink">{v.type}</p>
                <dl class="mt-3 space-y-2 text-sm">
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      স্ট্যান্ডার্ড সময়
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{v.standardTime}</dd>
                  </div>
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      জরুরি (কেসনির্ভর)
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{v.urgentTime}</dd>
                  </div>
