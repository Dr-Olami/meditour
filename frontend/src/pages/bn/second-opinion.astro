---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { StepTimeline } from '../../design-system/components/organisms/StepTimeline';
import { StatCounter } from '../../design-system/components/organisms/StatCounter';
import { DoctorCard } from '../../design-system/components/organisms/DoctorCard';
import { TestimonialCarousel } from '../../design-system/components/organisms/TestimonialCarousel';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { LeadForm } from '../../design-system/components/organisms/LeadForm';
import { LeadModalTrigger } from '../../design-system/components/organisms/LeadModalTrigger';
import { WhatsAppCTA } from '../../design-system/components/organisms/WhatsAppCTA';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import { ChipCloud } from '../../design-system/components/molecules/ChipCloud';
import { PullQuote } from '../../design-system/components/molecules/PullQuote';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getDoctors, getHospitals, getTreatments, getTestimonials, resolveHospital, entrySlug } from '../../lib/content';
import { medicalWebPage, faqPage, breadcrumbs } from '../../lib/schema';
import { getDoctorInquiryLink, getSecondOpinionLink } from '../../lib/whatsapp';
import { LEAD_SOURCE } from '../../lib/crm';
import type { Doctor } from '../../design-system/components/organisms/DoctorCard';

const locale = 'bn';
const t = getTranslations(locale);
const so = t.secondOpinion;

const [doctorEntries, hospitalEntries, treatmentEntries, testimonialEntries] = await Promise.all([
  getDoctors(locale),
  getHospitals(locale),
  getTreatments(locale),
  getTestimonials(locale),
]);

const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const whatsappHref = getSecondOpinionLink();

const doctors: Doctor[] = doctorEntries.slice(0, 4).map((entry) => {
  const hospital = resolveHospital(entry.data.hospitalId, hospitalEntries);
  return {
    name: entry.data.name,
    specialty: entry.data.specialty,
    qualification: entry.data.qualification,
    experienceYears: entry.data.experienceYears,
    avatar: entry.data.avatar,
    href: `/bn/doctors/${entrySlug(entry)}`,
    hospitalName: hospital?.name,
    hospitalHref: hospital?.href,
    whatsappHref: getDoctorInquiryLink(entry.data.name) || undefined,
  };
});

const testimonials = testimonialEntries.map((entry) => entry.data);

const siteStats = so.heroStats;

const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = [
  medicalWebPage({
    name: so.title,
    url: pageUrl,
    description: so.metaDescription,
    inLanguage: 'bn',
    audience: 'Patients seeking an independent second opinion before surgery or major treatment in India',
  }),
  faqPage({ entries: so.faqs }),
  breadcrumbs([
    { name: t.nav.home, url: new URL('/bn/', Astro.url.origin).toString() },
    { name: so.title, url: pageUrl },
  ]),
];
---

<Layout
  title={`${so.title} | ${t.site.name}`}
  description={so.metaDescription}
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
  {/* ── HERO — light editorial band ────────────────────────────────────
      Backdrop: /images/patterns/second-opinion-hero.jpg (opacity-10,
      eager-loaded). Abstract background with violet/indigo light
      streaks — premium healthcare aesthetic. */}
  <section class="relative overflow-hidden bg-cream-100 text-ink">
    <img
      src="/images/patterns/second-opinion-hero.jpg"
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
    />
    <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
    <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

    <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
      <Breadcrumb
        items={[{ label: t.nav.home, href: '/bn/' }, { label: so.title }]}
        class="mb-10"
        data-anim="fade-in-up"
      />

      <div data-anim="stagger-children">
        <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
          {so.badge}
        </span>
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
          {so.heroTitle}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">{so.heroSubtitle}</p>

        {/* CTA */}
        <div class="mt-16 flex justify-center md:mt-40">
          <LeadModalTrigger
            client:load
            label={so.secondaryCta}
            modalTitle={t.leadModal.title}
            modalSubtitle={t.leadModal.subtitle}
            closeLabel={t.leadModal.close}
            source={LEAD_SOURCE.SECOND_OPINION}
            treatments={treatmentOptions}
            variant="dark"
            className="px-8"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ── PULL QUOTE — emotional beat ────────────────────────────────── */}
  <section class="container py-12 md:py-16" data-anim="fade-in-up">
    <PullQuote
      quote={so.pullQuote}
      attribution={so.pullQuoteAttribution}
      tone="light"
      class="mx-auto max-w-3xl"
    />
  </section>

  {/* ── BODY — content + sticky booking sidebar ────────────────────── */}
  <section class="container py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div>
        {/* When to get a second opinion */}
        <div data-anim="scroll-reveal">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{so.whenTitle}</h2>
          <ul class="mt-8 space-y-4">
            {so.whenItems.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink/80">
                <Icon name="check" size={20} className="mt-0.5 text-ink" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Reports checklist */}
        <div class="mt-12" data-anim="scroll-reveal">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{so.reportsTitle}</h2>
          <ul class="mt-8 space-y-4">
            {so.reportsItems.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink/80">
                <Icon name="check" size={20} className="mt-0.5 text-ink" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-5 text-sm text-ink/70">
            {so.reportsNote}
          </p>
        </div>

        {/* How it works */}
        <div class="mt-12" data-anim="scroll-reveal">
          <h2 class="mb-10 font-display text-3xl font-bold text-ink md:text-4xl">{so.stepsTitle}</h2>
          <StepTimeline steps={so.steps} className="md:grid-cols-3" />
        </div>

        {/* What you will receive */}
        <div class="mt-12" data-anim="scroll-reveal">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{so.receiveTitle}</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {so.receiveItems.map((item) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <p class="flex items-start gap-3 text-base text-ink/80">
                  <Icon name="check" size={20} className="mt-0.5 text-ink" />
                  <span>{item}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Sticky conversion rail */}
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start" data-anim="fade-in-up">
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base">
          <h3 class="font-display text-lg font-semibold text-ink">{so.railTitle}</h3>
          <p class="mt-2 text-sm text-ink/60">{so.railSummary}</p>
          <div class="mt-5 flex flex-col gap-3">
            <LeadModalTrigger
              client:load
              label={so.modalCta}
              modalTitle={t.leadModal.title}
              modalSubtitle={t.leadModal.subtitle}
              closeLabel={t.leadModal.close}
              source={LEAD_SOURCE.SECOND_OPINION}
              treatments={treatmentOptions}
              full
              className="rounded-card px-6 py-3"
            />
            {whatsappHref && (
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-card border border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-white" data-anim="press-button">
                <Icon name="whatsapp" size={18} />
                {so.primaryCta}
              </a>
            )}
          </div>
        </div>

        {/* Site stats in rail */}
        <div class="rounded-card border border-cream-300 bg-cream-200 p-6">
          <StatCounter stats={siteStats} className="grid-cols-2 md:grid-cols-2" />
        </div>
      </aside>
    </div>
  </section>

  {/* ── MID-PAGE CTA — dark band ───────────────────────────────────── */}
  <section class="relative overflow-hidden bg-ink py-16 text-cream-100" data-anim="fade-in-up">
    <div class="pointer-events-none absolute inset-0 bg-ink/70" aria-hidden="true" />
    <div class="pointer-events-none absolute -left-32 top-0 h-72 w-72 rounded-full bg-violet-600/15 blur-3xl" aria-hidden="true" />
    <div class="container relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold text-cream-100 md:text-3xl">{so.midCtaTitle}</h2>
        <p class="mt-2 max-w-xl text-cream-100/60">{so.midCtaSubtitle}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <LeadModalTrigger
          client:load
          label={so.modalCta}
          modalTitle={t.leadModal.title}
          modalSubtitle={t.leadModal.subtitle}
          closeLabel={t.leadModal.close}
          source={LEAD_SOURCE.SECOND_OPINION}
          treatments={treatmentOptions}
          className="rounded-card px-6 py-3"
        />
        {whatsappHref && (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-card border border-cream-100/30 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:bg-cream-100 hover:text-ink" data-anim="press-button">
            <Icon name="whatsapp" size={18} />
            {so.primaryCta}
          </a>
        )}
      </div>
    </div>
  </section>

  {/* ── SPECIALISTS ────────────────────────────────────────────────── */}
  {doctors.length > 0 && (
    <section class="bg-cream-100 py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="mb-10 max-w-2xl" data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{so.doctorsTitle}</h2>
          <p class="mt-4 text-lg text-ink/60">{so.doctorsSummary}</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-2" data-anim="stagger-cards">
          {doctors.map((doctor) => (
            <DoctorCard key={doctor.name} doctor={doctor} bookLabel={t.doctors.bookCta} whatsappLabel={t.doctors.detail.whatsappCta} />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── TESTIMONIALS ───────────────────────────────────────────────── */}
  <section class="bg-cream-200 py-20" data-anim="scroll-reveal">
    <TestimonialCarousel title={t.testimonials.title} items={testimonials} client:load />
  </section>

  {/* ── FAQ ────────────────────────────────────────────────────────── */}
  <section class="bg-cream-100 py-20" data-anim="scroll-reveal">
    <div class="container max-w-3xl">
      <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
        {so.faqTitle}
      </h2>
      <FAQAccordion items={so.faqs} client:visible />
    </div>
  </section>
  </main>

  {/* ── LEAD FORM ──────────────────────────────────────────────────── */}
  <section id="contact" class="bg-cream-200 py-20" data-anim="stagger-children">
    <div class="container grid gap-12 lg:grid-cols-2">
      <div data-anim="fade-in-up">
        <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{so.ctaTitle}</h2>
        <p class="mt-4 text-lg text-ink/60">{so.ctaSubtitle}</p>
        <div class="mt-8">
          <WhatsAppCTA context={{ type: 'second-opinion' }} client:load>
            {so.primaryCta}
          </WhatsAppCTA>
        </div>
      </div>
      <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
        <h3 class="mb-6 font-display text-xl font-semibold text-ink">{so.formTitle}</h3>
        <LeadForm
          source={LEAD_SOURCE.SECOND_OPINION}
          defaultMessage={so.formDefaultMessage}
          treatments={treatmentOptions}
          client:load
        />
      </div>
    </div>
  </section>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />

  <WhatsAppCTA context={{ type: 'second-opinion' }} variant="floating" client:load data-floating-cta />
</Layout>
