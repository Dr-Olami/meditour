      'স্বীকৃতি মানের একটি শক্তিশালী প্রমাণ, কিন্তু গ্যারান্টি নয়। এটি নিখুঁত ফলাফল গ্যারান্টি দেয় না — যেকোনো স্বীকৃত হাসপাতালে জটিলতা হতে পারে। এটি জটিলতার বীমা কভার করে না — আপনার দেশের হেলথ ইনস্যুরেন্স ও সাধারণ ট্রাভেল ইনস্যুরেন্স সাধারণত বিদেশে চিকিৎসা বা দেশে ফেরার পর জটিলতার খরচ দেবে না। এটি ব্যক্তিগত ডাক্তারের দক্ষতা গ্যারান্টি দেয় না — আপনার সার্জনের যোগ্যতা, অভিজ্ঞতা ও কেস সংখ্যা এখনও যাচাই করা উচিত। এবং এটি নিজের সতর্কতার বিকল্প নয়: আপনার নির্দিষ্ট প্রক্রিয়ার জন্য সাফল্যের হার, সংক্রমণের হার ও রোগীদের মতামত জিজ্ঞেস করুন।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'ভারতে হাসপাতাল স্বীকৃতি — JCI, NABH, NABL, MTQUA ব্যাখ্যা',
    url: pageUrl,
    description:
      'JCI, NABH, NABL, MTQUA, AAHRPP, ISO 9001 ও IFEM স্বীকৃতি বিস্তারিত — প্রতিটি ব্যাজ আপনার চিকিৎসায় কী বোঝায়, কীভাবে যেকোনো হাসপাতাল নিজে যাচাই করবেন, এবং স্বীকৃতি কী গ্যারান্টি দেয় আর কী দেয় না।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'স্বীকৃতি', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`ভারতে হাসপাতাল স্বীকৃতি — JCI, NABH, NABL, MTQUA | ${t.site.name}`}
  description="JCI, NABH, NABL, MTQUA, AAHRPP, ISO 9001 ও IFEM স্বীকৃতি বিস্তারিত — প্রতিটি ব্যাজ আপনার চিকিৎসায় কী বোঝায়, কীভাবে যেকোনো হাসপাতাল নিজে যাচাই করবেন, এবং স্বীকৃতি কী গ্যারান্টি দেয় আর কী দেয় না।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-blue-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'স্বীকৃতি' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            মানের মানদণ্ড
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            JCI, NABH, NABL, MTQUA — প্রতিটি ব্যাজ আপনার চিকিৎসায় কী বোঝায়
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            চিকিৎসার জন্য বিদেশে এলে আপনাকে জানতে হবে হাসপাতালটি আন্তর্জাতিক মানের কিনা। এখানে
            প্রতিটি স্বীকৃতি কী বোঝায়, কীভাবে যেকোনো হাসপাতাল নিজে যাচাই করবেন, এবং স্বীকৃতি কী
            গ্যারান্টি দেয় আর কী দেয় না — সব এক জায়গায়, যাতে আপনি নিশ্চিন্তে বেছে নিতে পারেন।
          </p>
        </div>
      </div>
    </section>

    {/* ── ACCREDITATION CARDS ──────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="space-y-6">
          {
            accreditations.map((acc) => (
              <div
                class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8"
                data-anim="fade-in-up"
              >
                <div class="grid gap-6 lg:grid-cols-[auto_1fr] lg:gap-8">
                  {/* Badge */}
                  <div class="flex flex-col items-start gap-3">
                    <span
                      class={`inline-flex items-center justify-center rounded-2xl ${acc.color} px-5 py-3 font-display text-2xl font-bold text-white shadow-base`}
                    >
                      {acc.abbr}
                    </span>
                    <span class="text-ink/60 rounded-full bg-cream-200 px-3 py-1 text-xs font-medium">
                      {acc.origin}
                    </span>
                  </div>

                  {/* Content */}
                  <div>
                    <h2 class="font-display text-xl font-bold text-ink">{acc.full}</h2>
                    <p class="text-ink/70 mt-3 text-sm leading-relaxed">{acc.description}</p>

                    {/* What it means */}
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-widest text-ink">
                        আপনার জন্য এর অর্থ
                      </p>
                      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                        {acc.whatItMeans.map((item) => (
                          <li class="text-ink/70 flex items-start gap-2 text-sm">
                            <span class="bg-ink/10 mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-violet-600">
                              <Icon name="check" size={12} className="text-ink" />
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <p class="text-ink/70 mt-5 inline-flex items-center gap-2 rounded-full bg-cream-200 px-3 py-1.5 text-xs font-semibold">
                      <Icon name="globe" size={12} className="text-ink/50" />
                      {acc.indiaCount}
                    </p>

                    <a
                      href={acc.verifyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
                    >
                      {acc.verifyLabel}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── WHAT ACCREDITATION DOES NOT COVER ────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          স্বীকৃতি যা গ্যারান্টি দেয় না
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          স্বীকৃতি মানের একটি শক্তিশালী প্রমাণ, কিন্তু গ্যারান্টি নয়। এটি যা কভার করে না তা জানলে
          চিকিৎসার সিদ্ধান্ত নেওয়ার আগে সঠিক প্রশ্নগুলো করতে পারবেন।
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">নিখুঁত ফলাফল</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              যেকোনো স্বীকৃত হাসপাতালে জটিলতা হতে পারে। স্বীকৃতি শুধু নিশ্চিত করে যে সুরক্ষা নিয়ম
              আছে এবং মানা হচ্ছে — কিন্তু চিকিৎসার ঝুঁকি পুরোপুরি দূর করে না।
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">জটিলতার বীমা</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              আপনার দেশের হেলথ ইনস্যুরেন্স ও সাধারণ ট্রাভেল ইনস্যুরেন্স সাধারণত বিদেশে চিকিৎসা বা
              দেশে ফেরার পর জটিলতার খরচ দেবে না। জটিলতা কভার করে এমন মেডিকেল ট্রাভেল ইনস্যুরেন্স
              সম্পর্কে জিজ্ঞেস করুন।
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">ব্যক্তিগত ডাক্তারের দক্ষতা</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              স্বীকৃতি হাসপাতালকে কভার করে, ব্যক্তিগত সার্জনকে নয়। আপনার ডাক্তারের যোগ্যতা,
              অভিজ্ঞতা ও নির্দিষ্ট প্রক্রিয়ার কেস সংখ্যা এখনও যাচাই করা উচিত।
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">নিজের সতর্কতার বিকল্প</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              স্বীকৃতি একটি প্রাথমিক যাচাই, পুরো উত্তর নয়। সিদ্ধান্ত নেওয়ার আগে আপনার নির্দিষ্ট
              প্রক্রিয়ার জন্য সাফল্যের হার, সংক্রমণের হার ও রোগীদের মতামত জিজ্ঞেস করুন।
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── HOW TO VERIFY ────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          কীভাবে হাসপাতালের স্বীকৃতি নিজে যাচাই করবেন
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          অফিসিয়াল ডিরেক্টরি দিয়ে ২ মিনিটের মধ্যে যেকোনো হাসপাতালের স্বীকৃতি যাচাই করতে পারবেন।
          শুধু সার্টিফিকেট আছে কিনা দেখবেন না, মেয়াদ উত্তীর্ণের তারিখও দেখবেন — হাসপাতাল মান ধরে
          রাখতে না পারলে স্বীকৃতি বাতিল হয়ে যেতে পারে।
        </p>
        <div class="space-y-6">
          {/* JCI verification */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-3">
              <span
                class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-4 py-2 font-display text-base font-bold text-white"
              >
                JCI
              </span>
              <h3 class="font-display text-lg font-bold text-ink">JCI স্বীকৃতি যাচাই করুন</h3>
            </div>
            <ol class="text-ink/80 ml-5 list-decimal space-y-2 text-sm">
              <li>
                <span class="font-semibold text-ink">jointcommissioninternational.org</span>-এ যান
              </li>
              <li>"Accredited Organizations" ডিরেক্টরি খুঁজুন</li>
              <li>দেশ হিসেবে <span class="font-semibold text-ink">India</span> নির্বাচন করুন</li>
              <li>হাসপাতালের নাম দিয়ে সার্চ করুন</li>
              <li>স্বীকৃতির অবস্থা, প্রদানের তারিখ ও মেয়াদ উত্তীর্ণের তারিখ দেখুন</li>
            </ol>
            <a
              href="https://www.jointcommission.org/en"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
            >
              JCI ডিরেক্টরি খুলুন
              <Icon name="arrow-right" size={14} />
            </a>
          </div>

          {/* NABH verification */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-3">
              <span
                class="inline-flex items-center justify-center rounded-2xl bg-violet-600 px-4 py-2 font-display text-base font-bold text-white"
              >
                NABH
              </span>
              <h3 class="font-display text-lg font-bold text-ink">NABH স্বীকৃতি যাচাই করুন</h3>
            </div>
            <ol class="text-ink/80 ml-5 list-decimal space-y-2 text-sm">
              <li><span class="font-semibold text-ink">nabh.co</span>-তে যান</li>
              <li>"Accredited Hospitals" ডিরেক্টরি খুলুন</li>
              <li>হাসপাতালের নাম বা রাজ্য দিয়ে সার্চ করুন</li>
              <li>স্বীকৃতি সার্টিফিকেট নম্বর ও বৈধতার মেয়াদ দেখুন</li>
            </ol>
            <a
              href="https://nabh.co/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
            >
              NABH ডিরেক্টরি খুলুন
              <Icon name="arrow-right" size={14} />
            </a>
          </div>

          {/* NABL verification */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-3">
              <span
                class="inline-flex items-center justify-center rounded-2xl bg-green-600 px-4 py-2 font-display text-base font-bold text-white"
              >
                NABL
              </span>
              <h3 class="font-display text-lg font-bold text-ink">NABL স্বীকৃতি যাচাই করুন</h3>
            </div>
            <ol class="text-ink/80 ml-5 list-decimal space-y-2 text-sm">
              <li><span class="font-semibold text-ink">nabl-india.org</span>-এ যান</li>
              <li>স্বীকৃত ল্যাবরেটরি ডিরেক্টরি খুলুন</li>
              <li>ল্যাবের নাম বা অবস্থান দিয়ে সার্চ করুন</li>
              <li>স্বীকৃতির পরিসর ও বৈধতার মেয়াদ দেখুন</li>
            </ol>
            <a
              href="https://nabl-india.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
            >
              NABL ডিরেক্টরি খুলুন
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </div>
