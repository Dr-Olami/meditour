---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { LeadForm } from '../../design-system/components/organisms/LeadForm';
import { WhatsAppCTA } from '../../design-system/components/organisms/WhatsAppCTA';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getTreatments, entrySlug } from '../../lib/content';
import { getInquiryLink } from '../../lib/whatsapp';
import { LEAD_SOURCE } from '../../lib/crm';
import { medicalWebPage, breadcrumbs } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'khan@meditour.com';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/contact`;

const jsonLd = [
  medicalWebPage({
    name: 'যোগাযোগ',
    url: pageUrl,
    description: 'খান মেডিট্যুরের সাথে যোগাযোগ করুন। WhatsApp বা ইমেইলে আপনার রিপোর্ট শেয়ার করুন, আমরা ২৪ ঘন্টার মধ্যে জবাব দেব।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'যোগাযোগ', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`যোগাযোগ | ${t.site.name}`}
  description="খান মেডিট্যুরের সাথে যোগাযোগ করুন। WhatsApp বা ইমেইলে আপনার রিপোর্ট শেয়ার করুন, আমরা ২৪ ঘন্টার মধ্যে জবাব দেব।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact-form' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'যোগাযোগ' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            {t.nav.contact}
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            যোগাযোগ করুন
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            বিনামূল্যে পরামর্শের জন্য খান মেডিট্যুরে <a href="tel:+8801611892986" class="font-semibold text-ink hover:text-violet-600">কল করুন +880 1611892986</a> অথবা <a href={whatsappInquiryHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-ink hover:text-violet-600">WhatsApp করুন +8801611892986</a>। অথবা নিচের ফর্ম পূরণ করুন — আপনার মেডিকেল রিপোর্ট শেয়ার করুন এবং আমাদের ব্যাঙ্গালোর টিম থেকে ২৪–৪৮ ঘন্টার মধ্যে হাসপাতালের বিকল্প ও খরচের অনুমান পান।
          </p>
        </div>
      </div>
    </section>

    {/* ── CONTACT FORM + INFO ──────────────────────────────────────── */}
    <section id="contact-form" class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-12 lg:grid-cols-2">
        {/* Left: contact info */}
        <div data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {t.cta.formTitle}
          </h2>
          <p class="mt-4 text-lg text-ink/60">{t.cta.subtitle}</p>

          <div class="mt-8 space-y-4 text-ink/70">
            <a href={`tel:${whatsappNumber}`} class="flex items-center gap-3 transition-colors hover:text-ink">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="phone" size={20} />
              </span>
              <span class="text-base font-medium">{whatsappNumber}</span>
            </a>
            <a href={`mailto:${contactEmail}`} class="flex items-center gap-3 transition-colors hover:text-ink">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="mail" size={20} />
              </span>
              <span class="text-base font-medium">{contactEmail}</span>
            </a>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="whatsapp" size={20} />
              </span>
              <WhatsAppCTA number={whatsappNumber} client:load>
                হোয়াটসঅ্যাপ করুন
              </WhatsAppCTA>
            </div>
          </div>

          {/* Response time note */}
          <div class="mt-8 rounded-card border border-cream-300 bg-cream-100 p-5">
            <p class="text-sm text-ink/70">
              <span class="font-semibold text-ink">প্রতিক্রিয়ার সময়:</span> আমরা সাধারণত ২৪ ঘন্টার মধ্যে জবাব দেই। জরুরি ক্ষেত্রে WhatsApp সবচেয়ে দ্রুত মাধ্যম।
            </p>
          </div>

          {/* What to share checklist */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              কী শেয়ার করবেন
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">কয়েকটি তথ্য আমাদের দ্রুত সাহায্য করতে সাহায্য করে</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>সাম্প্রতিক মেডিকেল রিপোর্ট ও ইমেজিং সারাংশ</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>বর্তমান রোগনির্ণয় বা ডাক্তারের সুপারিশ</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>আপনার জাতীয়তা (ভিসা পথনির্দেশনার জন্য)</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                <span>সেরা যোগাযোগ নম্বর ও WhatsApp</span>
              </li>
            </ul>
            <p class="mt-4 text-xs text-ink/50">
              WhatsApp সাধারণত আমাদের কেয়ার টিমের কাছ থেকে দ্রুত জবাব পাওয়ার সবচেয়ে দ্রুত উপায়।
            </p>
          </div>
        </div>

        {/* Right: lead form */}
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            বিনামূল্যে পরামর্শ
          </p>
          <h3 class="mt-2 font-display text-2xl font-bold text-ink">আপনার কেস সম্পর্কে জানান</h3>
          <p class="mt-2 text-sm text-ink/60">
            কয়েকটি বিবরণ শেয়ার করুন, আমরা ২৪–৪৮ ঘন্টার মধ্যে হাসপাতালের বিকল্প ও খরচের অনুমান নিয়ে জবাব দেব — অথবা <a href={whatsappInquiryHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-violet-600 hover:text-violet-700">এখনই WhatsApp করুন</a>।
          </p>
          <div class="mt-6">
            <LeadForm
              source={LEAD_SOURCE.GENERAL_CONTACT}
              treatments={treatmentOptions}
              client:load
            />
          </div>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          আরও ঘুরে দেখুন
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          কোথা থেকে শুরু করবেন নিশ্চিত নন? এই পৃষ্ঠাগুলো সাহায্য করবে।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/bn/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">কীভাবে কাজ করে</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">প্রাথমিক অনুসন্ধান থেকে ফলো-আপ পর্যন্ত ৮-ধাপের রোগীর যাত্রা।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">যাত্রা দেখুন <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/second-opinion" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">বিনামূল্যে দ্বিতীয় মতামত</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">রোগনির্ণয় নিশ্চিত নন? সিদ্ধান্ত নেওয়ার আগে সৎ দ্বিতীয় মতামত নিন।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">দ্বিতীয় মতামত নিন <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/cost-calculator" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">খরচ ক্যালকুলেটর</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">যোগাযোগ করার আগে আপনার চিকিৎসার নির্দেশক খরচের পরিসর পান।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">খরচ অনুমান করুন <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">মেডিকেল ভিসা সহায়তা</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">আপনার মেডিকেল ভিসার জন্য ডকুমেন্ট চেকলিস্ট এবং প্রক্রিয়াকরণ সময়।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">ভিসা নির্দেশনা <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/emergency-urgent-cases" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-red-600/10">
                <Icon name="alert" size={20} className="text-red-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">জরুরি কেস</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">সময়-সংবেদনশীল কার্ডিয়াক, ক্যানসার বা ট্রান্সপ্লান্ট কেসের জন্য দ্রুত-ট্র্যাক সহায়তা।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">জরুরি পথ <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/why-india-for-medical-treatment" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">কেন ভারত</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">বুঝুন কেন ভারত মেডিকেল ট্যুরিজমে বিশ্বনেতা।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">আরও পড়ুন <Icon name="arrow-right" size={14} /></span>
          </a>
        </div>
      </div>
    </section>

    {/* ── CTA card ─────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="bn"
      eyebrow="আমরা সাহায্যে আছি"
      headline="এখনই বার্তা পাঠাতে চান?"
      body="আপনার রিপোর্ট শেয়ার করুন — আমরা হাসপাতালের বিকল্প তুলনা করতে, খরচ পরিষ্কার করতে এবং ভিসা, ভ্রমণ ও পুনরুদ্ধার সহায়তা সাজাতে সাহায্য করব — সাধারণত ২৪–৪৮ ঘন্টার মধ্যে।"
      primaryCta={{ label: 'বিনামূল্যে কোট নিন', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'যোগাযোগ করুন', href: '#contact-form' }}
      tertiaryCta={{ label: 'WhatsApp করুন', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />

  <WhatsAppCTA number={whatsappNumber} variant="floating" client:load data-floating-cta />
</Layout>
