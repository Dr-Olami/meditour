---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { LeadForm } from '../../design-system/components/organisms/LeadForm';
import { WhatsAppCTA } from '../../design-system/components/organisms/WhatsAppCTA';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getTreatments } from '../../lib/content';
import { getInquiryLink } from '../../lib/whatsapp';
import { LEAD_SOURCE } from '../../lib/crm';
import { medicalWebPage, breadcrumbs, faqPage, localBusiness } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/contact`;

// খান মেডিট্যুর কোঅর্ডিনেটরদের ভাষা।
const languagesSpoken = [
  { name: 'English', native: 'English', note: 'প্রধান সমন্বয় ভাষা' },
  { name: 'Bengali', native: 'বাংলা', note: 'বাংলাদেশি রোগীদের জন্য' },
  { name: 'Hindi', native: 'हिन्दी', note: 'ভারতে অন-দ্য-গ্রাউন্ড' },
  { name: 'Hausa', native: 'Harshen Hausa', note: 'নাইজেরিয়ান / পশ্চিম আফ্রিকান রোগীদের জন্য' },
  { name: 'Swahili', native: 'Kiswahili', note: 'পূর্ব আফ্রিকান রোগীদের জন্য' },
  { name: 'Yoruba', native: 'Yorùbá', note: 'নাইজেরিয়ান রোগীদের জন্য' },
  { name: 'Igbo', native: 'Igbo', note: 'নাইজেরিয়ান রোগীদের জন্য' },
];

// যেসব দেশের রোগীদের খান মেডিট্যুর সেবা দিয়েছে।
// `slug` /countries/[slug] গাইডে লিংক করে; null = এখনো গাইড নেই।
const areasServed = [
  { name: 'Bangladesh', slug: 'bangladesh' },
  { name: 'Nigeria', slug: 'nigeria' },
  { name: 'Kenya', slug: 'kenya' },
  { name: 'Uganda', slug: 'uganda' },
  { name: 'Tanzania', slug: 'tanzania' },
  { name: 'Rwanda', slug: 'rwanda' },
  { name: 'Ethiopia', slug: 'ethiopia' },
  { name: 'Ghana', slug: 'ghana' },
  { name: 'Cameroon', slug: 'cameroon' },
  { name: 'Sudan', slug: 'sudan' },
  { name: 'Zimbabwe', slug: 'zimbabwe' },
  { name: 'Iraq', slug: 'iraq' },
  { name: 'Yemen', slug: 'yemen' },
  { name: 'Oman', slug: 'oman' },
  { name: 'United Arab Emirates', slug: 'uae' },
  { name: 'Saudi Arabia', slug: 'saudi-arabia' },
  { name: 'Kuwait', slug: 'kuwait' },
  { name: 'Qatar', slug: 'qatar' },
  { name: 'Bahrain', slug: 'bahrain' },
  { name: 'Jordan', slug: 'jordan' },
  { name: 'Egypt', slug: 'egypt' },
  { name: 'Iran', slug: 'iran' },
  { name: 'Maldives', slug: 'maldives' },
  { name: 'Sri Lanka', slug: 'sri-lanka' },
  { name: 'Nepal', slug: 'nepal' },
  { name: 'Afghanistan', slug: 'afghanistan' },
  { name: 'USA', slug: 'usa' },
  { name: 'UK', slug: 'uk' },
  { name: 'Canada', slug: 'canada' },
  { name: 'Australia', slug: 'australia' },
  { name: 'Kazakhstan', slug: 'kazakhstan' },
  { name: 'Sierra Leone', slug: null },
  { name: 'Mauritius', slug: null },
];

const officeHours = 'শনি–শুক্রবার, সকাল ৯:০০ – সন্ধ্যা ৭:০০ IST';
const conciergeHours = 'জরুরি ও ইমার্জেন্সি কেসের জন্য ২৪/৭';

const faqs = [
  {
    question: 'অনুসন্ধানে আপনারা কত দ্রুত সাড়া দেন?',
    answer:
      'সাধারণ অনুসন্ধানে আমরা সাধারণত ২৪ ঘন্টার মধ্যে জবাব দেই — WhatsApp-এ প্রায়ই আরও দ্রুত। জরুরি ক্ষেত্রে (কার্ডিয়াক, ক্যানসার, ট্রান্সপ্লান্ট, নিউরোসার্জারি) আমাদের কনসিয়ের্জ লাইন ২৪/৭ তদারকি করা হয় এবং আমরা সাধারণত ঘন্টার মধ্যে গ্রহণ নিশ্চিত করি, দিন নয়।',
  },
  {
    question: 'প্রথমে যোগাযোগ করলে কী পাঠাব?',
    answer:
      'যা কিছু আছে পাঠান: সাম্প্রতিক মেডিকেল রিপোর্ট, ইমেজিং সারাংশ (CT/MRI/echo), বর্তমান রোগনির্ণয় বা ডাক্তারের সুপারিশ, আপনার জাতীয়তা (ভিসা পথনির্দেশনার জন্য), এবং আপনার সেরা WhatsApp নম্বর। আংশিক ফাইলও আমাদের হাসপাতালের সাথে যোগাযোগ শুরু করতে সাহায্য করে যখন আপনি বাকিটা সংগ্রহ করেন।',
  },
  {
    question: 'আপনাদের কোঅর্ডিনেটররা কোন ভাষায় কথা বলেন?',
    answer:
      'English, বাংলা, Hindi, Hausa, Swahili, Yoruba, এবং Igbo। আমরা আপনার সবচেয়ে স্বচ্ছন্দ্যের ভাষায় সমন্বয় করি — সাহায্য পেতে আপনাকে English-এ কষ্ট করতে হবে না। পার্টনার হাসপাতালে Arabic, French, এবং Russian-এর জন্য হাসপাতাল দোভাষীও পাওয়া যায়।',
  },
  {
    question: 'আপনারা কোন দেশগুলোতে সেবা দেন?',
    answer:
      'আমরা Bangladesh, Nigeria, Kenya, Uganda, Tanzania, Rwanda, Ethiopia, Ghana, Sierra Leone, Iraq, Yemen, Oman, UAE, Saudi Arabia, Maldives, এবং Mauritius-এর রোগীদের সেবা দিয়েছি। আপনার দেশ তালিকায় না থাকলে আমাদের যোগাযোগ করুন — সাধারণত আমরা সাহায্য করতে পারি।',
  },
  {
    question: 'আমার মেডিকেল তথ্য কীভাবে সামলানো হয়?',
    answer:
      'আপনার মেডিকেল রিপোর্ট ও ব্যক্তিগত তথ্য শুধু আপনার কেস পর্যালোচনা করা হাসপাতাল ও বিশেষজ্ঞদের সাথে শেয়ার করা হয় — কখনো বিক্রি করা হয় না, কখনো তৃতীয় পক্ষের সাথে শেয়ার করা হয় না, এবং আপনার সম্মতি ছাড়া মার্কেটিংয়ে ব্যবহার করা হয় না। আমরা ডকুমেন্ট ট্রান্সফারের জন্য নিরাপদ চ্যানেল ব্যবহার করি এবং আপনার কেস বন্ধ হলে অনুরোধে রিপোর্ট মুছে দেই।',
  },
  {
    question: 'সমন্বয়ের জন্য কি চার্জ আছে?',
    answer:
      'না। আমাদের সমন্বয় সেবা রোগীদের জন্য বিনামূল্যে। আপনি চিকিৎসার জন্য সরাসরি হাসপাতালে পরিশোধ করেন। হাসপাতাল ম্যাচিং, রিপোর্ট পর্যালোচনা, ভিসা সমন্বয় বা ভ্রমণ পরিকল্পনার জন্য আমরা চার্জ করি না। আমাদের ভূমিকা হলো আপনার পরিবারের জন্য পথকে দ্রুত ও স্পষ্ট করা।',
  },
  {
    question: 'আপনাদের অফিস কোথায়, সময় কী?',
    answer:
      'আমাদের টিম ভারতের কর্ণাটক, ব্যাঙ্গালোরে অবস্থিত। সাধারণ সমন্বয়ের জন্য অফিস সময় শনি থেকে শুক্রবার, সকাল ৯:০০ থেকে সন্ধ্যা ৭:০০ IST। জরুরি ও ইমার্জেন্সি কেসের জন্য আমাদের কনসিয়ের্জ লাইন WhatsApp-এ ২৪/৭ পাওয়া যায়।',
  },
  {
    question: 'অভিযোগ করব কীভাবে?',
    answer:
      'আমরা অভিযোগ গুরুত্বের সাথে নিই। complaints@khanmeditour.com-এ বিষয় "Complaint" লিখে আপনার উদ্বেগের বিবরণ সহ ইমেইল করুন। একজন সিনিয়র কোঅর্ডিনেটর ২৪ ঘন্টার মধ্যে গ্রহণ নিশ্চিত করবেন ও তদন্ত করবেন। আমাদের কনসিয়ের্জ লাইনে WhatsApp-এও অভিযোগ করতে পারেন, "অভিযোগ" হিসেবে চিহ্নিত করে।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'খান মেডিট্যুর — যোগাযোগ',
    url: pageUrl,
    description:
      'ভারতে মেডিকেল ট্যুরিজমের জন্য বিনামূল্যে পরামর্শ। ব্যাঙ্গালোর-ভিত্তিক কোঅর্ডিনেটররা English, বাংলা, Hindi, Hausa, Swahili, Yoruba ও Igbo-তে কথা বলেন। ২৪ ঘন্টার মধ্যে জবাব।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'যোগাযোগ', url: `${pageUrl}/` },
  ]),
  localBusiness({
    name: t.site.name,
    url: `${siteUrl}/`,
    description:
      'ভারতের ব্যাঙ্গালোর-ভিত্তিক মেডিকেল ট্যুরিজম ফ্যাসিলিটেটর। JCI ও NABH-স্বীকৃত হাসপাতালে চিকিৎসার জন্য বিদেশি রোগীদের বিনামূল্যে সমন্বয়।',
    telephone: `+${phoneNumber}`,
    whatsapp: `+${whatsappNumber}`,
    email: contactEmail,
    address: {
      streetAddress: 'Bangalore',
      addressLocality: 'Bangalore',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
    areaServed: areasServed.map((c) => c.name),
    availableLanguage: languagesSpoken.map((l) => l.name),
    openingHours: officeHours,
    specialties: ['Medical Tourism Coordination'],
  }),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`যোগাযোগ — খান মেডিট্যুর | ভারতে মেডিকেল ট্যুরিজম বিনামূল্যে পরামর্শ`}
  description="ভারতে মেডিকেল ট্যুরিজমের জন্য বিনামূল্যে পরামর্শ। ব্যাঙ্গালোর-ভিত্তিক কোঅর্ডিনেটররা English, বাংলা, Hindi, Hausa, Swahili, Yoruba ও Igbo-তে কথা বলেন। ২৪ ঘন্টার মধ্যে জবাব।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact-form' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'যোগাযোগ' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            {t.nav.contact}
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            খান মেডিট্যুর — ভারতে মেডিকেল ট্যুরিজম যোগাযোগ
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            ভারতে চিকিৎসার জন্য বিদেশি রোগীদের বিনামূল্যে পরামর্শ। যোগাযোগ করুন <a
              href={`tel:+${phoneNumber}`}
              class="font-semibold text-ink hover:text-violet-600">কল +91 9606624861</a
            > অথবা <a
              href={whatsappInquiryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-ink hover:text-violet-600">WhatsApp +8801611892986</a
            >। আমাদের ব্যাঙ্গালোর-ভিত্তিক কোঅর্ডিনেটররা English, বাংলা, Hindi, Hausa, Swahili,
            Yoruba, এবং Igbo-তে কথা বলেন — এবং ২৪ ঘন্টার মধ্যে জবাব দেন।
          </p>
        </div>
      </div>
    </section>

    {/* ── CONTACT FORM + INFO ──────────────────────────────────────── */}
    <section id="contact-form" class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-12 lg:grid-cols-2">
        {/* Left: contact info */}
        <div data-anim="fade-in-up">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            {t.cta.formTitle}
          </h2>
          <p class="text-ink/60 mt-4 text-lg">{t.cta.subtitle}</p>

          <div class="text-ink/70 mt-8 space-y-4">
            <a
              href={`tel:+${phoneNumber}`}
              class="flex items-center gap-3 transition-colors hover:text-ink"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="phone" size={20} />
              </span>
              <span class="text-base font-medium">+{phoneNumber}</span>
            </a>
            <a
              href={`mailto:${contactEmail}`}
              class="flex items-center gap-3 transition-colors hover:text-ink"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="mail" size={20} />
              </span>
              <span class="text-base font-medium">{contactEmail}</span>
            </a>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cream-100">
                <Icon name="whatsapp" size={20} />
              </span>
              <WhatsAppCTA number={whatsappNumber} client:load> হোয়াটসঅ্যাপ করুন </WhatsAppCTA>
            </div>
          </div>

          {/* Response time note */}
          <div class="mt-8 rounded-card border border-cream-300 bg-cream-100 p-5">
            <p class="text-ink/70 text-sm">
              <span class="font-semibold text-ink">প্রতিক্রিয়ার সময়:</span> আমরা সাধারণত ২৪ ঘন্টার মধ্যে
              জবাব দেই। জরুরি ক্ষেত্রে WhatsApp সবচেয়ে দ্রুত মাধ্যম।
            </p>
          </div>

          {/* What to share checklist */}
          <div class="mt-6 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              কী শেয়ার করবেন
            </p>
            <h3 class="mt-2 font-display text-xl font-bold text-ink">
