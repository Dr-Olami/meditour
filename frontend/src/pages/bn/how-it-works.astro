---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { StepTimeline } from '../../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getInquiryLink } from '../../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();
const _whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/how-it-works`;

const journeySteps = [
  {
    title: 'প্রাথমিক অনুসন্ধান',
    description:
      'আপনি ফর্ম, WhatsApp বা ফোনে যোগাযোগ করে আপনার রোগনির্ণয়, জরুরিতা ও লক্ষ্য শেয়ার করেন। এই পর্যায়ে কোনো বাধ্যবাধকতা নেই। অনেক পরিবার শুধু একটি প্রশ্ন থেকে শুরু করে — ভারত কি তাদের জন্য সঠিক বিকল্প? আমরা বুঝি যে বিদেশে চিকিৎসার কথা ভাবলে পরিবার উদ্বিগ্ন হয়ে পড়ে — আমাদের প্রথম কাজ শোনা, কিছু বিক্রি করা নয়।',
    duration: 'একই দিন',
  },
  {
    title: 'মেডিকেল রিপোর্ট পর্যালোচনা',
    description:
      'আমরা আপনার রিপোর্ট, ইমেজিং সারাংশ ও ডাক্তারের নোট পর্যালোচনা করে ক্লিনিকাল চিত্র বুঝি। রিপোর্ট অসম্পূর্ণ হলে আমরা ঠিক জানিয়ে দেই কী কম আছে যাতে হাসপাতাল বা বিশেষজ্ঞ কার্যকরভাবে সাড়া দিতে পারে। এই পর্যায়ে আমরা কোনো হাসপাতাল বা ভ্রমণ পরিকল্পনায় বাধ্য হওয়ার আগে ভারতীয় বিশেষজ্ঞের থেকে বিনামূল্যে দ্বিতীয় মতামতের ব্যবস্থা করতে পারি।',
    duration: '১–৩ দিন',
  },
  {
    title: 'হাসপাতাল ম্যাচিং ও কোট',
    description:
      'আপনার অবস্থা, বাজেট ও পছন্দ অনুযায়ী আমরা স্বীকৃত হাসপাতাল ও ডাক্তারদের তালিকা তৈরি করে লিখিতভাবে নির্দেশক প্যাকেজ খরচ শেয়ার করি। কোটে সাধারণত হাসপাতাল ফি, রুম ক্যাটাগরি, সার্জন ফি এবং থাকার সময় অন্তর্ভুক্ত — কোনো লুকানো খরচ নয়। আমরা উৎসাহ দেই যে আপনি সিদ্ধান্ত নেওয়ার আগে jointcommissioninternational.org বা nabh.co তে প্রতিটি হাসপাতালের স্বীকৃতি স্বয়ং যাচাই করেন।',
    duration: '২–৫ দিন',
  },
  {
    title: 'মেডিকেল ভিসা ও আমন্ত্রণ',
    description:
      'আপনি একটি পথ বেছে নিলে আমরা হাসপাতালের আমন্ত্রণ পত্র ও ভিসা ডকুমেন্ট চেকলিস্ট সমন্বয় করি। যোগ্য দেশের জন্য ই-মেডিকেল ভিসা ৩–৫ কর্মদিবসে প্রক্রিয়া হয়; বাংলাদেশি ও পাকিস্তানি নাগরিকদের IVAC বা ভারতীয় হাই কমিশনে আবেদন করতে হবে। পরিবারের সদস্যদের জন্য অ্যাটেনড্যান্ট ভিসা প্রয়োজনে রোগীর ভিসার পাশাপাশি সাজানো হয়।',
    duration: '৩–১৫ দিন',
  },
  {
    title: 'ভ্রমণ ও থাকা',
    description:
      'আমরা ফ্লাইট নির্দেশনা, এয়ারপোর্ট পিকআপ, হাসপাতালের কাছে হোটেল বা সার্ভিসড অ্যাপার্টমেন্ট এবং অনুবাদক সহায়তা পরিকল্পনায় সাহায্য করি। প্রত্যাশিত ডিসচার্জ সময়ের ওপর ভিত্তি করে রোগী ও অ্যাটেনড্যান্টদের জন্য পুনরুদ্ধার-বান্ধব থাকার ব্যবস্থা করা হয়। আমরা জটিলতা কভার করে এমন মেডিকেল ট্রাভেল ইনস্যুরেন্সের পরামর্শ দেই — সাধারণ ট্রাভেল ইনস্যুরেন্স সাধারণত এটি কভার করে না।',
    duration: '১–২ সপ্তাহ',
  },
  {
    title: 'ভারতে চিকিৎসা',
    description:
      'আমাদের কোঅর্ডিনেটররা ভর্তি, সম্মতি প্রক্রিয়া, বিলিং স্বচ্ছতা এবং কেয়ার টিমের সাথে যোগাযোগ সহায়তা করেন। বিদেশের হাসপাতালে চিকিৎসা নেওয়া একা হয়ে পড়তে পারে — কিন্তু আপনি একা নন। আমাদের ব্যাঙ্গালোর টিম পুরো চিকিৎসাজুড়ে সংযোগযোগ্য থাকে এবং আপনার পরিবার ও হাসপাতালের কর্মীদের মধ্যে কোনো ভাষাগত বা সাংস্কৃতিক ব্যবধান দূর করতে সাহায্য করে।',
    duration: '২–৬ সপ্তাহ (প্রক্রিয়া-নির্ভর)',
  },
  {
    title: 'পুনরুদ্ধার ও ডিসচার্জ',
    description:
      'আমরা ডিসচার্জ নির্দেশনা, ওষুধ, ফলো-আপ অ্যাপয়েন্টমেন্ট এবং নিরাপদ বাড়ি ফেরার সমন্বয় করি। ফিজিও, খাদ্য নির্দেশনা ও ক্ষত পরিচর্যা নির্দেশনা হাসপাতাল ছাড়ার আগে স্পষ্ট করা হয়। আপনার সার্জন ভ্রমণের অনুমতি না দিলে আমরা আপনাকে উড়তে দিই না — বড় সার্জারির পর দ্রুত উড়লে ডিপ ভেইন থ্রম্বোসিস ও অন্যান্য জটিলতার ঝুঁকি বাড়ে।',
    duration: 'ডিসচার্জের পর ১০–১৪ দিন',
  },
  {
    title: 'ফেরার পর ফলো-আপ',
    description:
      'প্রয়োজনে ভারতীয় হাসপাতাল ও আপনার স্থানীয় ডাক্তারের সাথে দূরবর্তী ফলো-আপ সমন্বয় চলতে থাকে। রিপোর্ট শেয়ারিং, দ্বিতীয় মতামত এবং পুনরায় ভর্তি পরিকল্পনা দেশে ফেরার পরও চলতে পারে। ডিসচার্জের পর আপনি একা হয়ে পড়েন এই ভয় সাধারণ — কিন্তু ভারত ছেড়ে আসার পরও আমরা সংযোগযোগ্য থাকি, যতদিন আপনার পুনরুদ্ধার চলে।',
    duration: 'চলমান',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'ভারতে চিকিৎসা পরিকল্পনা — ধাপে ধাপে গাইড',
    url: pageUrl,
    description:
      'বিদেশ থেকে ভারতে চিকিৎসা পরিকল্পনার সম্পূর্ণ ৮-ধাপের গাইড। হাসপাতাল নির্বাচন, মেডিকেল ভিসা, ভ্রমণ, চিকিৎসা, পুনরুদ্ধার সময়রেখা এবং আন্তর্জাতিক রোগী ও পরিবারের জন্য ফলো-আপ সমন্বয়।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'কীভাবে কাজ করে', url: `${pageUrl}/` },
  ]),
];

const faqs = [
  {
    question: 'অনুসন্ধান থেকে চিকিৎসা শুরু পর্যন্ত পুরো প্রক্রিয়ায় কত সময় লাগে?',
    answer:
      'এটি চিকিৎসার ধরন এবং আপনার দেশের ভিসা প্রক্রিয়াকরণের সময়ের ওপর নির্ভর করে। সাধারণত প্রাথমিক অনুসন্ধান থেকে ভারতে আসা পর্যন্ত ২–৪ সপ্তাহ লাগে। ভারতে একবার পৌঁছানোর পর বেশিরভাগ সার্জিক্যাল প্রক্রিয়ার জন্য ২–৬ সপ্তাহ লাগে — প্রি-সার্জিক্যাল মূল্যায়ন, প্রক্রিয়া নিজেই এবং ডিসচার্জ-পরবর্তী পুনরুদ্ধার সহ। জরুরি ক্ষেত্রে দ্রুত ব্যবস্থা করা যায় — কার্ডিয়াক জরুরি বা উন্নত ক্যানসারের মতো পরিস্থিতিতে আমরা ৪৮ ঘন্টার মধ্যে ভর্তি সমন্বয় করেছি।',
  },
  {
    question: 'কোট পাওয়ার আগে কি কিছু দিতে হবে?',
    answer:
      'না। প্রাথমিক পরামর্শ, রিপোর্ট পর্যালোচনা, হাসপাতাল ম্যাচিং এবং নির্দেশক খরচের কোট সম্পূর্ণ বিনামূল্যে। আপনি একটি পথ বেছে নিয়ে চিকিৎসায় সম্মত হওয়ার পর সরাসরি হাসপাতালে পরিশোধ করেন। খান মেডিট্যুর হাসপাতালের বিলে কোনো মার্কআপ যোগ করে না — আপনি যে খরচ দেখেন সেটাই হাসপাতাল যা চার্জ করে।',
  },
  {
    question: 'আমার মেডিকেল রিপোর্ট অসম্পূর্ণ হলে কী হবে?',
    answer:
      'আমরা ঠিক জানিয়ে দেব কী কম আছে। অনেক পরিবার আংশিক রিপোর্ট দিয়ে শুরু করে — একটি রোগনির্ণয় চিঠি বা স্ক্যান সারাংশ প্রাথমিক মতামতের জন্য প্রায়ই যথেষ্ট। হাসপাতাল কার্যকর সাড়া দিতে আর কী কী পরীক্ষা বা ডকুমেন্ট প্রয়োজন তা আমরা নির্দেশনা দেব। আপনার যা যা রিপোর্ট আছে তার ভিত্তিতে আমরা ভারতীয় বিশেষজ্ঞের থেকে বিনামূল্যে দ্বিতীয় মতামতের ব্যবস্থাও করতে পারি।',
  },
  {
    question: 'আমার সাথে পরিবারের কেউ ভ্রমণ করতে পারবে কি?',
    answer:
      'হ্যাঁ। বেশিরভাগ দেশের নাগরিক মেডিকেল অ্যাটেনড্যান্ট ভিসায় (MX-Visa) সর্বোচ্চ ২ জন অ্যাটেনড্যান্ট আনতে পারেন। বাংলাদেশি নাগরিকদের জন্য বিশেষ দ্বিপাক্ষিক ব্যবস্থায় সর্বোচ্চ ৩ জন অনুমোদিত। হাসপাতালের কাছে পরিবারের সদস্যদের জন্য থাকার ব্যবস্থা সমন্বয়ে আমরা সাহায্য করি এবং থাকাকালীন অ্যাটেনড্যান্টদের জন্য আমাদের টিম সংযোগযোগ্য থাকে।',
  },
  {
    question: 'কীভাবে যাচাই করব যে হাসপাতালটি নিরাপদ ও স্বীকৃত?',
    answer:
      'আমরা শুধু সক্রিয় JCI বা NABH স্বীকৃতি সহ হাসপাতালই তালিকাভুক্ত করি, তবে আমরা আপনাকে স্বয়ং যাচাই করতে উৎসাহ দেই। JCI স্বীকৃতি jointcommissioninternational.org এবং NABH স্বীকৃতি nabh.co তে যাচাই করা যায়। ভারতে মাত্র ৪০টির কম হাসপাতালে JCI স্বীকৃতি আছে — এটি রোগীর নিরাপত্তার জন্য আন্তর্জাতিক স্বর্ণমান। আমরা যে প্রতিটি হাসপাতাল সুপারিশ করি তার স্বীকৃতির বিবরণ ও সার্জনের যোগ্যতা শেয়ার করি যাতে আপনি বাধ্য হওয়ার আগে নিশ্চিত করতে পারেন।',
  },
  {
    question: 'আমার কি মেডিকেল ট্রাভেল ইনস্যুরেন্স লাগবে?',
    answer:
      'হ্যাঁ, আমরা জোরালো সাজেশন করি সার্জিক্যাল জটিলতা কভার করে এমন বিশেষ মেডিকেল ট্রাভেল ইনস্যুরেন্স নিতে, সাধারণ ট্রাভেল ইনস্যুরেন্স নয়। সাধারণ ট্রাভেল পলিসি সাধারণত বিদেশে চিকিৎসা ও জটিলতা বাদ দেয়। মেডিকেল ট্রাভেল ইনস্যুরেন্স অপ্রত্যাশিত জটিলতা, বর্ধিত হাসপাতালে থাকা এবং প্রয়োজনে জরুরি ইভাকুয়েশন কভার করে। আপনার প্রক্রিয়া ও নাগরিকত্বের জন্য উপযুক্ত পলিসির পরামর্শ আমরা দিতে পারি।',
  },
  {
    question: 'চিকিৎসাকালীন কোনো জটিলতা হলে কী হবে?',
    answer:
      'স্বীকৃত হাসপাতালে জটিলতা বিরল, কিন্তু যেকোনো সার্জিক্যাল প্রক্রিয়ায় হতে পারে। জটিলতা হলে চিকিৎসাধীন হাসপাতাল ও সার্জন সরাসরি তা পরিচালনা করেন — খান মেডিট্যুর কোনো ক্লিনিকাল সিদ্ধান্ত নেয় না। আমাদের ভূমিকা হলো আপনার, হাসপাতালের এবং দেশের পরিবারের মধ্যে যোগাযোগ সমন্বয় করা, আপনাকে বুঝিয়ে বলা কী ঘটছে, এবং বিলিং স্বচ্ছ রাখা। সার্জন সুপারিশ করলে আমরা বর্ধিত থাকা বা অতিরিক্ত প্রক্রিয়ার ব্যবস্থায় সাহায্য করি।',
  },
  {
    question: 'সার্জারির পর ভারতে কত দিন থাকা উচিত যে আগে দেশে ফেরা যায়?',
    answer:
      'বেশিরভাগ সার্জন বড় সার্জারির পর উড়ার আগে ১০–১৪ দিন অপেক্ষা করতে বলেন, কারণ ডিপ ভেইন থ্রম্বোসিস ও অন্যান্য পোস্ট-অপারেটিভ জটিলতার ঝুঁকি থাকে। সঠিক সময়কাল প্রক্রিয়ার ওপর নির্ভর করে — কার্ডিয়াক সার্জারিতে বেশি সময় লাগতে পারে, ছোট প্রক্রিয়ায় আগে ফেরা যেতে পারে। আপনার সার্জন ভ্রমণের অনুমতি না দিলে আমরা আপনাকে উড়তে দিই না। এই সময়ে হাসপাতালের কাছে পুনরুদ্ধার-বান্ধব থাকার ব্যবস্থা আমরা সমন্বয় করি।',
  },
  {
    question: 'দেশে ফেরার পর কী হবে?',
    answer:
      'ভারতীয় হাসপাতাল ও আপনার স্থানীয় ডাক্তারের সাথে দূরবর্তী ফলো-আপ সমন্বয় চলতে থাকে। রিপোর্ট শেয়ারিং, দ্বিতীয় মতামত এবং প্রয়োজনে পুনরায় ভর্তি পরিকল্পনা আমরা সহজ করি। অনেক ভারতীয় হাসপাতাল এখন টেলিকনসাল্টেশন অফার করে যাতে আপনার স্থানীয় ডাক্তার ভারতীয় বিশেষজ্ঞের সাথে পরামর্শ করতে পারেন। ডিসচার্জের পর আপনি একা নন — আপনার পুনরুদ্ধার যতদিন চলে আমরা সংযোগযোগ্য থাকি।',
  },
  {
    question: 'খান মেডিট্যুর কি হাসপাতাল নাকি সহায়তাকারী?',
    answer:
      'আমরা একটি মেডিকেল ট্যুরিজম ফ্যাসিলিটেটর। আমরা ডাক্তার নিয়োগ করি না বা হাসপাতালের মালিক নই। আমাদের ভূমিকা হলো সম্পূর্ণ পথ সমন্বয় করা — সঠিক স্বীকৃত হাসপাতাল ও ডাক্তারের সাথে ম্যাচিং থেকে ভিসা, ভ্রমণ, ভর্তি সহায়তা এবং ফেরার পর ফলো-আপ পর্যন্ত। সব মেডিকেল সিদ্ধান্ত, রোগনির্ণয় ও চিকিৎসা নির্বাচিত হাসপাতাল ও চিকিৎসাধীন ডাক্তার দ্বারা প্রদান করা হয়। এই পার্থক্য গুরুত্বপূর্ণ — আমরা আপনার পক্ষে কথা বলি, কিন্তু ক্লিনিকাল যত্ন সবসময় হাসপাতালের দায়িত্ব।',
  },
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`ভারতে চিকিৎসা পরিকল্পনা | ধাপে ধাপে গাইড | ${t.site.name}`}
  description="বিদেশ থেকে ভারতে চিকিৎসা পরিকল্পনার সম্পূর্ণ ৮-ধাপের গাইড। হাসপাতাল নির্বাচন, মেডিকেল ভিসা, ভ্রমণ, চিকিৎসা, পুনরুদ্ধার সময়রেখা এবং আন্তর্জাতিক রোগী ও পরিবারের জন্য ফলো-আপ সমন্বয়।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
