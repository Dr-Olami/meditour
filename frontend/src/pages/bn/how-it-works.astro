---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { StepTimeline } from '../../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getInquiryLink } from '../../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/how-it-works`;

const journeySteps = [
  {
    title: 'প্রাথমিক অনুসন্ধান',
    description: 'আপনি ফর্ম, WhatsApp বা ফোনে যোগাযোগ করে আপনার রোগনির্ণয়, জরুরিতা ও লক্ষ্য শেয়ার করেন। এই পর্যায়ে কোনো বাধ্যবাধকতা নেই। পরিবারগুলো প্রায়ই ভারত সঠিক বিকল্প কিনা তা জিজ্ঞাসা থেকে শুরু করে।',
  },
  {
    title: 'মেডিকেল রিপোর্ট পর্যালোচনা',
    description: 'আমরা রিপোর্ট, ইমেজিং সারাংশ ও ডাক্তারের নোট পর্যালোচনা করে ক্লিনিকাল চিত্র বুঝি। রিপোর্ট অসম্পূর্ণ হলে, আমরা ঠিক জানিয়ে দেই কী কম আছে যাতে হাসপাতাল বা বিশেষজ্ঞ কার্যকরভাবে সাড়া দিতে পারে।',
  },
  {
    title: 'হাসপাতাল ম্যাচিং ও কোট',
    description: 'আমরা স্বীকৃত হাসপাতাল ও ডাক্তারদের তালিকা তৈরি করে লিখিতভাবে নির্দেশক প্যাকেজ খরচ শেয়ার করি। কোটে সাধারণত হাসপাতাল ফি, রুম ক্যাটাগরি, সার্জন ফি এবং থাকার সময় অন্তর্ভুক্ত — কোনো লুকানো খরচ নয়।',
  },
  {
    title: 'মেডিকেল ভিসা ও আমন্ত্রণ',
    description: 'আপনি একটি পথ বেছে নিলে, আমরা হাসপাতালের আমন্ত্রণ পত্র ও ভিসা ডকুমেন্ট চেকলিস্ট সমন্বয় করি। পরিবারের সদস্যদের জন্য অ্যাটেনড্যান্ট ভিসা প্রয়োজনে রোগীর ভিসার পাশাপাশি সাজানো হয়।',
  },
  {
    title: 'ভ্রমণ ও থাকা',
    description: 'আমরা ফ্লাইট নির্দেশনা, এয়ারপোর্ট পিকআপ, হাসপাতালের কাছে হোটেল ও অনুবাদক সহায়তা পরিকল্পনায় সাহায্য করি। প্রত্যাশিত ডিসচার্জ সময়ের উপর ভিত্তি করে রোগী ও অ্যাটেনড্যান্টদের জন্য পুনরুদ্ধার-বান্ধব থাকার ব্যবস্থা করা হয়।',
  },
  {
    title: 'ভারতে চিকিৎসা',
    description: 'আমাদের কোঅর্ডিনেটররা ভর্তি, সম্মতি প্রক্রিয়া, বিলিং স্বচ্ছতা এবং কেয়ার টিমের সাথে যোগাযোগ সহায়তা করেন। আপনি হাসপাতালে একা নন — আমাদের ব্যাঙ্গালোর টিম পুরো চিকিৎসাজুড়ে সংযোগযোগ্য থাকে।',
  },
  {
    title: 'পুনরুদ্ধার ও ডিসচার্জ',
    description: 'আমরা ডিসচার্জ নির্দেশনা, ওষুধ, ফলো-আপ অ্যাপয়েন্টমেন্ট এবং নিরাপদ বাড়ি ফেরার সমন্বয় করি। ফিজিও, খাদ্য নির্দেশনা ও ক্ষত পরিচর্যা নির্দেশনা হাসপাতাল ছাড়ার আগে স্পষ্ট করা হয়।',
  },
  {
    title: 'ফেরার পর ফলো-আপ',
    description: 'প্রয়োজনে ভারতীয় হাসপাতাল ও স্থানীয় ডাক্তারের সাথে দূরবর্তী ফলো-আপ সমন্বয়। রিপোর্ট শেয়ারিং, দ্বিতীয় মতামত এবং পুনরায় ভর্তি পরিকল্পনা দেশে ফেরার পরও চলতে পারে।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'ভারতে চিকিৎসা কীভাবে কাজ করে — ধাপে ধাপে',
    url: pageUrl,
    description: 'প্রাথমিক অনুসন্ধান থেকে দেশে ফেরার পর ফলো-আপ পর্যন্ত — আন্তর্জাতিক রোগী ও পরিবারের জন্য খান মেডিট্যুর যে সম্পূর্ণ পথ সমন্বয় করে।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'কীভাবে কাজ করে', url: `${pageUrl}/` },
  ]),
];

const faqs = [
  {
    question: 'অনুসন্ধান থেকে চিকিৎসা শুরু পর্যন্ত পুরো প্রক্রিয়ায় কত সময় লাগে?',
    answer: 'এটি চিকিৎসার ধরন এবং আপনার দেশের ভিসা প্রক্রিয়াকরণের সময়ের উপর নির্ভর করে। সাধারণত, প্রাথমিক অনুসন্ধান থেকে ভারতে আসা পর্যন্ত ২–৪ সপ্তাহ লাগে। জরুরি ক্ষেত্রে দ্রুত ব্যবস্থা করা যায় — জরুরি পরিস্থিতিতে আমরা ৪৮ ঘন্টার মধ্যে ভর্তি সমন্বয় করেছি।',
  },
  {
    question: 'কোট পাওয়ার আগে কি কিছু দিতে হবে?',
    answer: 'না। প্রাথমিক পরামর্শ, রিপোর্ট পর্যালোচনা এবং হাসপাতাল ম্যাচিং সম্পূর্ণ বিনামূল্যে। আপনি একটি পথ বেছে নিয়ে চিকিৎসায় সম্মত হওয়ার পর সরাসরি হাসপাতালে পরিশোধ করেন।',
  },
  {
    question: 'আমার মেডিকেল রিপোর্ট অসম্পূর্ণ হলে কী হবে?',
    answer: 'আমরা ঠিক জানিয়ে দেব কী কম আছে। অনেক পরিবার আংশিক রিপোর্ট দিয়ে শুরু করে — একটি রোগনির্ণয় চিঠি বা স্ক্যান সারাংশ প্রাথমিক মতামতের জন্য প্রায়ই যথেষ্ট। হাসপাতাল কার্যকর সাড়া দিতে আর কী কী পরীক্ষা বা ডকুমেন্ট প্রয়োজন তা আমরা নির্দেশনা দেব।',
  },
  {
    question: 'আমার সাথে পরিবারের কেউ ভ্রমণ করতে পারবে কি?',
    answer: 'হ্যাঁ। প্রয়োজনে রোগীর ভিসার পাশাপাশি অ্যাটেনড্যান্ট ভিসা সাজানো হয়। হাসপাতালের কাছে পরিবারের সদস্যদের জন্য থাকার ব্যবস্থা সমন্বয়ে আমরা সাহায্য করি এবং থাকাকালীন অ্যাটেনড্যান্টদের জন্য আমাদের টিম সংযোগযোগ্য থাকে।',
  },
  {
    question: 'দেশে ফেরার পর কী হবে?',
    answer: 'ভারতীয় হাসপাতাল ও আপনার স্থানীয় ডাক্তারের সাথে দূরবর্তী ফলো-আপ সমন্বয় চলতে থাকে। রিপোর্ট শেয়ারিং, দ্বিতীয় মতামত এবং প্রয়োজনে পুনরায় ভর্তি পরিকল্পনা আমরা সহজ করি। ডিসচার্জের পর আপনি একা নন।',
  },
  {
    question: 'খান মেডিট্যুর কি হাসপাতাল নাকি সহায়তাকারী?',
    answer: 'আমরা একটি মেডিকেল ট্যুরিজম ফ্যাসিলিটেটর। আমরা ডাক্তার নিয়োগ করি না বা হাসপাতালের মালিক নই। আমাদের ভূমিকা হলো সম্পূর্ণ পথ সমন্বয় করা — সঠিক হাসপাতাল ও ডাক্তারের সাথে ম্যাচিং থেকে ভিসা, ভ্রমণ, ভর্তি সহায়তা এবং ফেরার পর ফলো-আপ পর্যন্ত।',
  },
];
---

<Layout
  title={`কীভাবে কাজ করে | ${t.site.name}`}
  description="প্রাথমিক অনুসন্ধান থেকে দেশে ফেরার পর ফলো-আপ পর্যন্ত — আন্তর্জাতিক রোগী ও পরিবারের জন্য খান মেডিট্যুর যে সম্পূর্ণ পথ সমন্বয় করে।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'কীভাবে কাজ করে' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            রোগীর যাত্রা
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            ভারতে চিকিৎসা কীভাবে কাজ করে — ধাপে ধাপে
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            প্রাথমিক অনুসন্ধান থেকে দেশে ফেরার পর ফলো-আপ পর্যন্ত — এখানে আন্তর্জাতিক রোগী ও পরিবারের জন্য খান মেডিট্যুর যে সম্পূর্ণ পথ সমন্বয় করে।
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            দ্রুত উত্তর
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">
            ভারতে চিকিৎসা সাধারণত আটটি ধাপে অনুসরণ করে: অনুসন্ধান, মেডিকেল রিপোর্ট পর্যালোচনা, হাসপাতাল ম্যাচিং ও কোট, মেডিকেল ভিসা, ভ্রমণ পরিকল্পনা, চিকিৎসা, পুনরুদ্ধার এবং ফলো-আপ। খান মেডিট্যুর প্রতিটি ধাপ সমন্বয় করে যাতে পরিবারগুলো একা ভারতে না ঘুরে।
          </p>
        </div>
      </div>
    </section>

    {/* ── STEP TIMELINE ────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          ৮-ধাপের পথ
        </h2>
        <StepTimeline steps={journeySteps} client:load />
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          আরও ঘুরে দেখুন
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          রোগীর যাত্রা বোঝার পর পরবর্তী ধাপগুলো।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/bn/treatments" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">চিকিৎসা ব্রাউজ করুন</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">প্রতিটি চিকিৎসা বিভাগের প্রক্রিয়া, সময়কাল এবং পুনরুদ্ধার সময়রেখা দেখুন।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">সব চিকিৎসা দেখুন <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">হাসপাতাল তুলনা করুন</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">ব্যাঙ্গালোরে JCI ও NABH-স্বীকৃত হাসপাতাল — বিশেষত্ব ও সুবিধা দেখুন।</p>
