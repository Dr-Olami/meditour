    question: 'ভারতের খরচ থাইল্যান্ড, তুরস্ক বা সিঙ্গাপুরের সাথে কীভাবে তুলনা করে?',
    answer:
      'একই প্রক্রিয়ার জন্য ভারত সাধারণত থাইল্যান্ড, তুরস্ক এবং সিঙ্গাপুরের তুলনায় ৪০–৭০% সস্তা। উদাহরণস্বরূপ, ভারতে CABG খরচ $৫,০০০–$১০,০০০ বনাম থাইল্যান্ডে $১২,০০০–$২০,০০০ এবং সিঙ্গাপুরে $১৮,০০০–$৩৫,০০০। ভারতে লিভার ট্রান্সপ্লান্ট খরচ $২৫,০০০–$৪৫,০০০ বনাম সিঙ্গাপুরে $৮০,০০০–$১,২০,০০০। JCI-স্বীকৃত হাসপাতালে মান চারটি গন্তব্যেই তুলনীয় — পার্থক্য হলো খরচের ভিত্তিতে, কেয়ারের মানে নয়।',
  },
  {
    question: 'প্রধান প্রক্রিয়ার জন্য ভারতীয় হাসপাতালের সাফল্যের হার কেমন?',
    answer:
      'ভারতের JCI-স্বীকৃত কার্ডিয়াক সেন্টারগুলো করোনারি আর্টারি বাইপাস গ্রাফটিং (CABG)-এর জন্য ৯৮–৯৯% সাফল্যের হার রিপোর্ট করে, যা শীর্ষ মার্কিন ও ইউরোপীয় হাসপাতালের সাথে তুলনীয়। লিভার ট্রান্সপ্লান্ট সেন্টারগুলো ৯০–৯৫% সাফল্যের হার রিপোর্ট করে, ভারত প্রতি বছর ২,৫০০+ লিভার ট্রান্সপ্লান্ট সম্পন্ন করে। এই ফলাফলগুলো উচ্চ সার্জিক্যাল ভলিউম প্রতিফলিত করে — ভারতীয় সার্জনরা প্রায়ই এক মাসে এমন প্রক্রিয়া সম্পন্ন করেন যা কিছু পশ্চিমা হাসপাতাল এক বছরে করে — এবং পশ্চিমা প্রতিষ্ঠানের মতো অভিন্ন প্রযুক্তি ও প্রোটোকল ব্যবহার।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'মেডিকেল চিকিৎসার জন্য কেন ভারত — খরচ, মান ও সুবিধা',
    url: pageUrl,
    description:
      'আন্তর্জাতিক রোগীরা মেডিকেল চিকিৎসার জন্য কেন ভারত বেছে নেন — ৬০+ JCI-স্বীকৃত হাসপাতাল, ৬০–৯০% খরচ সাশ্রয়, ৯৮–৯৯% কার্ডিয়াক সাফল্যের হার, ১ বছরের e-Medical Visa, এবং দিনে চিকিৎসা মাস নয়।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'কেন ভারত', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`মেডিকেল চিকিৎসার জন্য কেন ভারত — খরচ, মান ও সুবিধা | ${t.site.name}`}
  description="কেন ৫,০০,০০০+ আন্তর্জাতিক রোগী প্রতি বছর মেডিকেল চিকিৎসার জন্য ভারত বেছে নেন — ৬০+ JCI-স্বীকৃত হাসপাতাল, মার্কিন যুক্তরাষ্ট্রের তুলনায় ৬০–৯০% খরচ সাশ্রয়, ৯৮–৯৯% কার্ডিয়াক সাফল্যের হার, ১ বছরের e-Medical Visa, এবং দিনে চিকিৎসা মাস নয়।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'কেন ভারত' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            কেন ভারত
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            পরিবারগুলো মেডিকেল চিকিৎসার জন্য কেন ভারত বেছে নেয়
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            বিশ্বমানের হাসপাতাল, বিশ্বব্যাপী প্রশিক্ষিত বিশেষজ্ঞ, এবং চিকিৎসা খরচ যা মানসম্মত
            কেয়ারকে সাশ্রয়ী করে — এখানে কেন ৫০+ দেশের ৫,০০,০০০+ রোগী প্রতি বছর চিকিৎসার জন্য ভারতে
            ভ্রমণ করেন।
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div
          class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">দ্রুত উত্তর</p>
          <p class="text-ink/80 mt-3 text-base leading-relaxed">
            ভারত ৬০+ JCI-স্বীকৃত হাসপাতাল, বিশ্বব্যাপী প্রশিক্ষিত সার্জন, উন্নত প্রযুক্তি এবং
            পশ্চিমা দেশের তুলনায় ৬০–৯০% কম খরচ — এবং থাইল্যান্ড, তুরস্ক বা সিঙ্গাপুরের তুলনায়
            ৪০–৭০% কম খরচ একসাথে দেয়। ২০২৫ সালে, <strong>৫,০৭,২৪৪ জন আন্তর্জাতিক রোগী</strong> চিকিৎসার
            জন্য এসেছিলেন। e-Medical Visa এখন <strong>এক বছরের বৈধতা সহ একাধিক প্রবেশে</strong> অনুমোদিত,
            ১৭৬টি দেশে উপলব্ধ। JCI-স্বীকৃত কার্ডিয়াক সেন্টারগুলো CABG-এর জন্য ৯৮–৯৯% সাফল্যের হার রিপোর্ট
            করে। অনেক পরিবারের জন্য ভারতই একমাত্র স্থান যেখানে জীবনরক্ষাকারী চিকিৎসা উচ্চমানের এবং সাশ্রয়ী
            উভয় — অপেক্ষার সময় দিন, মাস নয়।
          </p>
        </div>
      </div>
    </section>

    {/* ── ADVANTAGES GRID ──────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          রোগীরা ভারত বেছে নেওয়ার ছয়টি কারণ
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            advantages.map((item) => (
              <div
                class="rounded-card border border-cream-300 bg-cream-100 p-6"
                data-anim="fade-in-up"
              >
                <div class="flex items-start gap-3">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-violet-600">
                    <Icon name={item.icon} size={16} className="text-white" />
                  </span>
                  <div>
                    <h3 class="font-display text-lg font-bold text-ink">{item.title}</h3>
                    <p class="text-ink/70 mt-2 text-sm leading-relaxed">{item.detail}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── STATS BAND ───────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6">
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">৫.০৭ লক্ষ+</p>
            <p class="text-ink/60 mt-1 text-xs">মেডিকেল আগমন (২০২৫)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">৬০+</p>
            <p class="text-ink/60 mt-1 text-xs">JCI-স্বীকৃত হাসপাতাল</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">১৭৬</p>
            <p class="text-ink/60 mt-1 text-xs">e-Medical Visa দেশ</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">$৮.৭B</p>
            <p class="text-ink/60 mt-1 text-xs">বাজার আকার (২০২৫)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">৯৮–৯৯%</p>
            <p class="text-ink/60 mt-1 text-xs">CABG সাফল্য (JCI)</p>
          </div>
          <div class="text-center" data-anim="fade-in-up">
            <p class="font-display text-3xl font-bold text-violet-600 md:text-4xl">১ বছর</p>
            <p class="text-ink/60 mt-1 text-xs">e-Medical Visa বৈধতা</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── COST COMPARISON TABLE ────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          খরচ তুলনা: ভারত বনাম মার্কিন যুক্তরাষ্ট্র
        </h2>
        <p class="text-ink/60 mb-8 text-sm" data-anim="fade-in-up">
          নির্দেশক প্যাকেজ খরচ। প্রকৃত মূল্য হাসপাতাল, সার্জন, রুম ক্যাটাগরি এবং কেসের জটিলতা
          অনুযায়ী পরিবর্তিত হয়। আমরা আপনার ভ্রমণের আগে নিশ্চিত কোট লিখিতভাবে শেয়ার করি।
        </p>
        {/* Mobile: cards */}
        <div class="space-y-4 md:hidden" data-anim="fade-in-up">
          {
            treatmentComparisons.map((row) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <h3 class="font-display text-base font-bold text-ink">{row.procedure}</h3>
                <dl class="mt-3 space-y-2 text-sm">
                  <div class="flex items-center justify-between gap-4">
                    <dt class="text-ink/50">মার্কিন যুক্তরাষ্ট্র</dt>
                    <dd class="text-ink/80 font-medium">{row.usa}</dd>
                  </div>
                  <div class="flex items-center justify-between gap-4">
                    <dt class="text-ink/50">ভারত</dt>
                    <dd class="text-ink/80 font-medium">{row.india}</dd>
                  </div>
                  <div class="flex items-center justify-between gap-4 border-t border-cream-300 pt-2">
                    <dt class="text-ink/50">সাশ্রয়</dt>
                    <dd class="font-semibold text-violet-600">{row.savings}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>

        {/* Desktop: table */}
        <div
          class="hidden overflow-x-auto rounded-card border border-cream-300 bg-cream-100 md:block"
          data-anim="fade-in-up"
        >
          <table class="w-full text-left text-sm">
            <thead class="bg-cream-200/50 border-b border-cream-300">
              <tr>
                <th class="px-4 py-3 font-semibold text-ink">প্রক্রিয়া</th>
                <th class="px-4 py-3 font-semibold text-ink">মার্কিন যুক্তরাষ্ট্র (সাধারণ)</th>
                <th class="px-4 py-3 font-semibold text-ink">ভারত (সাধারণ)</th>
                <th class="px-4 py-3 font-semibold text-violet-600">সাশ্রয়</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-300">
              {
                treatmentComparisons.map((row) => (
                  <tr class="hover:bg-cream-200/30">
                    <td class="px-4 py-3 font-medium text-ink">{row.procedure}</td>
                    <td class="text-ink/70 px-4 py-3">{row.usa}</td>
                    <td class="text-ink/70 px-4 py-3">{row.india}</td>
                    <td class="px-4 py-3 font-semibold text-violet-600">{row.savings}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          আরও ঘুরে দেখুন
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          আত্মবিশ্বাসের সাথে ভারতে চিকিৎসা পরিকল্পনায় সাহায্যকারী গাইড ও সম্পদ।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Country guides */}
          <a
            href="/bn/countries"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="globe" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">দেশ গাইড</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              বাংলাদেশ, উপসাগর, আফ্রিকা, যুক্তরাজ্য ও যুক্তরাষ্ট্রের রোগীদের জন্য বিশেষ নির্দেশনা —
              আপনার অঞ্চলের ভিসা ধাপ, খরচ ও ভ্রমণ তথ্য।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              দেশ গাইড ব্রাউজ করুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a
            href="/bn/hospitals"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="hospital" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">ভারতের হাসপাতাল</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              ব্যাঙ্গালোরে JCI ও NABH-স্বীকৃত হাসপাতাল — Apollo, Fortis, Manipal এবং Narayana।
              বিশেষত্ব, অবকাঠামো ও রোগী সুবিধা তুলনা করুন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              হাসপাতাল তুলনা করুন
