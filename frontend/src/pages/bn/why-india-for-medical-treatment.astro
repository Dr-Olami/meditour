        </p>
        {/* Mobile: cards */}
        <div class="space-y-4 md:hidden" data-anim="fade-in-up">
          {treatmentComparisons.map((row) => (
            <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
              <h3 class="font-display text-base font-bold text-ink">{row.procedure}</h3>
              <dl class="mt-3 space-y-2 text-sm">
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-ink/50">মার্কিন যুক্তরাষ্ট্র</dt>
                  <dd class="font-medium text-ink/80">{row.usa}</dd>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-ink/50">ভারত</dt>
                  <dd class="font-medium text-ink/80">{row.india}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-t border-cream-300 pt-2">
                  <dt class="text-ink/50">সাশ্রয়</dt>
                  <dd class="font-semibold text-violet-600">{row.savings}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        {/* Desktop: table */}
        <div class="hidden overflow-x-auto rounded-card border border-cream-300 bg-cream-100 md:block" data-anim="fade-in-up">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-cream-300 bg-cream-200/50">
              <tr>
                <th class="px-4 py-3 font-semibold text-ink">প্রক্রিয়া</th>
                <th class="px-4 py-3 font-semibold text-ink">মার্কিন যুক্তরাষ্ট্র (সাধারণ)</th>
                <th class="px-4 py-3 font-semibold text-ink">ভারত (সাধারণ)</th>
                <th class="px-4 py-3 font-semibold text-violet-600">সাশ্রয়</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-300">
              {treatmentComparisons.map((row) => (
                <tr class="hover:bg-cream-200/30">
                  <td class="px-4 py-3 font-medium text-ink">{row.procedure}</td>
                  <td class="px-4 py-3 text-ink/70">{row.usa}</td>
                  <td class="px-4 py-3 text-ink/70">{row.india}</td>
                  <td class="px-4 py-3 font-semibold text-violet-600">{row.savings}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

