---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../design-system/components/organisms/Navbar';
import { Footer } from '../../../design-system/components/organisms/Footer';
import { DoctorCard } from '../../../design-system/components/organisms/DoctorCard';
import { LeadForm } from '../../../design-system/components/organisms/LeadForm';
import { FAQAccordion } from '../../../design-system/components/organisms/FAQAccordion';
import { StepTimeline } from '../../../design-system/components/organisms/StepTimeline';
import { Icon } from '../../../design-system/components/atoms/Icon';
import Breadcrumb from '../../../design-system/components/molecules/Breadcrumb.astro';
import { QuickFacts } from '../../../design-system/components/molecules/QuickFacts';
import { StepCards } from '../../../design-system/components/molecules/StepCards';
import type { QuickFactItem } from '../../../design-system/components/molecules/QuickFacts';
import type { StepCardItem } from '../../../design-system/components/molecules/StepCards';
import type { Step } from '../../../design-system/components/organisms/StepTimeline';
import { resolvePublicImage } from '../../../lib/images';
import { getTranslations } from '../../../lib/i18n';
import { getNavLinks } from '../../../lib/navigation';
import { getFooterLegalLinks } from '../../../lib/footer';
import { getTreatments, getDoctors, getHospitals, resolveRelatedDoctors, resolveHospital, resolveRelatedHospitals, entrySlug } from '../../../lib/content';
import { medicalProcedure, breadcrumbs, faqPage, medicalWebPage } from '../../../lib/schema';
import { getTreatmentInquiryLink, getDoctorInquiryLink } from '../../../lib/whatsapp';
import { generateTreatmentFaqs, mergeFaqs } from '../../../lib/faq-generator';
import { getCategoryHue } from '../../../lib/treatment-categories';
import type { Doctor } from '../../../design-system/components/organisms/DoctorCard';
import { LEAD_SOURCE } from '../../../lib/crm';
import { LeadModalTrigger } from '../../../design-system/components/organisms/LeadModalTrigger';

export async function getStaticPaths() {
  const [treatments, doctors, hospitals] = await Promise.all([
    getTreatments('bn'),
    getDoctors('bn'),
    getHospitals('bn'),
  ]);

  return treatments.map((entry) => {
    const related = resolveRelatedDoctors(entry.data.relatedDoctorSlugs, doctors).map((d) => {
      const hospital = resolveHospital(d.data.hospitalId, hospitals);
      return {
        name: d.data.name,
        specialty: d.data.specialty,
        qualification: d.data.qualification,
        experienceYears: d.data.experienceYears,
        avatar: d.data.avatar,
        href: `/bn/doctors/${entrySlug(d)}`,
        hospitalName: hospital?.name,
        hospitalHref: hospital?.href,
        whatsappHref: getDoctorInquiryLink(d.data.name) || undefined,
      };
    });
    const relatedHospitals = resolveRelatedHospitals(entry.data.relatedHospitalSlugs, hospitals).map((h) => ({
      name: h.data.name,
      city: h.data.city,
      image: h.data.image,
      href: `/bn/hospitals/${entrySlug(h)}`,
    }));
    const slug = entrySlug(entry);
    return {
      params: { slug },
      props: { treatment: entry.data, related, relatedHospitals, entry, heroImage: resolvePublicImage(`images/treatments/${slug}`) },
    };
  });
}

const t = getTranslations('bn');
const { treatment, related, relatedHospitals, entry, heroImage } = Astro.props;
const { Content } = await entry.render();

// Shared CTA backdrop — same file as the en page; falls back to ink + glow.
const ctaImage = resolvePublicImage('images/patterns/treatment-page-cta', ['jpg']);

const navLinks = getNavLinks('bn');

const title = `${treatment.name} — ${t.treatments.title} | ${t.site.name}`;
const description = treatment.description;

const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const procedureSchema = medicalProcedure({
  name: treatment.name,
  url: pageUrl,
  description: treatment.description,
  image: treatment.image,
  procedureType: treatment.category,
});

const jsonLd = [
  procedureSchema,
  medicalWebPage({
    name: treatment.name,
    url: pageUrl,
    description: treatment.description,
    image: treatment.image,
    inLanguage: 'bn',
    specialty: treatment.category,
    about: procedureSchema,
    audience: 'বাংলাদেশ থেকে বেঙ্গালুরুতে চিকিৎসা নিতে আগ্রহী রোগী',
  }),
  breadcrumbs([
    { name: t.nav.home, url: new URL('/bn', Astro.url.origin).toString() },
    { name: t.treatments.title, url: new URL('/bn/treatments', Astro.url.origin).toString() },
    { name: treatment.name, url: pageUrl },
  ]),
];

const treatmentWhatsAppHref = getTreatmentInquiryLink(treatment.name);

const relatedDoctorNames = related.map((d) => d.name);
const relatedHospitalNames = relatedHospitals.map((h) => h.name);
const autoFaqs = generateTreatmentFaqs(treatment, relatedDoctorNames, relatedHospitalNames, 'bn');
const faqs = treatment.faqs ? mergeFaqs(autoFaqs, treatment.faqs) : autoFaqs;
if (faqs.length > 0) {
  jsonLd.push(faqPage({ entries: faqs }));
}

const allTreatments = await getTreatments('bn');
const treatmentOptions = allTreatments.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

// ── Editorial data shaping ────────────────────────────────────────────
const priceValue = treatment.fromPrice && treatment.toPrice
  ? `${treatment.fromPrice} – ${treatment.toPrice}`
  : treatment.fromPrice;

const quickFacts: QuickFactItem[] = [
  ...(treatment.duration ? [{ icon: 'clock' as const, label: t.treatments.detail.durationLabel, value: treatment.duration }] : []),
  ...(treatment.hospitalStay ? [{ icon: 'building' as const, label: t.treatments.detail.stayLabel, value: treatment.hospitalStay }] : []),
  ...(treatment.recoveryTime ? [{ icon: 'heart-pulse' as const, label: t.treatments.detail.recoveryLabel, value: treatment.recoveryTime }] : []),
  ...(priceValue ? [{ icon: 'tag' as const, label: t.treatments.detail.priceLabel, value: priceValue }] : []),
];

const stepCards: StepCardItem[] = (treatment.procedures ?? []).map((procedure) => ({
  title: procedure,
}));

const hue = getCategoryHue(treatment.category);

const journeySteps: Step[] = [
  { title: t.treatments.detail.journeyStep1Title, description: t.treatments.detail.journeyStep1Desc },
  { title: t.treatments.detail.journeyStep2Title, description: t.treatments.detail.journeyStep2Desc },
  { title: t.treatments.detail.journeyStep3Title, description: t.treatments.detail.journeyStep3Desc },
  { title: t.treatments.detail.journeyStep4Title, description: t.treatments.detail.journeyStep4Desc },
];
---

<Layout title={title} description={description} locale="bn" image={treatment.image} jsonLd={jsonLd}>
  <Navbar
    brand={t.site.name}
    links={navLinks}
    cta={{ label: t.nav.cta, href: '/bn/#contact' }}
    locale="bn"
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>

  {/* ── DARK HERO — category-tinted ink band with QuickFacts ───────────
      IMAGE SLOT: /images/treatments/<slug>.webp (1600×900, <150KB) under a
      bg-ink/70 overlay. See the en template (src/pages/treatments/[slug].astro)
      for the full generation prompt. */}
  <section class="relative overflow-hidden bg-ink text-cream-100">
    {heroImage && (
      <>
        <img
          src={heroImage}
          alt=""
          class="pointer-events-none absolute inset-0 h-full w-full object-cover"
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
          data-anim="mask-reveal"
        />
        <div class="pointer-events-none absolute inset-0 bg-ink/70" aria-hidden="true" />
      </>
    )}
    <div class={`pointer-events-none absolute -right-32 -top-24 h-96 w-96 rounded-full bg-${hue.primary}/15 blur-3xl`} aria-hidden="true" />
    <div class={`pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-${hue.secondary}/10 blur-3xl`} aria-hidden="true" />

    <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
      <Breadcrumb
        items={[
          { label: t.nav.home, href: '/bn' },
          { label: t.treatments.title, href: '/bn/treatments' },
          { label: treatment.name },
        ]}
        tone="dark"
        class="mb-10"
        data-anim="fade-in-up"
      />

      <div data-anim="stagger-children">
        {treatment.category && (
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            {treatment.category}
          </span>
        )}
        <h1 class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight text-cream-100 md:text-6xl" data-anim="headline-reveal">
          {treatment.name}
        </h1>
        <div class="mt-16 h-16 md:h-20" aria-hidden="true" />

        {quickFacts.length > 0 && (
          <div class="mt-8" data-anim="fade-in-up">
            <QuickFacts facts={quickFacts} tone="dark" />
          </div>
        )}

        <div class="mt-8 flex flex-wrap gap-4">
          <LeadModalTrigger
            client:load
            label={t.doctors.detail.bookCta}
            modalTitle={t.leadModal.title}
            modalSubtitle={t.leadModal.subtitle}
            closeLabel={t.leadModal.close}
            source={LEAD_SOURCE.TREATMENT_PAGE}
            defaultTreatment={treatment.name}
            treatments={treatmentOptions}
            className="rounded-card px-6 py-3"
          />
          <a href={treatmentWhatsAppHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-card border border-cream-100/30 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:bg-cream-100 hover:text-ink" data-anim="press-button">
            <Icon name="whatsapp" size={18} />
            {t.treatments.detail.inquiryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container py-16 md:py-20">
    {/* ── MEET YOUR SPECIALISTS — related doctors above the prose ─────── */}
    {related.length > 0 && (
      <section class="mb-16" data-anim="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.detail.specialistsHeading}</h2>
        <p class="mt-2 max-w-2xl text-ink/60">{t.treatments.detail.specialistsSummary}</p>
        <div class="mt-8 grid gap-6 lg:grid-cols-2" data-anim="stagger-cards">
          {related.map((doctor: Doctor) => (
            <DoctorCard key={doctor.name} doctor={doctor} bookLabel={t.doctors.bookCta} whatsappLabel={t.doctors.detail.whatsappCta} />
          ))}
        </div>
      </section>
    )}

    {/* ── BODY + STICKY RAIL ────────────────────────────────────────────
        minmax(0,1fr) + min-w-0: lets the StepCards mobile carousel shrink
        below its max-content width instead of blowing out the page. */}
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="min-w-0">
        {stepCards.length > 0 && (
          <div class="mb-12" data-anim="fade-in-up">
            <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.detail.procedures}</h2>
            <StepCards steps={stepCards} tone="light" client:visible />
          </div>
        )}

        <div class="prose prose-ink prose-editorial mt-8 max-w-none" data-anim="scroll-reveal">
          <h2 class="mb-3 font-display text-xl font-semibold text-ink">{t.treatments.detail.description}</h2>
          <Content />
        </div>

        <div class="mt-16" data-anim="fade-in-up">
          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.detail.journeyHeading}</h2>
          <StepTimeline steps={journeySteps} />
        </div>

        {relatedHospitals.length > 0 && (
          <div class="mt-12" data-anim="fade-in-up">
            <h2 class="mb-4 font-display text-xl font-semibold text-ink">{t.treatments.detail.treatingHospitals}</h2>
            <div class="grid gap-4 sm:grid-cols-2" data-anim="stagger-cards">
              {relatedHospitals.map((h) => (
                <a href={h.href} class="flex items-center gap-4 rounded-card border border-cream-300 bg-cream-100 p-4 transition-colors hover:border-cream-300/80 hover:bg-cream-200">
                  {h.image && (
                    <img src={h.image} alt={h.name} class="h-12 w-12 rounded-card object-cover" loading="lazy" />
                  )}
                  <div>
                    <p class="text-sm font-semibold text-ink">{h.name}</p>
                    <p class="text-xs text-ink/50">{h.city}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto" data-anim="fade-in-up">
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6">
          <div class="flex items-center gap-3">
            <Icon name="whatsapp" size={20} class="text-violet-600" />
            <p class="font-display text-lg font-semibold text-ink">{t.treatments.detail.inquiryCta}</p>
          </div>
          <p class="mt-3 text-sm text-ink/60">{t.treatments.detail.consultSummary}</p>
          <div class="mt-5 flex flex-col gap-3">
            <LeadModalTrigger
              client:load
              label={t.doctors.detail.bookCta}
              modalTitle={t.leadModal.title}
              modalSubtitle={t.leadModal.subtitle}
              closeLabel={t.leadModal.close}
              source={LEAD_SOURCE.TREATMENT_PAGE}
              defaultTreatment={treatment.name}
              treatments={treatmentOptions}
              full
              className="rounded-card px-6 py-3"
            />
            <a href={treatmentWhatsAppHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-card border border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-white" data-anim="press-button">
              <Icon name="whatsapp" size={18} />
              {t.doctors.detail.whatsappCta}
            </a>
          </div>
        </div>
      </aside>
    </div>

    {faqs.length > 0 && (
      <section class="mt-16" data-anim="fade-in-up">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.detail.faqTitle}</h2>
        <FAQAccordion items={faqs} client:visible />
      </section>
    )}
  </section>

  {/* ── MID-PAGE CTA — dark band ────────────────────────────────────
      IMAGE SLOT: same as en — /images/patterns/treatment-page-cta.jpg
      (1920×800, <150KB) under a bg-ink/70 overlay. See the en template
      (src/pages/treatments/[slug].astro) for the full generation prompt.
      Auto-detected at build time. */}
  <section class="relative overflow-hidden bg-ink py-16 text-cream-100" data-anim="fade-in-up">
    {ctaImage && (
      <>
        <img src={ctaImage} alt="" class="pointer-events-none absolute inset-0 h-full w-full object-cover" aria-hidden="true" loading="lazy" />
        <div class="pointer-events-none absolute inset-0 bg-ink/70" aria-hidden="true" />
      </>
    )}
    <div class="pointer-events-none absolute -left-32 top-0 h-72 w-72 rounded-full bg-violet-600/15 blur-3xl" aria-hidden="true" />
    <div class="container relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold text-cream-100 md:text-3xl">{t.treatments.detail.consultCta.replace('{{name}}', treatment.name)}</h2>
        <p class="mt-2 max-w-xl text-cream-100/60">{t.treatments.detail.consultSummary}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <LeadModalTrigger
          client:load
          label={t.doctors.detail.bookCta}
          modalTitle={t.leadModal.title}
          modalSubtitle={t.leadModal.subtitle}
          closeLabel={t.leadModal.close}
          source={LEAD_SOURCE.TREATMENT_PAGE}
          defaultTreatment={treatment.name}
          treatments={treatmentOptions}
          className="rounded-card px-6 py-3"
        />
        <a href={treatmentWhatsAppHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-card border border-cream-100/30 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:bg-cream-100 hover:text-ink" data-anim="press-button">
          <Icon name="whatsapp" size={18} />
          {t.doctors.detail.whatsappCta}
        </a>
      </div>
    </div>
  </section>
  </main>

  {/* ── CONTACT / LEAD FORM ─────────────────────────────────────────── */}
  <section id="contact" class="bg-cream-200 py-20" data-anim="stagger-children">
    <div class="container grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{t.cta.formTitle}</h2>
        <p class="mt-4 text-lg text-ink/60">{t.cta.subtitle}</p>
      </div>
      <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8">
        <h3 class="mb-6 font-display text-xl font-semibold text-ink">{t.cta.formTitle}</h3>
        <LeadForm
          client:load
          source={LEAD_SOURCE.TREATMENT_PAGE}
          defaultTreatment={treatment.name}
          treatments={treatmentOptions}
        />
      </div>
    </div>
  </section>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks('bn')}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
