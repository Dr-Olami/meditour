            <li class="text-ink/70 flex items-start gap-2 text-sm">
              <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-violet-600" />
              <span>{t.treatments.detail.decisionFrameworkItem8}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* ── FAQ ───────────────────────────────────────────────────────────── */}
    {
      faqs.length > 0 && (
        <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
          <div class="container max-w-3xl">
            <h2 class="mb-8 text-center font-display text-2xl font-bold text-ink md:text-3xl">
              {pc.faqTitle}
            </h2>
            <FAQAccordion items={faqs} client:visible />
          </div>
        </section>
      )
    }

    {/* ── RELATED PROCEDURES ────────────────────────────────────────────── */}
    {
      relatedProcCountryLinks.length > 0 && (
        <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
          <div class="container max-w-4xl">
            <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">
              {pc.relatedProcedures.replace('{nationality}', countryData.nationality)}
            </h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {relatedProcCountryLinks.map((rp) => (
                <a
                  href={rp.href}
                  class="group rounded-card border border-cream-300 bg-white p-4 shadow-sm transition-all hover:border-violet-300 hover:shadow-md"
                >
                  <p class="text-sm font-semibold text-ink">{rp.name}</p>
                  {rp.fromPrice && <p class="text-ink/50 mt-1 text-xs">{rp.fromPrice} থেকে</p>}
                  <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-violet-600">
                    {countryData.nationality} রোগীদের জন্য
                    <Icon name="arrow-right" size={12} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* ── MEDICAL DISCLAIMER ───────────────────────────────────────────── */}
    <section class="bg-cream-100 py-8 md:py-10">
      <div class="container max-w-3xl">
        <p class="text-ink/50 text-xs leading-relaxed">
          এই পৃষ্ঠার তথ্য কেবল সাধারণ নির্দেশনার জন্য এবং এটি পেশাদার চিকিৎসা পরামর্শের বিকল্প নয়।
          চিকিৎসার উপযুক্ততা, ঝুঁকি, পুনরুদ্ধারের সময় এবং খরচ আপনার ব্যক্তিগত চিকিৎসা অবস্থার উপর
          নির্ভর করে পরিবর্তিত হতে পারে। স্বাস্থ্যসেবা সংক্রান্ত সিদ্ধান্ত নেওয়ার আগে সর্বদা একজন
          যোগ্য চিকিৎসকের সাথে পরামর্শ করুন। চূড়ান্ত মূল্য এবং চিকিৎসা পরিকল্পনার জন্য চিকিৎসা
          হাসপাতাল দ্বারা আপনার মেডিকেল রিপোর্ট পর্যালোচনা প্রয়োজন।
        </p>
      </div>
    </section>

    {/* ── CTA ───────────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="bn"
      eyebrow="আমরা সাহায্য করতে এখানে আছি"
      headline={pc.planningTreatment
        .replace('{procedure}', procedure.name)
        .replace('{country}', countryData.name)}
      body={pc.shareReports}
      primaryCta={{ label: pc.getFreeQuote, href: procedureWhatsAppHref || '#contact' }}
      secondaryCta={{ label: pc.whatsappUs, href: procedureWhatsAppHref || '#contact' }}
    />

    {/* ── CONTACT / LEAD FORM ───────────────────────────────────────────── */}
    <section id="contact" class="bg-cream-200 py-16 md:py-20">
      <div class="container max-w-xl">
        <LeadForm
          treatments={treatmentOptions}
          source={LEAD_SOURCE.PROCEDURE_COUNTRY_PAGE}
          defaultTreatment={procedure.name}
          client:visible
        />
      </div>
    </section>
  </main>

  {/* ── FLOATING CTAs ──────────────────────────────────────────────────────── */}
  <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
    {
      procedureWhatsAppHref && (
        <a
          href={procedureWhatsAppHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp চ্যাট"
          class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-green-600 text-white shadow-xl transition-all hover:scale-105 hover:bg-green-700 hover:shadow-2xl md:h-auto md:w-auto md:gap-2 md:px-5 md:py-3"
        >
          <Icon name="whatsapp" size={16} />
          <span class="hidden text-sm font-semibold md:inline">{pc.whatsappUs}</span>
        </a>
      )
    }
    <a
      href="#contact"
      class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-accent px-5 py-3 text-sm font-semibold text-white shadow-xl transition-all hover:scale-105 hover:shadow-2xl"
    >
      <Icon name="mail" size={16} />
      <span>{pc.getFreeQuote}</span>
    </a>
  </div>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks('bn')}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
    popularLinksTitle="দেশ অনুযায়ী জনপ্রিয় ট্রিটমেন্ট"
    popularLinks={popularLinks}
  />
</Layout>
