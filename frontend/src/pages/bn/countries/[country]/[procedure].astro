---
import Layout from '../../../../layouts/Layout.astro';
import { Navbar } from '../../../../design-system/components/organisms/Navbar';
import { Footer } from '../../../../design-system/components/organisms/Footer';
import { DoctorCard } from '../../../../design-system/components/organisms/DoctorCard';
import { LeadForm } from '../../../../design-system/components/organisms/LeadForm';
import { FAQAccordion } from '../../../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../../../design-system/components/atoms/Icon';
import Breadcrumb from '../../../../design-system/components/molecules/Breadcrumb.astro';
import { QuickFacts } from '../../../../design-system/components/molecules/QuickFacts';
import type { QuickFactItem } from '../../../../design-system/components/molecules/QuickFacts';
import TreatmentsCtaSection from '../../../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../../../lib/i18n';
import { getNavLinks } from '../../../../lib/navigation';
import { getFooterLegalLinks } from '../../../../lib/footer';
import {
  getProcedures,
  getDoctors,
  getHospitals,
  getTreatments,
  resolveRelatedDoctors,
  resolveHospital,
  resolveRelatedHospitals,
  resolveRelatedProcedures,
  entrySlug,
} from '../../../../lib/content';
import { medicalWebPage, faqPage, breadcrumbs } from '../../../../lib/schema';
import { getProcedureInquiryLink } from '../../../../lib/whatsapp';
import { generateProcedureCountryFaqs } from '../../../../lib/procedure-country-faq';
import { convertUsdToLocal } from '../../../../lib/currency';
import { getCategoryHue } from '../../../../lib/treatment-categories';
import type { Doctor } from '../../../../design-system/components/organisms/DoctorCard';
import { LEAD_SOURCE } from '../../../../lib/crm';
import { getBnCountryMetadata, getAllBnCountrySlugs } from '../../../../data/countries/bn';
import { getFlagUrl } from '../../../../data/countries';
import { getTopCountryProcedureLinks } from '../../../../lib/country-procedure-links';
import { generateWhyChooseIndiaBn } from '../../../../lib/why-choose-india';

export async function getStaticPaths() {
  // Reason: only Bangladesh has Bengali country metadata, so the BN route
  // generates only for Bangladesh. Other countries remain EN-only until
  // Bengali country data is added.
  // Phase 2: All 68 procedures for Bangladesh (was 10 in Phase 1).
  const bnCountrySlugs = getAllBnCountrySlugs();

  const [procedures, doctors, hospitals, treatments] = await Promise.all([
    getProcedures('bn'),
    getDoctors('bn'),
    getHospitals('bn'),
    getTreatments('bn'),
  ]);

  const paths = [];

  for (const countrySlug of bnCountrySlugs) {
    for (const procedureEntry of procedures) {
      const procedureSlug = entrySlug(procedureEntry).split('/').pop()!;

      const parentSlug = procedureEntry.data.parentTreatmentSlug;
      const related = resolveRelatedDoctors(procedureEntry.data.relatedDoctorSlugs, doctors).map(
        (d) => {
          const hospital = resolveHospital(d.data.hospitalId, hospitals);
          return {
            name: d.data.name,
            specialty: d.data.specialty,
            qualification: d.data.qualification,
            experienceYears: d.data.experienceYears,
            avatar: d.data.avatar,
            href: `/bn/doctors/${entrySlug(d)}`,
            hospitalName: hospital?.name,
            hospitalHref: hospital?.href,
            whatsappHref: '',
          };
        }
      );
      const relatedHospitals = resolveRelatedHospitals(
        procedureEntry.data.relatedHospitalSlugs,
        hospitals
      ).map((h) => ({
        name: h.data.name,
        city: h.data.city,
        image: h.data.image,
        href: `/bn/hospitals/${entrySlug(h)}`,
        accreditations: h.data.accreditations,
        description: h.data.description,
      }));
      const relatedProcedures = resolveRelatedProcedures(
        procedureEntry.data.relatedProcedureSlugs,
        procedures
      ).map((p) => ({
        name: p.data.name,
        slug: entrySlug(p).split('/').pop()!,
        parentSlug: p.data.parentTreatmentSlug,
        fromPrice: p.data.fromPrice,
      }));

      // Convert procedure slug: "heart-bypass-surgery-cabg-cost-india" → "heart-bypass-surgery-cabg-in-india"
      const pageSlug = procedureSlug.replace(/-cost-india$/, '-in-india');

      paths.push({
        params: { country: countrySlug, procedure: pageSlug },
        props: {
          countrySlug,
          procedureSlug,
          parentSlug,
          procedure: procedureEntry.data,
          parentTreatment: treatments.find((t) => entrySlug(t) === parentSlug)?.data,
          related,
          relatedHospitals,
          relatedProcedures,
          entry: procedureEntry,
        },
      });
    }
  }

  return paths;
}

const t = getTranslations('bn');
const popularLinks = getTopCountryProcedureLinks('bn', 6);
const pc = t.procedureCountry;
// Reason: Replace {nationality}, {country}, {procedureName} placeholders in
// i18n heading strings so H2s include the country and procedure name for SEO.
const ph = (s: string) =>
  s
    .replaceAll('{nationality}', countryData.nationality)
    .replaceAll('{country}', countryData.name)
    .replaceAll('{procedureName}', procedure.name);
const {
  countrySlug,
  procedureSlug,
  parentSlug,
  procedure,
  parentTreatment,
  related,
  relatedHospitals,
  relatedProcedures,
  entry: _entry,
} = Astro.props;

const countryData = getBnCountryMetadata(countrySlug);
if (!countryData) {
  throw new Error(`BN Country not found: ${countrySlug}`);
}

// ─── SEO ────────────────────────────────────────────────────────────────────
// Reason: Spec says "Keep title under 60 characters" and "Meta description
// under 160 characters." Bengali titles can also exceed 60 chars for long
// procedure names, so we apply tiered shortening similar to the EN route.
function buildBnSeoTitle(name: string, nationality: string, fromPrice: string): string {
  // Remove parentheticals: "Heart Bypass Surgery (CABG)" -> "Heart Bypass Surgery"
  const shortName = name.replace(/\s*\([^)]+\)\s*/g, '').trim();

  // Pattern 1: Full — "{name} — ভারতে {nat} রোগীদের জন্য | খরচ {price} থেকে"
  const p1 = `${shortName} — ভারতে ${nationality} রোগীদের জন্য | খরচ ${fromPrice} থেকে`;
  if (p1.length <= 60) return p1;

  // Pattern 2: Drop cost suffix
  const p2 = `${shortName} — ভারতে ${nationality} রোগীদের জন্য`;
  if (p2.length <= 60) return p2;

  // Pattern 3: Shorter — "{name} ভারতে {nat} রোগীদের জন্য"
  const p3 = `${shortName} ভারতে ${nationality} রোগীদের জন্য`;
  if (p3.length <= 60) return p3;

  // Pattern 4: Compact — "{name} ভারতে"
  const p4 = `${shortName} ভারতে`;
  if (p4.length <= 60) return p4;

  // Fallback: hard truncate
  const maxLen = 60 - ' ভারতে'.length;
  return `${shortName.slice(0, maxLen - 1).trimEnd()}\u2026 ভারতে`;
}

function buildBnSeoDescription(
  name: string,
  nationality: string,
  fromPrice: string,
  savings: string,
  hospitalStay: string
): string {
  // Pattern 1: Full
  const p1 = `${name} ভারতে ${nationality} রোগীদের জন্য। ${fromPrice ? `খরচ ${fromPrice} থেকে।` : ''} ${savings} সাশ্রয়। ${hospitalStay || ''} হাসপাতালে অবস্থান। ভিসা সহায়তা।`;
  if (p1.length <= 160) return p1;

  // Pattern 2: Drop visa support
  const p2 = `${name} ভারতে ${nationality} রোগীদের জন্য। ${fromPrice ? `খরচ ${fromPrice} থেকে।` : ''} ${savings} সাশ্রয়। ${hospitalStay || ''} হাসপাতালে অবস্থান।`;
  if (p2.length <= 160) return p2;

  // Pattern 3: Drop hospital stay
  const p3 = `${name} ভারতে ${nationality} রোগীদের জন্য। ${fromPrice ? `খরচ ${fromPrice} থেকে।` : ''} ${savings} সাশ্রয়।`;
  if (p3.length <= 160) return p3;

  // Pattern 4: Drop savings
  const p4 = `${name} ভারতে ${nationality} রোগীদের জন্য। ${fromPrice ? `খরচ ${fromPrice} থেকে।` : ''}`;
  if (p4.length <= 160) return p4;

  // Fallback: hard truncate at word boundary
  const truncated = p4.slice(0, 157);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${truncated.slice(0, lastSpace)}\u2026`;
}

const headline = `${procedure.name} — ভারতে ${countryData.nationality} রোগীদের জন্য`;
const title = buildBnSeoTitle(procedure.name, countryData.nationality, procedure.fromPrice);
const description = buildBnSeoDescription(
  procedure.name,
  countryData.nationality,
  procedure.fromPrice,
  countryData.costSavingsVsLocal,
  procedure.hospitalStay
);
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();

// ─── "Why choose India" content (data-driven, country-specific, Bengali) ───
const whyChooseContent = generateWhyChooseIndiaBn(
  procedure.name,
  procedure.fromPrice,
  procedure.toPrice,
  countryData
);

// ─── Currency conversion ───────────────────────────────────────────────────
const { exchangeRate, symbol, code } = countryData.currency;
const fromPriceLocal = procedure.fromPrice
  ? convertUsdToLocal(procedure.fromPrice, exchangeRate, symbol)
  : '';
const toPriceLocal = procedure.toPrice
  ? convertUsdToLocal(procedure.toPrice, exchangeRate, symbol)
  : '';
const priceRangeUsd =
  procedure.fromPrice && procedure.toPrice
    ? `${procedure.fromPrice}–${procedure.toPrice}`
    : procedure.fromPrice || '';
const priceRangeLocal =
  fromPriceLocal && toPriceLocal ? `${fromPriceLocal}–${toPriceLocal}` : fromPriceLocal;

// ─── FAQs ───────────────────────────────────────────────────────────────────
// Reason: the EN FAQ generator produces English questions/answers. For BN pages
// we use the procedure's own Bengali FAQs from frontmatter if available, plus
// a set of country-specific Bengali FAQs. If no Bengali FAQs exist, we fall
// back to the EN generator output (still useful for structured data, though
// ideally Bengali FAQs should be authored).
const faqs = generateProcedureCountryFaqs(procedure, countryData);

// ─── JSON-LD ────────────────────────────────────────────────────────────────
const jsonLd = [
  medicalWebPage({
    name: headline,
    url: pageUrl,
    description,
    inLanguage: 'bn',
    audience: `${countryData.nationality} রোগী যারা ভারতে ${procedure.name} খুঁজছেন`,
  }),
  faqPage({ entries: faqs }),
  breadcrumbs([
    { name: t.nav.home, url: new URL('/', Astro.url.origin).toString() },
    { name: 'দেশ', url: new URL('/bn/countries/', Astro.url.origin).toString() },
    {
      name: countryData.name,
      url: new URL(`/bn/countries/${countrySlug}`, Astro.url.origin).toString(),
    },
    { name: `${procedure.name} — ভারতে`, url: pageUrl },
  ]),
];

// ─── Quick facts ────────────────────────────────────────────────────────────
const quickFacts: QuickFactItem[] = [
  ...(procedure.duration
    ? [{ icon: 'clock' as const, label: pc.durationLabel, value: procedure.duration }]
    : []),
  ...(procedure.hospitalStay
    ? [{ icon: 'building' as const, label: pc.stayLabel, value: procedure.hospitalStay }]
    : []),
  ...(procedure.recoveryTime
    ? [{ icon: 'heart-pulse' as const, label: pc.recoveryLabel, value: procedure.recoveryTime }]
    : []),
  ...(priceRangeUsd ? [{ icon: 'tag' as const, label: pc.priceLabel, value: priceRangeUsd }] : []),
  ...(countryData.flightTime
    ? [{ icon: 'plane' as const, label: pc.flightTimeLabel, value: countryData.flightTime }]
    : []),
];

// ─── WhatsApp ───────────────────────────────────────────────────────────────
const procedureWhatsAppHref = getProcedureInquiryLink(procedure.name, {
  costRange: priceRangeUsd,
  recoveryTime: procedure.recoveryTime,
});

// ─── Treatment options for lead form ────────────────────────────────────────
const allTreatments = await getTreatments('bn');
const treatmentOptions = allTreatments.map((e) => ({
  value: e.data.name,
  label: e.data.name,
}));

// ─── Related procedure × country links ──────────────────────────────────────
const relatedProcCountryLinks = relatedProcedures.map((rp) => ({
  name: rp.name,
  href: `/bn/countries/${countrySlug}/${rp.slug.replace(/-cost-india$/, '-in-india')}`,
  fromPrice: rp.fromPrice,
}));

// ─── Hue for category styling ───────────────────────────────────────────────
const _hue = getCategoryHue(parentTreatment?.category);

// ─── Doctor type mapping ────────────────────────────────────────────────────
const doctorCards: Doctor[] = related.map((d) => ({
  name: d.name,
  specialty: d.specialty,
  qualification: d.qualification,
  experienceYears: d.experienceYears,
  avatar: d.avatar,
  href: d.href,
  hospitalName: d.hospitalName,
  hospitalHref: d.hospitalHref,
  whatsappHref: d.whatsappHref || undefined,
}));
---

<Layout
  title={title}
  description={description}
  locale="bn"
  image={procedure.image}
  jsonLd={jsonLd}
  bnAlternate={true}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks('bn')}
    cta={{ label: t.nav.cta, href: '#contact' }}
    locale="bn"
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main class="pt-20">
    {/* ── BREADCRUMB ─────────────────────────────────────────────────────── */}
    <div class="bg-white py-4">
      <div class="container">
        <Breadcrumb
          items={[
            { label: t.nav.home, href: '/bn' },
            { label: 'দেশ', href: '/bn/countries/' },
            { label: countryData.name, href: `/bn/countries/${countrySlug}` },
            { label: `${procedure.name} — ভারতে` },
          ]}
          data-anim="fade-in-up"
        />
      </div>
    </div>

    {/* ── HERO ───────────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-12 md:py-16">
      <div class="container">
        <div class="mx-auto max-w-4xl" data-anim="stagger-children">
          {/* Country badge with flag */}
          <span
            class="inline-flex items-center gap-2 rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white shadow-lg"
          >
            <img
              src={getFlagUrl(countryData.flagCode)}
              alt={`${countryData.name} flag — ${procedure.name} ভারতে ${countryData.nationality} রোগীদের জন্য`}
              class="h-4 w-5 rounded-[2px]"
              loading="eager"
            />
            {countryData.nationality} রোগীদের জন্য
          </span>

          {/* H1 */}
          <h1
            class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl lg:text-5xl"
          >
            {headline}
          </h1>

          {/* Cost badge */}
          {
            priceRangeUsd && (
              <div class="mt-6 inline-flex items-center gap-3 rounded-card border border-cream-300 bg-white px-5 py-3 shadow-sm">
                <Icon name="tag" size={20} class="text-violet-600" />
                <div>
                  <p class="text-ink/50 text-xs font-medium uppercase tracking-wide">
                    {pc.priceLabel}
                  </p>
                  <p class="text-lg font-bold text-ink">{priceRangeUsd} USD</p>
                  {priceRangeLocal && (
                    <p class="text-ink/60 text-sm">
                      ≈ {priceRangeLocal} {code}
                    </p>
                  )}
                </div>
              </div>
            )
          }

          {/* Quick facts */}
          {
            quickFacts.length > 0 && (
              <div class="mt-6">
                <QuickFacts facts={quickFacts} />
              </div>
            )
          }

          {/* CTAs */}
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={procedureWhatsAppHref || '#contact'}
              target={procedureWhatsAppHref ? '_blank' : undefined}
              rel={procedureWhatsAppHref ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 rounded-full bg-green-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-green-700 hover:shadow-md"
            >
              <Icon name="whatsapp" size={16} />
              {pc.whatsappUs}
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 rounded-full bg-gradient-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md"
            >
              <Icon name="mail" size={16} />
              {pc.getFreeQuote}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── IN SHORT ───────────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-10 md:py-12">
      <div class="container max-w-3xl">
        <div class="rounded-card border border-cream-300 bg-white p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wide text-violet-600">
            {pc.inShortLabel}
          </p>
          <p class="text-ink/80 mt-3 text-base leading-relaxed">{procedure.summary}</p>
          {
            priceRangeUsd && (
              <p class="text-ink/60 mt-4 text-sm">
                <strong class="text-ink">{pc.priceLabel}:</strong> {priceRangeUsd} USD
                {priceRangeLocal && ` (≈ ${priceRangeLocal} ${code})`}
                {' · '}
                <strong class="text-ink">{pc.savingsLabel}:</strong>{' '}
                {countryData.costSavingsVsLocal}
              </p>
            )
          }
        </div>
      </div>
    </section>

    {/* ── COST IN YOUR CURRENCY ───────────────────────────────────────────── */}
    {
      priceRangeUsd && (
        <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
          <div class="container max-w-3xl">
            <h2 class="mb-4 font-display text-2xl font-bold text-ink md:text-3xl">
              {ph(pc.costInCurrency)}
            </h2>
            <div class="rounded-card border border-cream-300 bg-white p-6 shadow-sm">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <p class="text-ink/50 text-xs font-medium uppercase tracking-wide">USD</p>
                  <p class="mt-1 text-xl font-bold text-ink">{priceRangeUsd}</p>
                </div>
                <div>
                  <p class="text-ink/50 text-xs font-medium uppercase tracking-wide">{code}</p>
                  <p class="mt-1 text-xl font-bold text-ink">{priceRangeLocal}</p>
                </div>
              </div>
              <p class="text-ink/50 mt-4 text-xs">
                বিনিময় হার: 1 USD ≈ {exchangeRate} {code}। {code}-এ দাম আনুমানিক — বর্তমান মূল্যের
                জন্য লিখিত কোটেশন চান।
              </p>
            </div>
          </div>
        </section>
      )
    }

    {/* ── COST COMPARISON ────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-4xl">
        <h2 class="mb-4 font-display text-2xl font-bold text-ink md:text-3xl">
          {ph(pc.costComparisonTitle)}
        </h2>
        <p class="text-ink/60 mb-6 text-sm">{pc.costComparisonNote}</p>
        <div class="overflow-x-auto rounded-card border border-cream-300 bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-cream-300 bg-cream-100">
                <th class="px-4 py-3 text-left font-semibold text-ink">দেশ</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">খরচ</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">vs ভারত</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-cream-300">
                <td class="px-4 py-3 text-ink">ভারত (ব্যাঙ্গালোর)</td>
                <td class="px-4 py-3 font-semibold text-ink">{priceRangeUsd}</td>
                <td class="text-ink/60 px-4 py-3">ভিত্তি</td>
              </tr>
              <tr class="border-b border-cream-300">
                <td class="px-4 py-3 text-ink">{countryData.costComparisonCountries[0]}</td>
                <td class="text-ink/70 px-4 py-3">বেশি</td>
                <td class="px-4 py-3 font-semibold text-green-600"
                  >{countryData.costSavingsVsLocal} কম</td
                >
              </tr>
              <tr>
                <td class="px-4 py-3 text-ink">USA</td>
                <td class="text-ink/70 px-4 py-3">উল্লেখযোগ্যভাবে বেশি</td>
                <td class="text-ink/60 px-4 py-3">তুলনা</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── WHO IS THIS FOR? ───────────────────────────────────────────────── */}
    {
      procedure.eligibility && procedure.eligibility.length > 0 && (
        <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
          <div class="container max-w-3xl">
            <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">
              {ph(pc.whoIsThisFor)}
            </h2>
            <ul class="space-y-3">
              {procedure.eligibility.map((item) => (
                <li class="text-ink/70 flex items-start gap-2 text-sm">
                  <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-violet-600" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* ── PROCEDURE OVERVIEW (summary + link to canonical page) ─────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-3xl">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">
          {ph(pc.procedureOverview)}
        </h2>
        <p class="text-ink/70 text-base leading-relaxed">{procedure.description}</p>
        <a
          href={`/bn/treatments/${parentSlug}/${procedureSlug}`}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-violet-600 shadow-sm transition-all hover:shadow-md"
        >
          {procedure.name} সম্পর্কে বিস্তারিত পড়ুন
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </section>

    {/* ── WHAT HAPPENS DURING ───────────────────────────────────────────── */}
    <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-3xl">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">
          {ph(pc.whatHappensDuring)}
        </h2>
