---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { CostCalculator } from '../../design-system/components/organisms/CostCalculator';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getTreatments, entrySlug } from '../../lib/content';
import { getInquiryLink } from '../../lib/whatsapp';
import { TREATMENT_COST_DATA, BREAKDOWN_LABELS_BN } from '../../lib/treatment-cost-data';
import { medicalWebPage, breadcrumbs, faqPage } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const calculatorTreatments = treatmentEntries
  .filter((entry) => entry.data.fromPrice && entry.data.toPrice)
  .map((entry) => ({
    name: entry.data.name,
    slug: entrySlug(entry),
    fromPrice: entry.data.fromPrice!,
    toPrice: entry.data.toPrice!,
    category: entry.data.category,
    duration: entry.data.duration,
    hospitalStay: entry.data.hospitalStay,
    recoveryTime: entry.data.recoveryTime,
  }));

// Translate breakdown labels to Bengali
const bnCostData = Object.fromEntries(
  Object.entries(TREATMENT_COST_DATA).map(([slug, data]) => [
    slug,
    {
      ...data,
      breakdown: data.breakdown.map((item) => ({
        ...item,
        label: BREAKDOWN_LABELS_BN[item.label] ?? item.label,
      })),
    },
  ])
);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/cost-calculator`;

const calculatorLabels = {
  selectTreatment: 'একটি চিকিৎসা নির্বাচন করুন',
  placeholder: 'খরচের পরিসর দেখতে একটি চিকিৎসা বেছে নিন',
  yourEstimate: 'আপনার অনুমান',
  planningRange: 'পরিকল্পনার পরিসর',
  verified: 'যাচাইকৃত',
  treatment: 'চিকিৎসা',
  indiaRange: 'ভারত প্যাকেজ পরিসর',
  usRange: 'সাধারণ মার্কিন পরিসর',
  indicativeSavings: 'নির্দেশক সাশ্রয়',
  category: 'বিভাগ',
  quoteWindow: 'সাধারণ কোট সময়',
  quoteWindowValue: '২৪–৪৮ ঘন্টা',
  inTheRange: 'পরিসরে সাধারণত যা থাকে',
  getExactQuote: 'আপনার কেসের জন্য সঠিক কোট নিন',
  disclaimer:
    'অনুমানগুলো নির্দেশক প্যাকেজ পরিসর। চূড়ান্ত কোট পার্টনার হাসপাতালে মেডিকেল পর্যালোচনার পর দেওয়া হয়। ফ্লাইট অন্তর্ভুক্ত নয়।',
  selectPrompt:
    'নির্দেশক খরচের পরিসর, মার্কিন তুলনা এবং প্যাকেজ বিভাজন দেখতে বাম পাশে একটি চিকিৎসা নির্বাচন করুন।',
  procedureDuration: 'প্রক্রিয়ার সময়কাল',
  hospitalStay: 'হাসপাতালে থাকা',
  recoveryTime: 'পুনরুদ্ধারের সময়',
  tripCostTitle: 'আনুমানিক মোট ভ্রমণ খরচ',
  tripCostSubtitle:
    'বাস্তবসম্মত বাজেটের জন্য এগুলো আপনার চিকিৎসা প্যাকেজে যোগ করুন। পরিসর নির্দেশক — প্রকৃত খরচ উৎস শহর, ঋতু, হোটেল স্তর এবং থাকার সময়কাল অনুযায়ী পরিবর্তিত হয়।',
  tripCostFlights: 'ফ্লাইট (রিটার্ন, ইকোনমি)',
  tripCostAccommodation: 'থাকা (প্রতি রাত)',
  tripCostTransfers: 'এয়ারপোর্ট ট্রান্সফার',
  tripCostVisa: 'ভিসা ফি',
  tripCostMeals: 'দৈনন্দিন খাবার',
  tripCostDisclaimer:
    'ফ্লাইট উৎস অনুযায়ী পরিবর্তিত (বাংলাদেশ $২০০–$৪০০, গালফ $৩০০–$৬০০, আফ্রিকা $৪০০–$৮০০, যুক্তরাজ্য/মার্কিন $৬০০–$১,২০০)। থাকার পরিসর বাজেট গেস্টহাউস থেকে আন্তর্জাতিক ব্র্যান্ড পর্যন্ত। বিস্তারিত জানতে আমাদের ভ্রমণ পৃষ্ঠা দেখুন।',
  currencyNote:
    'অনুমানগুলো মার্কিন ডলারে দেখানো হয়েছে। আমরা আপনার অনুরোধে BDT, AED, SAR, GBP, EUR, KES, NGN, বা আপনার পছন্দের মুদ্রায় কোট শেয়ার করতে পারি।',
  currencyCta: 'আমার মুদ্রায় কোট চাই',
};

const faqs = [
  {
    question: 'এই মূল্যগুলো কি নিশ্চিত?',
    answer:
      'না। এগুলো আমাদের পার্টনার হাসপাতালের সাধারণ কেসের ভিত্তিতে নির্দেশক প্যাকেজ পরিসর। আপনার চূড়ান্ত কোট নির্দিষ্ট হাসপাতাল, সার্জন, রুম ক্যাটাগরি, কেসের জটিলতা এবং যেকোনো জটিলতার উপর নির্ভর করে। আমরা আপনার রিপোর্টের মেডিকেল পর্যালোচনার পর লিখিত নিশ্চিত কোট শেয়ার করি।',
  },
  {
    question: 'প্যাকেজ মূল্যে সাধারণত কী থাকে?',
    answer:
      'সাধারণ প্যাকেজে হাসপাতাল ফি (রুম, অপারেটিং থিয়েটার, নার্সিং), সার্জন ও অ্যানেস্থেটিস্ট ফি, প্রি-অপারেটিভ ডায়াগনস্টিকস, হাসপাতালে থাকাকালীন ওষুধ এবং সাধারণ ভর্তি সহায়তা অন্তর্ভুক্ত। আন্তর্জাতিক ফ্লাইট, হাসপাতালের বাইরে থাকা, বা দেশে ডিসচার্জ-পরবর্তী ওষুধ অন্তর্ভুক্ত নয়।',
  },
  {
    question: 'কিছু চিকিৎসার জন্য পরিসর এত প্রশস্ত কেন?',
    answer:
      'পরিসর ভিন্ন কেসের জটিলতা প্রতিফলিত করে। উদাহরণস্বরূপ, কার্ডিওলজি সাধারণ অ্যাঞ্জিওগ্রামের জন্য $১,৫০০ থেকে জটিল বাইপাসের জন্য $৭,০০০ পর্যন্ত। ক্যানসার চিকিৎসা প্রাথমিক থেরাপির জন্য $৩,০০০ থেকে উন্নত মাল্টি-মোডাল চিকিৎসার জন্য $১৫,০০০+ পর্যন্ত। আপনার নির্দিষ্ট কেসের জটিলতা নির্ধারণ করে আপনি পরিসরের কোথায় পড়বেন।',
  },
  {
    question: 'ভ্রমণের আগে কি সঠিক কোট পাওয়া যায়?',
    answer:
      'হ্যাঁ। WhatsApp বা আমাদের যোগাযোগ ফর্মে আপনার মেডিকেল রিপোর্ট শেয়ার করুন। আমরা সেগুলো সংশ্লিষ্ট হাসপাতালে পর্যালোচনার জন্য পাঠাই এবং লিখিত কোট নিয়ে ফিরি — সাধারণত ২৪–৪৮ ঘন্টার মধ্যে। কোটে ঠিক কী অন্তর্ভুক্ত এবং চূড়ান্ত খরচে প্রভাব ফেলতে পারে এমন ভেরিয়েবল উল্লেখ থাকবে।',
  },
  {
    question: 'আমি কি খান মেডিট্যুরকে নাকি হাসপাতালকে পরিশোধ করব?',
    answer:
      'আপনি সরাসরি হাসপাতালকে পরিশোধ করেন। খান মেডিট্যুর সমন্বয়ের জন্য রোগীদের থেকে চার্জ করে না — হাসপাতাল ম্যাচিং, রিপোর্ট পর্যালোচনা, ভিসা সহায়তা এবং ভ্রমণ পরিকল্পনা সব বিনামূল্যে। আমাদের ভূমিকা হলো পথকে স্পষ্ট করা এবং বিকল্প তুলনায় সাহায্য করা।',
  },
  {
    question: 'আমার চিকিৎসার খরচ অনুমানের চেয়ে বেশি হলে কী হবে?',
    answer:
      'চিকিৎসাকালীন জটিলতা দেখা দিলে যা খরচ বাড়ায়, হাসপাতাল যেকোনো অতিরিক্ত প্রক্রিয়া এগিয়ে যাওয়ার আগে আপনাকে জানাবে। আমরা সংশোধিত খরচ বুঝতে এবং হাসপাতাল বিলিং টিমের সাথে যোগাযোগে সাহায্য করি। কোনো লুকানো অ্যাড-অন নেই — সবকিছু ঘটার আগে আলোচনা করা হয়।',
  },
  {
    question: 'আমি কি আমার স্থানীয় মুদ্রায় (BDT, AED, GBP, EUR) খরচ দেখতে পারি?',
    answer:
      'অনুমানগুলো সাধারণ রেফারেন্স মুদ্রা হিসেবে মার্কিন ডলারে দেখানো হয়। আমরা আপনার লিখিত কোট শেয়ার করার সময়, বিনিময় হার অনুযায়ী বাংলাদেশি টাকা (BDT), আমিরাতি দিরহাম (AED), সৌদি রিয়াল (SAR), ব্রিটিশ পাউন্ড (GBP), ইউরো (EUR), কেনিয়ান শিলিং (KES), নাইজেরিয়ান নাইরা (NGN), বা আপনার পছন্দের মুদ্রায় পরিসংখ্যান সরবরাহ করতে পারি। শুধু আমাদের জানান কোন মুদ্রা আপনি চান।',
  },
  {
    question: 'অনুমানে কি ফ্লাইট এবং থাকা অন্তর্ভুক্ত?',
    answer:
      'না। প্যাকেজ পরিসর শুধু হাসপাতালে চিকিৎসা কভার করে। আন্তর্জাতিক ফ্লাইট, হাসপাতালের বাইরে থাকা, এয়ারপোর্ট ট্রান্সফার, দৈনন্দিন খাবার, ভিসা ফি, এবং সঙ্গী ভ্রমণ খরচ আলাদা। ব্যাঙ্গালোরে ফ্লাইট, হোটেল স্তর, এয়ারপোর্ট পিকআপ এবং দৈনন্দিন লজিস্টিকসের নির্দেশক খরচের জন্য আমাদের ভ্রমণ ও থাকা পৃষ্ঠা দেখুন।',
  },
  {
    question: 'আমার চিকিৎসার জন্য ভারতে কতদিন থাকতে হবে?',
    answer:
      'থাকার সময়কাল প্রক্রিয়া এবং আপনার পুনরুদ্ধারের উপর নির্ভর করে। নির্দেশক হিসেবে: অ্যাঞ্জিওপ্লাস্টিতে সাধারণত হাসপাতালে ২–৪ দিন এবং ২–৩ দিন পুনরুদ্ধার; CABG-তে হাসপাতালে ৫–৭ দিন এবং ৭–১০ দিন পুনরুদ্ধার; হাঁটু বা হিপ প্রতিস্থাপনে হাসপাতালে ৪–৬ দিন এবং ১০–১৪ দিন পুনরুদ্ধার; লিভার ট্রান্সপ্লান্টে হাসপাতালে ২–৩ সপ্তাহ এবং ৪–৬ সপ্তাহ পুনরুদ্ধার। আপনার সার্জন আপনার কেস পর্যালোচনার পর সঠিক সময় নিশ্চিত করবেন।',
  },
  {
    question: 'ভারতের খরচ থাইল্যান্ড, তুরস্ক বা সিঙ্গাপুরের সাথে কীভাবে তুলনা করে?',
    answer:
      'JCI-স্বীকৃত হাসপাতালে একই প্রক্রিয়ার জন্য ভারত সাধারণত থাইল্যান্ড, তুরস্ক এবং সিঙ্গাপুরের তুলনায় ৪০–৭০% সস্তা। উদাহরণস্বরূপ, ভারতে CABG খরচ $৫,০০০–$১০,০০০ বনাম থাইল্যান্ডে $১২,০০০–$২০,০০০ এবং সিঙ্গাপুরে $১৮,০০০–$৩৫,০০০। স্বীকৃত হাসপাতালে মান চারটি গন্তব্যেই তুলনীয় — পার্থক্য হলো খরচের ভিত্তিতে, কেয়ারের মানে নয়। সম্পূর্ণ তুলনার জন্য আমাদের কেন ভারত পৃষ্ঠা দেখুন।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'মেডিকেল চিকিৎসা খরচ ক্যালকুলেটর — ভারত প্যাকেজ পরিসর বনাম মার্কিন যুক্তরাষ্ট্র',
    url: pageUrl,
    description:
      'ভারতে মেডিকেল চিকিৎসার খরচ অনুমান করুন। কার্ডিয়াক, অনকোলজি, অর্থোপেডিক্স, IVF, ট্রান্সপ্লান্ট এবং আরও জন্য নির্দেশক প্যাকেজ পরিসর, মার্কিন তুলনা, কী অন্তর্ভুক্ত, এবং মোট ভ্রমণ খরচের নির্দেশনা দেখতে একটি চিকিৎসা নির্বাচন করুন।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'খরচ ক্যালকুলেটর', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`চিকিৎসা খরচ ক্যালকুলেটর — ভারত বনাম মার্কিন যুক্তরাষ্ট্র | ${t.site.name}`}
  description="ভারতে মেডিকেল চিকিৎসার খরচ অনুমান করুন। কার্ডিয়াক, অনকোলজি, অর্থোপেডিক্স, IVF, ট্রান্সপ্লান্ট এবং আরও জন্য নির্দেশক প্যাকেজ পরিসর, মার্কিন তুলনা, কী অন্তর্ভুক্ত বনাম বাদ, এবং মোট ভ্রমণ খরচের নির্দেশনা দেখতে একটি চিকিৎসা নির্বাচন করুন।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'খরচ ক্যালকুলেটর' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            খরচ অনুমানকারী
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            মেডিকেল চিকিৎসা খরচ ক্যালকুলেটর
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            আমাদের পার্টনার হাসপাতালে নির্দেশক প্যাকেজ খরচের পরিসর দেখতে, মার্কিন মূল্যের সাথে তুলনা
            করতে, কী অন্তর্ভুক্ত তা যাচাই করতে, এবং আপনার মোট ভ্রমণ বাজেট পরিকল্পনা করতে একটি
            চিকিৎসা নির্বাচন করুন। ২৪–৪৮ ঘন্টার মধ্যে লিখিত ব্যক্তিগত কোট পান।
          </p>
        </div>
      </div>
    </section>

    {/* ── CALCULATOR ───────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <div
          class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
          data-anim="fade-in-up"
        >
          <CostCalculator
            treatments={calculatorTreatments}
            costData={bnCostData}
            labels={calculatorLabels}
            client:load
          />
        </div>
      </div>
    </section>

    {/* ── WHAT'S INCLUDED VS EXCLUDED ──────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          প্যাকেজে কী অন্তর্ভুক্ত
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          বেশিরভাগ পার্টনার হাসপাতালের প্যাকেজ নিচের আইটেমগুলো কভার করে। আপনার লিখিত কোটে আপনার
          নির্দিষ্ট কেসের জন্য ঠিক কী অন্তর্ভুক্ত তা তালিকাভুক্ত থাকবে। অন্তর্ভুক্ত নয় হিসেবে
          চিহ্নিত আইটেমগুলো আলাদাভাবে বিল করা হয় — আমরা সেগুলোর পরিকল্পনায় সাহায্য করি।
        </p>
        <div class="grid gap-6 md:grid-cols-2">
          {/* Included */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-4 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-green-100"
                aria-hidden="true"
              >
                <Icon name="check" size={16} className="text-green-700" />
              </span>
              <h3 class="font-display text-lg font-bold text-ink">সাধারণত অন্তর্ভুক্ত</h3>
            </div>
            <ul class="text-ink/80 space-y-2.5 text-sm">
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                হাসপাতাল রুম, অপারেটিং থিয়েটার, এবং নার্সিং কেয়ার
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                সার্জন ও অ্যানেসথেটিস্ট ফি
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                প্রি-অপারেটিভ ডায়াগনস্টিকস (রক্ত পরীক্ষা, ইমেজিং, ECG)
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                হাসপাতালে থাকাকালীন ওষুধ ও কনসিউমেবল
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                প্রয়োজনে ইমপ্লান্ট (যেমন জয়েন্ট প্রতিস্থাপন, স্টেন্ট)
              </li>
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} className="mt-1 flex-shrink-0 text-green-600" />
                সাধারণ ভর্তি সহায়তা এবং হাসপাতাল ডিসচার্জ সারসংক্ষেপ
              </li>
            </ul>
          </div>

          {/* Not included */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-4 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-lg font-bold text-ink">অন্তর্ভুক্ত নয়</h3>
            </div>
            <ul class="text-ink/80 space-y-2.5 text-sm">
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                ভারতে আসার এবং ফেরার আন্তর্জাতিক ফ্লাইট
              </li>
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                হাসপাতালের বাইরে থাকা (গেস্টহাউস, হোটেল, অ্যাপার্টমেন্ট)
              </li>
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                এয়ারপোর্ট পিকআপ এবং স্থানীয় ট্রান্সফার
              </li>
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                ভিসা ফি এবং মেডিকেল অ্যাটেনড্যান্ট ভিসা খরচ
              </li>
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                দেশে নিয়ে যাওয়ার জন্য ডিসচার্জ-পরবর্তী ওষুধ
              </li>
              <li class="flex items-start gap-2">
                <Icon name="close" size={14} className="mt-1 flex-shrink-0 text-rose-600" />
                সঙ্গীর ভ্রমণ, খাবার, এবং থাকার খরচ
              </li>
            </ul>
            <a
              href="/bn/travel-accommodation-assistance"
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
            >
              ভ্রমণ ও থাকার খরচ দেখুন
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          আরও ঘুরে দেখুন
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          খরচের পরিসর দেখেছেন — এখন বেশিরভাগ পরিবার যে পরবর্তী ধাপগুলো নেয়।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Treatments */}
          <a
            href="/bn/treatments"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="stethoscope" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">চিকিৎসা ব্রাউজ করুন</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              প্রতিটি চিকিৎসা বিভাগের প্রক্রিয়া, সময়কাল, হাসপাতালে থাকা এবং পুনরুদ্ধার সময়রেখা
              দেখুন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              সব চিকিৎসা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a
            href="/bn/hospitals"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="hospital" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">হাসপাতাল তুলনা করুন</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              ব্যাঙ্গালোরে JCI ও NABH-স্বীকৃত হাসপাতাল — Apollo, Fortis, Manipal এবং Narayana।
              বিশেষত্ব ও সুবিধা দেখুন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              হাসপাতাল তুলনা করুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Why India */}
          <a
            href="/bn/why-india-for-medical-treatment"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="globe" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">ভারত কেন সস্তা</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              বুঝুন কেন ভারতে চিকিৎসা মার্কিন যুক্তরাষ্ট্র বা যুক্তরাজ্যের তুলনায় ৬০–৯০% কম — মান
              বা প্রযুক্তিতে আপস ছাড়াই।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              তুলনা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* How it works */}
          <a
            href="/bn/how-it-works"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="list" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">কীভাবে কাজ করে</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              প্রাথমিক অনুসন্ধান থেকে ফলো-আপ পর্যন্ত ৮-ধাপের পথ — যাতে খরচের অনুমান দেখার পর কী হয়
              জানেন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              সম্পূর্ণ যাত্রা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Medical visa */}
          <a
            href="/bn/medical-visa-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="document" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">মেডিকেল ভিসা সহায়তা</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              ডকুমেন্ট চেকলিস্ট, প্রক্রিয়াকরণ সময় এবং অ্যাটেনড্যান্ট ভিসা — ভারত ভ্রমণ পরিকল্পনার
              জন্য যা প্রয়োজন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              ভিসা নির্দেশনা
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Country guides */}
          <a
            href="/bn/countries"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="globe" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">দেশ গাইড</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              বাংলাদেশ, উপসাগর, আফ্রিকা, যুক্তরাজ্য ও যুক্তরাষ্ট্রের রোগীদের জন্য বিশেষ নির্দেশনা —
              ভিসা ধাপ ও ভ্রমণ তথ্য সহ।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              দেশ গাইড ব্রাউজ করুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2
          class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          সাধারণ জিজ্ঞাসা
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="bn"
      variant="light"
      eyebrow="শুরু করতে প্রস্তুত?"
      headline="ব্যক্তিগত খরচের অনুমান নিন"
      body="আপনার রিপোর্ট শেয়ার করুন — আমরা সেগুলো সঠিক হাসপাতালে লিখিত কোটের জন্য পাঠাব — সাধারণত ২৪–৪৮ ঘন্টার মধ্যে। কোনো বাধ্যবাধকতা নেই।"
      primaryCta={{ label: 'বিনামূল্যে দ্বিতীয় মতামত নিন', href: '/bn/second-opinion' }}
      secondaryCta={{ label: 'বিনামূল্যে কোট নিন', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="bn"
      eyebrow="আমরা সাহায্যে আছি"
