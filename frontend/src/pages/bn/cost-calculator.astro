---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { CostCalculator } from '../../design-system/components/organisms/CostCalculator';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getTreatments, entrySlug } from '../../lib/content';
import { getInquiryLink } from '../../lib/whatsapp';
import { TREATMENT_COST_DATA, BREAKDOWN_LABELS_BN } from '../../lib/treatment-cost-data';
import { medicalWebPage, breadcrumbs } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const calculatorTreatments = treatmentEntries
  .filter((entry) => entry.data.fromPrice && entry.data.toPrice)
  .map((entry) => ({
    name: entry.data.name,
    slug: entrySlug(entry),
    fromPrice: entry.data.fromPrice!,
    toPrice: entry.data.toPrice!,
    category: entry.data.category,
    duration: entry.data.duration,
    hospitalStay: entry.data.hospitalStay,
    recoveryTime: entry.data.recoveryTime,
  }));

// Translate breakdown labels to Bengali
const bnCostData = Object.fromEntries(
  Object.entries(TREATMENT_COST_DATA).map(([slug, data]) => [
    slug,
    {
      ...data,
      breakdown: data.breakdown.map((item) => ({
        ...item,
        label: BREAKDOWN_LABELS_BN[item.label] ?? item.label,
      })),
    },
  ])
);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/cost-calculator`;

const calculatorLabels = {
  selectTreatment: 'একটি চিকিৎসা নির্বাচন করুন',
  placeholder: 'খরচের পরিসর দেখতে একটি চিকিৎসা বেছে নিন',
  yourEstimate: 'আপনার অনুমান',
  planningRange: 'পরিকল্পনার পরিসর',
  verified: 'যাচাইকৃত',
  treatment: 'চিকিৎসা',
  indiaRange: 'ভারত প্যাকেজ পরিসর',
  usRange: 'সাধারণ মার্কিন পরিসর',
  indicativeSavings: 'নির্দেশক সাশ্রয়',
  category: 'বিভাগ',
  quoteWindow: 'সাধারণ কোট সময়',
  quoteWindowValue: '২৪–৪৮ ঘন্টা',
  inTheRange: 'পরিসরে সাধারণত যা থাকে',
  getExactQuote: 'আপনার কেসের জন্য সঠিক কোট নিন',
  disclaimer: 'অনুমানগুলো নির্দেশক প্যাকেজ পরিসর। চূড়ান্ত কোট পার্টনার হাসপাতালে মেডিকেল পর্যালোচনার পর দেওয়া হয়। ফ্লাইট অন্তর্ভুক্ত নয়।',
  selectPrompt: 'নির্দেশক খরচের পরিসর, মার্কিন তুলনা এবং প্যাকেজ বিভাজন দেখতে বাম পাশে একটি চিকিৎসা নির্বাচন করুন।',
};

const faqs = [
  {
    question: 'এই মূল্যগুলো কি নিশ্চিত?',
    answer: 'না। এগুলো আমাদের পার্টনার হাসপাতালের সাধারণ কেসের ভিত্তিতে নির্দেশক প্যাকেজ পরিসর। আপনার চূড়ান্ত কোট নির্দিষ্ট হাসপাতাল, সার্জন, রুম ক্যাটাগরি, কেসের জটিলতা এবং যেকোনো জটিলতার উপর নির্ভর করে। আমরা আপনার রিপোর্টের মেডিকেল পর্যালোচনার পর লিখিত নিশ্চিত কোট শেয়ার করি।',
  },
  {
    question: 'প্যাকেজ মূল্যে সাধারণত কী থাকে?',
    answer: 'সাধারণ প্যাকেজে হাসপাতাল ফি (রুম, অপারেটিং থিয়েটার, নার্সিং), সার্জন ও অ্যানেস্থেটিস্ট ফি, প্রি-অপারেটিভ ডায়াগনস্টিকস, হাসপাতালে থাকাকালীন ওষুধ এবং সাধারণ ভর্তি সহায়তা অন্তর্ভুক্ত। আন্তর্জাতিক ফ্লাইট, হাসপাতালের বাইরে থাকা, বা দেশে ডিসচার্জ-পরবর্তী ওষুধ অন্তর্ভুক্ত নয়।',
  },
  {
    question: 'কিছু চিকিৎসার জন্য পরিসর এত প্রশস্ত কেন?',
    answer: 'পরিসর ভিন্ন কেসের জটিলতা প্রতিফলিত করে। উদাহরণস্বরূপ, কার্ডিওলজি সাধারণ অ্যাঞ্জিওগ্রামের জন্য $১,৫০০ থেকে জটিল বাইপাসের জন্য $৭,০০০ পর্যন্ত। ক্যানসার চিকিৎসা প্রাথমিক থেরাপির জন্য $৩,০০০ থেকে উন্নত মাল্টি-মোডাল চিকিৎসার জন্য $১৫,০০০+ পর্যন্ত। আপনার নির্দিষ্ট কেসের জটিলতা নির্ধারণ করে আপনি পরিসরের কোথায় পড়বেন।',
  },
  {
    question: 'ভ্রমণের আগে কি সঠিক কোট পাওয়া যায়?',
    answer: 'হ্যাঁ। WhatsApp বা আমাদের যোগাযোগ ফর্মে আপনার মেডিকেল রিপোর্ট শেয়ার করুন। আমরা সেগুলো সংশ্লিষ্ট হাসপাতালে পর্যালোচনার জন্য পাঠাই এবং লিখিত কোট নিয়ে ফিরি — সাধারণত ২৪–৪৮ ঘন্টার মধ্যে। কোটে ঠিক কী অন্তর্ভুক্ত এবং চূড়ান্ত খরচে প্রভাব ফেলতে পারে এমন ভেরিয়েবল উল্লেখ থাকবে।',
  },
  {
    question: 'আমি কি খান মেডিট্যুরকে নাকি হাসপাতালকে পরিশোধ করব?',
    answer: 'আপনি সরাসরি হাসপাতালকে পরিশোধ করেন। খান মেডিট্যুর সমন্বয়ের জন্য রোগীদের থেকে চার্জ করে না — হাসপাতাল ম্যাচিং, রিপোর্ট পর্যালোচনা, ভিসা সহায়তা এবং ভ্রমণ পরিকল্পনা সব বিনামূল্যে। আমাদের ভূমিকা হলো পথকে স্পষ্ট করা এবং বিকল্প তুলনায় সাহায্য করা।',
  },
  {
    question: 'আমার চিকিৎসার খরচ অনুমানের চেয়ে বেশি হলে কী হবে?',
    answer: 'চিকিৎসাকালীন জটিলতা দেখা দিলে যা খরচ বাড়ায়, হাসপাতাল যেকোনো অতিরিক্ত প্রক্রিয়া এগিয়ে যাওয়ার আগে আপনাকে জানাবে। আমরা সংশোধিত খরচ বুঝতে এবং হাসপাতাল বিলিং টিমের সাথে যোগাযোগে সাহায্য করি। কোনো লুকানো অ্যাড-অন নেই — সবকিছু ঘটার আগে আলোচনা করা হয়।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'মেডিকেল চিকিৎসা খরচ ক্যালকুলেটর',
    url: pageUrl,
    description: 'ভারতে মেডিকেল চিকিৎসার খরচ অনুমান করুন। কার্ডিয়াক, অনকোলজি, অর্থোপেডিক্স, IVF, ট্রান্সপ্লান্ট এবং আরও জন্য নির্দেশক প্যাকেজ পরিসর দেখতে একটি চিকিৎসা নির্বাচন করুন।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'খরচ ক্যালকুলেটর', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`খরচ ক্যালকুলেটর | ${t.site.name}`}
  description="ভারতে মেডিকেল চিকিৎসার খরচ অনুমান করুন। কার্ডিয়াক, অনকোলজি, অর্থোপেডিক্স, IVF, ট্রান্সপ্লান্ট এবং আরও জন্য নির্দেশক প্যাকেজ পরিসর দেখতে একটি চিকিৎসা নির্বাচন করুন।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'খরচ ক্যালকুলেটর' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            খরচ অনুমানকারী
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            মেডিকেল চিকিৎসা খরচ ক্যালকুলেটর
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            আমাদের পার্টনার হাসপাতালে নির্দেশক প্যাকেজ খরচের পরিসর দেখতে একটি চিকিৎসা নির্বাচন করুন। ২৪–৪৮ ঘন্টার মধ্যে লিখিত ব্যক্তিগত কোট পান।
          </p>
        </div>
      </div>
    </section>

    {/* ── CALCULATOR ───────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <CostCalculator
            treatments={calculatorTreatments}
            costData={bnCostData}
            labels={calculatorLabels}
            client:load
          />
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          আরও ঘুরে দেখুন
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          খরচের পরিসর দেখেছেন — এখন বেশিরভাগ পরিবার যে পরবর্তী ধাপগুলো নেয়।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {/* Treatments */}
          <a href="/bn/treatments" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">চিকিৎসা ব্রাউজ করুন</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              প্রতিটি চিকিৎসা বিভাগের প্রক্রিয়া, সময়কাল, হাসপাতালে থাকা এবং পুনরুদ্ধার সময়রেখা দেখুন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              সব চিকিৎসা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Hospitals */}
          <a href="/bn/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">হাসপাতাল তুলনা করুন</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              ব্যাঙ্গালোরে JCI ও NABH-স্বীকৃত হাসপাতাল — Apollo, Fortis, Manipal এবং Narayana। বিশেষত্ব ও সুবিধা দেখুন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              হাসপাতাল তুলনা করুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Why India */}
          <a href="/bn/why-india-for-medical-treatment" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">ভারত কেন সস্তা</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              বুঝুন কেন ভারতে চিকিৎসা মার্কিন যুক্তরাষ্ট্র বা যুক্তরাজ্যের তুলনায় ৬০–৯০% কম — মান বা প্রযুক্তিতে আপস ছাড়াই।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              তুলনা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* How it works */}
          <a href="/bn/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">কীভাবে কাজ করে</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              প্রাথমিক অনুসন্ধান থেকে ফলো-আপ পর্যন্ত ৮-ধাপের পথ — যাতে খরচের অনুমান দেখার পর কী হয় জানেন।
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              সম্পূর্ণ যাত্রা দেখুন
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          {/* Medical visa */}
          <a href="/bn/medical-visa-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="document" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">মেডিকেল ভিসা সহায়তা</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
