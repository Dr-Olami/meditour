import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { StepTimeline } from '../../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getInquiryLink } from '../../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/medical-visa-assistance`;

const visaSteps = [
  {
    title: 'হাসপাতাল আমন্ত্রণ পত্র',
    description:
      'চিকিৎসার পথ ঠিক হলে হাসপাতাল একটি আনুষ্ঠানিক আমন্ত্রণ পত্র জারি করে। এই পত্রে আপনার চিকিৎসা, তারিখ ও রোগীর বিবরণ থাকে — এটিই ভিসা আবেদনের সবচেয়ে গুরুত্বপূর্ণ কাগজ। আমন্ত্রণ পত্রের জন্য আপনাকে রোগনির্ণয়, সাম্প্রতিক মেডিকেল রিপোর্ট এবং পাসপোর্টের বিবরণ হাসপাতালের সাথে শেয়ার করতে হবে।',
    duration: '১–২ দিন',
  },
  {
    title: 'ডকুমেন্ট চেকলিস্ট',
    description:
      'আমরা আপনার দেশ অনুযায়ী একটি চেকলিস্ট দেই: পাসপোর্ট (৬+ মাস বৈধতা), পাসপোর্ট-সাইজ ছবি, আমন্ত্রণ পত্র, মেডিকেল রিপোর্ট, স্থানীয় ডাক্তারের রেফার লেটার, আর্থিক প্রমাণ এবং পূরণ করা ভিসা আবেদন ফর্ম। বাংলাদেশি ও পাকিস্তানি নাগরিকদের জন্য স্থানীয় ডাক্তারের রেফার লেটার বাধ্যতামূলক — এটি না থাকলে আবেদন বাতিল হওয়ার সবচেয়ে সাধারণ কারণ।',
    duration: 'একই দিন',
  },
  {
    title: 'ভিসা আবেদন জমা',
    description:
      'আপনার দেশের ওপর নির্ভর করে আবেদন অনলাইনে (ই-মেডিকেল ভিসা) অথবা ভারতীয় দূতাবাস/ভিসা কেন্দ্রে জমা দিতে হবে। ১৭৬টি দেশের নাগরিক indianvisaonline.gov.in এ অনলাইনে আবেদন করতে পারেন। বাংলাদেশ ও পাকিস্তানের নাগরিকদের IVAC বা ভারতীয় হাই কমিশনে সরাসরি জমা দিতে হবে — তাদের জন্য ই-ভিসা পোর্টাল উপলব্ধ নয়।',
    duration: '১ দিন',
  },
  {
    title: 'ভিসা প্রক্রিয়াকরণ',
    description:
