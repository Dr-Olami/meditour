];

const faqs = [
  {
    question: 'ই-মেডিকেল ভিসা আর নিয়মিত মেডিকেল ভিসার মধ্যে পার্থক্য কী?',
    answer:
      'ই-মেডিকেল ভিসা সম্পূর্ণ অনলাইনে indianvisaonline.gov.in এ আবেদন করা যায়, ৩–৫ কর্মদিবসে প্রক্রিয়া হয়, আগমনের তারিখ থেকে ৬০ দিন বৈধ থাকে এবং তিনবার প্রবেশের সুবিধা দেয় — ১৭৬টি দেশের নাগরিক এটি ব্যবহার করতে পারেন। নিয়মিত (পেপার) মেডিকেল ভিসা ভারতীয় দূতাবাস বা ভিসা কেন্দ্রে সরাসরি আবেদন করতে হয়, ৫–১৫ কর্মদিবস লাগে, এক বছর পর্যন্ত বৈধ হতে পারে এবং একাধিক প্রবেশের সুবিধা দেয় — সব দেশের নাগরিক এটি ব্যবহার করতে পারেন। আপনার দেশ ই-মেডিকেল ভিসার যোগ্য এবং চিকিৎসা ৬০ দিনের কম হলে ই-ভিসা সাধারণত দ্রুততর পথ।',
  },
  {
    question: 'কোন কোন দেশের নাগরিক ই-মেডিকেল ভিসার যোগ্য?',
    answer:
      '১৭৬টি দেশের নাগরিক ই-মেডিকেল ভিসার জন্য যোগ্য, যার মধ্যে যুক্তরাষ্ট্র, যুক্তরাজ্য, কানাডা, অস্ট্রেলিয়া, সংযুক্ত আরব আমিরাত, সৌদি আরব, নাইজেরিয়া, কেনিয়া, ইথিওপিয়া এবং ইউরোপ ও এশিয়ার বেশিরভাগ দেশ অন্তর্ভুক্ত। উল্লেখযোগ্য ব্যতিক্রম হলো বাংলাদেশ ও পাকিস্তান — এই দেশের নাগরিকদের ই-ভিসা পোর্টাল ব্যবহার করতে পারেন না, তাদের IVAC বা ভারতীয় হাই কমিশনের মাধ্যমে নিয়মিত মেডিকেল ভিসার আবেদন করতে হবে। আমরা আপনার পাসপোর্ট অনুযায়ী যোগ্যতা ও সঠিক আবেদনের পথ নিশ্চিত করি।',
