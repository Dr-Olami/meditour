---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { StepTimeline } from '../../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getInquiryLink } from '../../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../../lib/schema';

const locale = 'bn';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/bn/medical-visa-assistance`;

const visaSteps = [
  {
    title: 'হাসপাতাল আমন্ত্রণ পত্র',
    description: 'আপনি চিকিৎসার পথ বেছে নিলে, হাসপাতাল একটি আনুষ্ঠানিক আমন্ত্রণ পত্র জারি করে। এই পত্র আপনার চিকিৎসা, তারিখ ও রোগীর বিবরণ নিশ্চিত করে — এটি আপনার ভিসা আবেদনের মূল ডকুমেন্ট।',
    duration: '১–২ দিন',
  },
  {
    title: 'ডকুমেন্ট চেকলিস্ট',
    description: 'আমরা দেশভিত্তিক চেকলিস্ট দেই: পাসপোর্ট কপি (৬+ মাস বৈধতা), পাসপোর্ট-সাইজ ছবি, আমন্ত্রণ পত্র, মেডিকেল রিপোর্ট, আর্থিক প্রমাণ এবং পূরণ করা ভিসা আবেদন ফর্ম।',
    duration: 'একই দিন',
  },
  {
    title: 'ভিসা আবেদন জমা',
    description: 'আপনার দেশের উপর নির্ভর করে, আপনি অনলাইনে (ই-ভিসা) বা ভারতীয় দূতাবাস/ভিসা কেন্দ্রে জমা দেন। আমরা সঠিক পোর্টালে নির্দেশনা দেই এবং জমার আগে আবেদন পর্যালোচনায় সাহায্য করি।',
    duration: '১ দিন',
  },
  {
    title: 'ভিসা প্রক্রিয়াকরণ',
    description: 'প্রক্রিয়াকরণের সময় দেশ ও ভিসার ধরনের উপর নির্ভর করে। ই-ভিসা সাধারণত ৩–৫ কর্মদিবস নেয়; দূতাবাস ভিসা ৫–১০ কর্মদিবস নিতে পারে। আমরা অবস্থা ট্র্যাক করি এবং প্রয়োজনে অনুসরণ করি।',
    duration: '৩–১০ দিন',
  },
  {
    title: 'অ্যাটেনড্যান্ট ভিসা (প্রয়োজন হলে)',
    description: 'রোগীর সাথে ভ্রমণকারী পরিবারের সদস্যরা রোগীর ভিসার পাশাপাশি অ্যাটেনড্যান্ট ভিসার জন্য আবেদন করেন। আমরা অতিরিক্ত ডকুমেন্ট ও জমা সমন্বয় করি।',
    duration: 'সমান্তরাল',
  },
  {
    title: 'ভিসা অনুমোদন ও ভ্রমণ প্রস্তুতি',
    description: 'অনুমোদিত হলে, আমরা আপনার ভিসার বিবরণ নিশ্চিত করি এবং আপনার ভিসার বৈধতার সাথে মিলিয়ে ফ্লাইট নির্দেশনা, এয়ারপোর্ট পিকআপ ও হাসপাতাল ভর্তি সময় সমন্বয় করি।',
    duration: '১–২ দিন',
  },
];

const requiredDocuments = [
  'কমপক্ষে ৬ মাস বৈধতা ও ২টি ফাঁকা পৃষ্ঠাসহ পাসপোর্ট',
  'পাসপোর্ট-সাইজ ছবি (সাদা ব্যাকগ্রাউন্ড)',
  'ভারতীয় হাসপাতাল থেকে আমন্ত্রণ পত্র',
  'সাম্প্রতিক মেডিকেল রিপোর্ট ও রোগনির্ণয় সারাংশ',
  'পূরণ করা মেডিকেল ভিসা আবেদন ফর্ম',
  'আর্থিক প্রমাণ বা স্পনসরশিপ চিঠি',
  'ফ্লাইট ইটিনারারি (রিটার্ন টিকিট পছন্দনীয়)',
  'থাকার প্রমাণ বা হাসপাতাল ভর্তি নিশ্চিতকরণ',
];

const faqs = [
  {
    question: 'ভারতের মেডিকেল ভিসা (M-Visa) কী?',
    answer: 'ভারতের মেডিকেল ভিসা (M-Visa) হলো বিদেশি নাগরিকদের জন্য বিশেষ ভিসা শ্রেণি যারা ভারতে চিকিৎসা নিতে চান। এটি হাসপাতালের আমন্ত্রণ পত্রের ভিত্তিতে দেওয়া হয় এবং সাধারণত এক বছর পর্যন্ত একাধিক প্রবেশের জন্য বৈধ, চিকিৎসার সময়কাল অনুযায়ী।',
  },
  {
    question: 'মেডিকেল ভিসা প্রক্রিয়াকরণে কত সময় লাগে?',
    answer: 'ই-মেডিকেল ভিসা সাধারণত ৩–৫ কর্মদিবসে প্রক্রিয়া হয়। দূতাবাস-ভিত্তিক মেডিকেল ভিসা আপনার দেশের উপর নির্ভর করে ৫–১০ কর্মদিবস নিতে পারে। জরুরি ক্ষেত্রে কখনো দ্রুত ব্যবস্থা করা যায় — যত তাড়াতাড়ি সম্ভব প্রক্রিয়া শুরু করতে আমরা পরামর্শ দেই।',
  },
  {
    question: 'পরিবারের সদস্যরাও কি ভিসা পাবেন?',
    answer: 'হ্যাঁ। রোগীর সাথে দুজন পর্যন্ত অ্যাটেনড্যান্ট (পরিবারের সদস্য) অ্যাটেনড্যান্ট ভিসা (MX-Visa) এর জন্য আবেদন করতে পারেন। অ্যাটেনড্যান্ট ভিসা রোগীর ভিসার সাথে যুক্ত এবং একই বৈধতার সময় থাকে।',
  },
  {
    question: 'আমার ভিসা দেরি হলে কী হবে?',
    answer: 'আমরা আপনার আবেদনের অবস্থা ট্র্যাক করি এবং সংশ্লিষ্ট দূতাবাস বা পোর্টালের সাথে অনুসরণ করি। ডকুমেন্টে সমস্যা থাকলে, আমরা দ্রুত সংশোধন ও পুনরায় জমায় সাহায্য করি। উল্লেখযোগ্য বিলম্বের ক্ষেত্রে আমরা হাসপাতালের সাথে চিকিৎসার তারিখ সমন্বয় করতে পারি।',
  },
  {
    question: 'আপনারা কি ভিসা অনুমোদন গ্যারান্টি দেন?',
    answer: 'না। ভিসা অনুমোদন ভারত সরকারের বিবেচনার ভিত্তিতে হয়। তবে আমরা নিশ্চিত করি যে আপনার আবেদন সম্পূর্ণ, সঠিক এবং সঠিক হাসপাতাল ডকুমেন্টেশন দ্বারা সমর্থিত — যা অনুমোদনের হার উল্লেখযোগ্যভাবে বাড়ায়।',
  },
  {
    question: 'চিকিৎসা দীর্ঘায়িত হলে কি মেডিকেল ভিসা বাড়ানো যায়?',
    answer: 'হ্যাঁ, হাসপাতাল নিশ্চিত করলে যে চলমান চিকিৎসা প্রয়োজন, ভারতে মেডিকেল ভিসা বাড়ানো যায়। আমরা হাসপাতাল এবং FRRO (Foreigners Regional Registration Office) এর সাথে বর্ধিতকরণ আবেদন সমন্বয় করি।',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'ভারতে মেডিকেল ভিসা সহায়তা',
    url: pageUrl,
    description: 'ভারতে চিকিৎসার জন্য আন্তর্জাতিক রোগীদের জন্য ধাপে ধাপে মেডিকেল ভিসা নির্দেশনা। ডকুমেন্ট চেকলিস্ট, প্রক্রিয়াকরণের সময় এবং অ্যাটেনড্যান্ট ভিসা সহায়তা।',
    inLanguage: 'bn',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/bn/` },
    { name: 'মেডিকেল ভিসা সহায়তা', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`মেডিকেল ভিসা সহায়তা | ${t.site.name}`}
  description="ভারতে চিকিৎসার জন্য আন্তর্জাতিক রোগীদের জন্য ধাপে ধাপে মেডিকেল ভিসা নির্দেশনা। ডকুমেন্ট চেকলিস্ট, প্রক্রিয়াকরণের সময় এবং অ্যাটেনড্যান্ট ভিসা সহায়তা।"
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/bn/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/bn' }, { label: 'মেডিকেল ভিসা সহায়তা' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            ভিসা সহায়তা
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            ভারতে মেডিকেল ভিসা সহায়তা
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            হাসপাতাল আমন্ত্রণ পত্র থেকে ভিসা অনুমোদন পর্যন্ত — আমরা প্রতিটি ডকুমেন্ট, সময়সীমা এবং দূতাবাসের প্রয়োজনীয়তা সমন্বয় করি যাতে আপনার পরিবার চিকিৎসায় মনোযোগ দিতে পারে, কাগজপত্রে নয়।
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            দ্রুত উত্তর
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">
            ভারত স্বীকৃত হাসপাতালে চিকিৎসা নিতে আসা রোগীদের জন্য একটি বিশেষ মেডিকেল ভিসা (M-Visa) অফার করে। প্রক্রিয়ায় হাসপাতাল আমন্ত্রণ পত্র, পাসপোর্ট, মেডিকেল রিপোর্ট এবং পূরণ করা আবেদন প্রয়োজন। অনেক দেশের জন্য ই-ভিসা উপলব্ধ এবং সাধারণত ৩–৫ কর্মদিবসে প্রক্রিয়া হয়। খান মেডিট্যুর সম্পূর্ণ কাগজপত্র পথ সমন্বয় করে — পরিবারের সদস্যদের জন্য অ্যাটেনড্যান্ট ভিসা সহ।
          </p>
        </div>
      </div>
    </section>

    {/* ── VISA PROCESS TIMELINE ────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          ভিসা প্রক্রিয়া — ধাপে ধাপে
        </h2>
        <StepTimeline steps={visaSteps} client:load />
      </div>
    </section>

    {/* ── REQUIRED DOCUMENTS ───────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-8 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          আপনার যে ডকুমেন্টগুলো লাগবে
        </h2>
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8" data-anim="fade-in-up">
          <ul class="space-y-4">
            {requiredDocuments.map((doc) => (
              <li class="flex items-start gap-3 text-base text-ink/80">
                <Icon name="check" size={20} className="mt-0.5 text-violet-600" />
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          আরও ঘুরে দেখুন
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          ভারতে আপনার মেডিকেল ভ্রমণ পরিকল্পনায় সাহায্যকারী সম্পর্কিত সেবা।
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/bn/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">কীভাবে কাজ করে</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">অনুসন্ধান থেকে ফেরার পর ফলো-আপ পর্যন্ত সম্পূর্ণ ৮-ধাপের রোগীর যাত্রা।</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">যাত্রা দেখুন <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/bn/travel-accommodation-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
