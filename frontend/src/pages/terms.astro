---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import LeadModalInterceptor from '../design-system/components/organisms/LeadModalInterceptor.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { breadcrumbs, legalPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/terms`;
const lastUpdated = '2026-09-16';
const effectiveDate = '2026-09-16';

const navLinks = getNavLinks(locale, Astro.url.pathname);
const legalLinks = getFooterLegalLinks(locale);

const schema = [
  legalPage({
    name: t.legal.termsTitle,
    url: pageUrl,
    description: t.legal.termsDescription,
    dateModified: lastUpdated,
    publisher: { name: t.site.name, url: siteUrl },
  }),
  breadcrumbs([
    { name: 'Home', url: siteUrl },
    { name: t.legal.termsTitle, url: pageUrl },
  ]),
];

const sections = [
  { id: 'acceptance', title: '1. Acceptance of Terms' },
  { id: 'services', title: '2. Services Provided by Khan Meditour' },
  { id: 'not-medical-provider', title: '3. Khan Meditour Is Not a Medical Provider' },
  { id: 'booking', title: '4. Booking and Appointments' },
  { id: 'payments', title: '5. Payments and Pricing' },
  { id: 'cancellations', title: '6. Cancellations and Refunds' },
  { id: 'patient-responsibilities', title: '7. Patient Responsibilities' },
  { id: 'travel-visa', title: '8. Travel, Visa, and Accommodation' },
  { id: 'intellectual-property', title: '9. Intellectual Property' },
  { id: 'limitations', title: '10. Limitation of Liability' },
  { id: 'governing-law', title: '11. Governing Law' },
  { id: 'changes', title: '12. Changes to These Terms' },
  { id: 'complaints', title: '13. Complaints' },
  { id: 'contact', title: '14. Contact Us' },
];
---

<Layout
  title={`${t.legal.termsTitle} | ${t.site.name}`}
  description={t.legal.termsDescription}
  locale={locale}
  jsonLd={schema}
>
  <Navbar
    brand={t.site.name}
    links={navLinks}
    cta={{ label: t.nav.cta, href: '#contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={phoneNumber}
    callLabel={t.nav.call}
    whatsappHref={whatsappInquiryHref}
    whatsappLabel={t.nav.whatsapp}
  />

  <article class="bg-cream-50 pb-16 pt-32">
    <div class="container max-w-4xl">
      <Breadcrumb
        items={[{ label: 'Home', href: '/' }, { label: t.legal.termsTitle }]}
        locale={locale}
      />

      <header class="mt-8 border-b border-cream-300 pb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
          {t.legal.effectiveDate}: {effectiveDate}
        </p>
        <h1
          class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
        >
          {t.legal.termsTitle}
        </h1>
        <p class="text-ink/60 mt-4 text-lg leading-relaxed">
          {t.legal.termsDescription}
        </p>
        <p class="text-ink/40 mt-3 text-sm">
          {t.legal.lastUpdated}: {lastUpdated}
        </p>
      </header>

      {/* Table of contents */}
      <nav
        class="mt-8 rounded-card border border-cream-300 bg-cream-100 p-6"
        aria-label={t.legal.tableOfContents}
      >
        <p class="text-ink/40 mb-3 text-xs font-semibold uppercase tracking-widest">
          {t.legal.tableOfContents}
        </p>
        <ol class="grid gap-1 sm:grid-cols-2">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="text-sm text-violet-600 hover:underline">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="text-ink/70 mt-10 space-y-10 leading-relaxed">
        <section id="acceptance">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            1. Acceptance of Terms
          </h2>
          <p class="mt-4">
            By accessing or using the Khan Meditour website (khanmeditour.com) and our coordination
            services, you agree to be bound by these Terms & Conditions ("Terms"). If you do not
            agree to these Terms, please do not use our website or services. These Terms form a
            service agreement between you ("Patient," "you") and Khan Meditour ("we," "us," "our").
          </p>
        </section>

        <section id="services">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            2. Services Provided by Khan Meditour
          </h2>
          <p class="mt-4">
            Khan Meditour is a medical tourism facilitator and care coordination service. We connect
            international patients with accredited hospitals, specialist doctors, and treatment
            facilities in India. Our services include:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Hospital and doctor shortlisting based on your medical condition</li>
            <li>Cost estimates and treatment plan coordination</li>
            <li>Medical visa assistance and documentation support</li>
            <li>Travel, accommodation, and airport pickup arrangement</li>
            <li>Interpreter services and on-ground coordination in India</li>
            <li>Post-treatment follow-up coordination</li>
          </ul>
          <p class="mt-4">
            We act as a facilitator and coordinator. We do not provide medical advice, diagnosis, or
            treatment directly.
          </p>
        </section>

        <section id="not-medical-provider">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            3. Khan Meditour Is Not a Medical Provider
          </h2>
          <p class="mt-4">
            Khan Meditour is <strong>not</strong> a hospital, clinic, or medical practice. We do not employ
            doctors and we do not provide medical care. All medical treatment is provided by independent
            hospitals and doctors who are separately licensed and regulated. Khan Meditour does not:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Provide medical advice, diagnosis, or treatment</li>
            <li>Guarantee any medical outcome or success rate</li>
            <li>Establish a physician-patient relationship with you</li>
            <li>
              Assume responsibility for the clinical decisions of treating doctors or hospitals
            </li>
          </ul>
          <p class="mt-4">
            You should always consult with the treating hospital and doctor regarding medical risks,
            alternatives, and expected outcomes before proceeding with any treatment.
          </p>
        </section>

        <section id="booking">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            4. Booking and Appointments
          </h2>
          <p class="mt-4">
            When you submit a consultation request through our website, WhatsApp, or lead form, our
            coordinators will review your medical reports and connect you with suitable hospitals
            and doctors. Booking a treatment through Khan Meditour involves:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Sharing your medical reports and relevant history</li>
            <li>Receiving a preliminary cost estimate (final cost confirmed by the hospital)</li>
            <li>Coordinating appointment dates with the treating hospital</li>
            <li>Receiving a treatment plan and travel itinerary</li>
          </ul>
          <p class="mt-4">
            Cost estimates provided before treatment are approximate and based on information
            available at the time. Final costs may vary depending on the hospital, surgeon,
            complexity of the case, implants used, diagnostic tests, length of hospital stay, and
            any complications that may arise.
          </p>
        </section>

        <section id="payments">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            5. Payments and Pricing
          </h2>
          <p class="mt-4">
            All medical treatment fees are paid directly to the hospital or treating facility, not
            to Khan Meditour, unless explicitly stated otherwise in writing. Khan Meditour's
            coordination services are currently offered free of charge to patients. If any service
            fee is introduced in the future, it will be disclosed in writing before booking.
          </p>
          <p class="mt-4">
            Pricing shown on our website or in cost estimates is for informational purposes only and
            does not constitute a binding quote. The treating hospital will provide the final,
            binding cost estimate after reviewing your medical reports.
          </p>
        </section>

        <section id="cancellations">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            6. Cancellations and Refunds
          </h2>
          <p class="mt-4">
            Cancellation and refund policies are governed by the treating hospital's own policies,
            not by Khan Meditour. We will inform you of the hospital's cancellation and refund terms
            before you confirm a booking. Generally:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>
              Cancellations made well in advance of the treatment date may qualify for a partial or
              full refund, depending on the hospital's policy
            </li>
            <li>
              Cancellations made close to or after the scheduled treatment date may incur charges
            </li>
            <li>
              Non-refundable items may include diagnostic tests, pre-surgery consultations, and
              visa-related fees already incurred
            </li>
          </ul>
          <p class="mt-4">
            Khan Meditour is not responsible for refunds from hospitals. We will, however, assist
            you in communicating with the hospital regarding any cancellation or refund request.
          </p>
        </section>

        <section id="patient-responsibilities">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            7. Patient Responsibilities
          </h2>
          <p class="mt-4">As a patient using our services, you are responsible for:</p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Providing accurate and complete medical information and reports</li>
            <li>Disclosing existing medical conditions, allergies, and medications</li>
            <li>Following the treating hospital's pre- and post-treatment instructions</li>
            <li>Maintaining valid travel documents, including passport and medical visa</li>
            <li>Arranging adequate funds for treatment and travel expenses</li>
            <li>Obtaining travel and medical insurance appropriate for your trip</li>
          </ul>
          <p class="mt-4">
            Failure to provide accurate medical information may result in incorrect treatment
            planning, additional costs, or denial of treatment by the hospital.
          </p>
        </section>

        <section id="travel-visa">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            8. Travel, Visa, and Accommodation
          </h2>
          <p class="mt-4">
            Khan Meditour assists with medical visa applications by providing the necessary
            invitation letters and documentation from the treating hospital. However, visa approval
            is at the sole discretion of the Indian embassy or consulate in your country. Khan
            Meditour does not guarantee visa approval.
          </p>
          <p class="mt-4">
            Travel and accommodation arrangements are made through third-party providers (airlines,
            hotels, transport companies). Khan Meditour is not liable for delays, cancellations, or
            service failures by these third parties.
          </p>
        </section>

        <section id="intellectual-property">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            9. Intellectual Property
          </h2>
          <p class="mt-4">
            All content on this website — including text, graphics, logos, images, hospital
            information, treatment descriptions, and design — is the property of Khan Meditour or
            its content partners and is protected by intellectual property laws. You may not
            reproduce, distribute, or republish any content from this website without prior written
            permission.
          </p>
        </section>

        <section id="limitations">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            10. Limitation of Liability
          </h2>
          <p class="mt-4">
            To the maximum extent permitted by law, Khan Meditour shall not be liable for:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6">
            <li>Any medical outcome, complication, or adverse event arising from treatment</li>
            <li>Decisions made by treating hospitals, doctors, or medical staff</li>
            <li>
              Delays or failures by third-party service providers (airlines, hotels, visa
              authorities)
            </li>
            <li>
              Any indirect, incidental, or consequential damages arising from the use of our
              services
            </li>
          </ul>
          <p class="mt-4">
            Our total liability for any claim arising from our coordination services shall not
            exceed any service fee actually paid to Khan Meditour by you, if applicable.
          </p>
        </section>

        <section id="governing-law">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">11. Governing Law</h2>
          <p class="mt-4">
            These Terms are governed by the laws of India. Any disputes arising from these Terms or
            our services shall be subject to the exclusive jurisdiction of the courts in Bangalore,
            Karnataka, India.
          </p>
        </section>

        <section id="changes">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">
            12. Changes to These Terms
          </h2>
          <p class="mt-4">
            We may update these Terms from time to time. The "Last updated" date at the top of this
            page reflects the most recent revision. Continued use of our services after changes
            constitutes acceptance of the updated Terms. We encourage you to review this page
            periodically.
          </p>
        </section>

        <section id="complaints">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">13. Complaints</h2>
          <p class="mt-4">Not happy with our service?</p>
          <p class="mt-4">
            Email <a
              href="mailto:complaints@khanmeditour.com"
              class="text-violet-600 hover:underline">complaints@khanmeditour.com</a
            > with the subject "Complaint" and a description of your concern. We take all complaints seriously
            and will respond within 5 business days.
          </p>
        </section>

        <section id="contact">
          <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">14. Contact Us</h2>
          <p class="mt-4">If you have any questions about these Terms, please contact us:</p>
          <div class="mt-4 rounded-card border border-cream-300 bg-cream-100 p-6">
            <p class="font-semibold text-ink">{t.site.name}</p>
            <p class="mt-2 text-sm">
              Email: <a href={`mailto:${contactEmail}`} class="text-violet-600 hover:underline"
                >{contactEmail}</a>
            </p>
            <p class="text-sm">
              WhatsApp: <a href={whatsappInquiryHref} class="text-violet-600 hover:underline"
                >+{whatsappNumber}</a>
            </p>
            <p class="text-sm">
              Phone: <a href={`tel:+${phoneNumber}`} class="text-violet-600 hover:underline"
                >+{phoneNumber}</a>
            </p>
          </div>
        </section>
      </div>
    </div>
  </article>

  <TreatmentsCtaSection
    locale={locale}
    primaryCta={{ label: t.nav.cta, href: '#contact' }}
    secondaryCta={{ label: t.nav.whatsapp, href: whatsappInquiryHref }}
  />

  <LeadModalInterceptor
    modalTitle={t.leadModal.title}
    modalSubtitle={t.leadModal.subtitle}
    closeLabel={t.leadModal.close}
  />

  <Footer
    brand={t.site.name}
    legalLinks={legalLinks}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
