---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { DoctorCard } from '../../design-system/components/organisms/DoctorCard';
import { LeadForm } from '../../design-system/components/organisms/LeadForm';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { getTreatments, getDoctors, getHospitals, resolveRelatedDoctors, resolveHospital, resolveRelatedHospitals, entrySlug } from '../../lib/content';
import { medicalProcedure, breadcrumbs, faqPage, medicalWebPage } from '../../lib/schema';
import { getTreatmentInquiryLink, getDoctorInquiryLink } from '../../lib/whatsapp';
import { generateTreatmentFaqs, mergeFaqs } from '../../lib/faq-generator';
import { FAQAccordion } from '../../design-system/components/organisms/FAQAccordion';
import type { Doctor } from '../../design-system/components/organisms/DoctorCard';
import { LEAD_SOURCE } from '../../lib/crm';

export async function getStaticPaths() {
  const [treatments, doctors, hospitals] = await Promise.all([
    getTreatments('en'),
    getDoctors('en'),
    getHospitals('en'),
  ]);

  return treatments.map((entry) => {
    const related = resolveRelatedDoctors(entry.data.relatedDoctorSlugs, doctors).map((d) => {
      const hospital = resolveHospital(d.data.hospitalId, hospitals);
      return {
        name: d.data.name,
        specialty: d.data.specialty,
        qualification: d.data.qualification,
        experienceYears: d.data.experienceYears,
        avatar: d.data.avatar,
        href: `/doctors/${entrySlug(d)}`,
        hospitalName: hospital?.name,
        hospitalHref: hospital?.href,
        whatsappHref: getDoctorInquiryLink(d.data.name) || undefined,
      };
    });
    const relatedHospitals = resolveRelatedHospitals(entry.data.relatedHospitalSlugs, hospitals).map((h) => ({
      name: h.data.name,
      city: h.data.city,
      image: h.data.image,
      href: `/hospitals/${entrySlug(h)}`,
    }));
    return {
      params: { slug: entrySlug(entry) },
      props: { treatment: entry.data, related, relatedHospitals, entry },
    };
  });
}

const t = getTranslations('en');
const { treatment, related, relatedHospitals, entry } = Astro.props;
const { Content } = await entry.render();

const navLinks = getNavLinks('en');

const title = `${treatment.name} — ${t.treatments.title} | ${t.site.name}`;
const description = treatment.description;

const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const procedureSchema = medicalProcedure({
  name: treatment.name,
  url: pageUrl,
  description: treatment.description,
  image: treatment.image,
  procedureType: treatment.category,
});

const jsonLd = [
  procedureSchema,
  medicalWebPage({
    name: treatment.name,
    url: pageUrl,
    description: treatment.description,
    image: treatment.image,
    inLanguage: 'en',
    specialty: treatment.category,
    about: procedureSchema,
    audience: 'Patients seeking medical treatment in Bangalore',
  }),
  breadcrumbs([
    { name: t.nav.home, url: new URL('/', Astro.url.origin).toString() },
    { name: t.treatments.title, url: new URL('/treatments', Astro.url.origin).toString() },
    { name: treatment.name, url: pageUrl },
  ]),
];

const treatmentWhatsAppHref = getTreatmentInquiryLink(treatment.name);

const relatedDoctorNames = related.map((d) => d.name);
const relatedHospitalNames = relatedHospitals.map((h) => h.name);
const autoFaqs = generateTreatmentFaqs(treatment, relatedDoctorNames, relatedHospitalNames, 'en');
const faqs = treatment.faqs ? mergeFaqs(autoFaqs, treatment.faqs) : autoFaqs;
if (faqs.length > 0) {
  jsonLd.push(faqPage({ entries: faqs }));
}

const allTreatments = await getTreatments('en');
const treatmentOptions = allTreatments.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));
---

<Layout title={title} description={description} locale="en" image={treatment.image} jsonLd={jsonLd}>
  <Navbar brand={t.site.name} links={navLinks} cta={{ label: t.nav.cta, href: '/#contact' }} client:load />

  <main class="container py-24 md:py-28">
    <Breadcrumb
      items={[
        { label: t.nav.home, href: '/' },
        { label: t.treatments.title, href: '/treatments' },
        { label: treatment.name },
      ]}
      class="mb-6"
      data-anim="fade-in-up"
    />

    <div class="grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div>
        <div data-anim="stagger-children">
          {treatment.category && (
            <span class="mb-3 inline-block rounded-full bg-cream-300 px-3 py-1 text-xs font-semibold text-ink/70">
              {treatment.category}
            </span>
          )}
          <h1 class="font-display text-4xl font-bold text-ink md:text-5xl" data-anim="headline-reveal">{treatment.name}</h1>
        </div>
        <div class="prose prose-ink mt-8 max-w-none" data-anim="fade-in-up">
          <h2 class="mb-3 font-display text-xl font-semibold text-ink">{t.treatments.detail.description}</h2>
          <p class="text-ink/70 leading-relaxed">{treatment.description}</p>
        </div>

        {treatment.procedures && treatment.procedures.length > 0 && (
          <div class="mt-12" data-anim="fade-in-up">
            <h2 class="mb-4 font-display text-xl font-semibold text-ink">{t.treatments.detail.procedures}</h2>
            <ul class="grid gap-3 sm:grid-cols-2" data-anim="stagger-cards">
              {treatment.procedures.map((procedure) => (
                <li class="flex items-start gap-3 rounded-card border border-cream-300 bg-cream-100 p-4 text-sm text-ink/80">
                  <span class="mt-0.5 h-2 w-2 shrink-0 rounded-full bg-violet-600" aria-hidden="true" />
                  {procedure}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose prose-ink mt-12 max-w-none" data-anim="scroll-reveal">
          <Content />
        </div>

        {relatedHospitals.length > 0 && (
          <div class="mt-12" data-anim="fade-in-up">
            <h2 class="mb-4 font-display text-xl font-semibold text-ink">Treating Hospitals</h2>
            <div class="grid gap-4 sm:grid-cols-2" data-anim="stagger-cards">
              {relatedHospitals.map((h) => (
                <a href={h.href} class="flex items-center gap-4 rounded-card border border-cream-300 bg-cream-100 p-4 transition-colors hover:border-cream-300/80 hover:bg-cream-200">
                  {h.image && (
                    <img src={h.image} alt={h.name} class="h-12 w-12 rounded-card object-cover" />
                  )}
                  <div>
                    <p class="text-sm font-semibold text-ink">{h.name}</p>
                    <p class="text-xs text-ink/50">{h.city}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mt-12 flex flex-wrap gap-4" data-anim="fade-in-up">
          <a
            href={treatmentWhatsAppHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-card bg-ink px-6 py-3 text-sm font-semibold text-white shadow-md hover:text-white"
            data-anim="press-button"
          >
            <Icon name="whatsapp" size={18} />
            {t.treatments.detail.inquiryCta}
          </a>
        </div>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto" data-anim="fade-in-up">
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6">
          <h2 class="mb-4 font-display text-lg font-semibold text-ink">Treatment Info</h2>
          <dl class="space-y-3 text-sm" data-anim="stagger-children">
            {treatment.category && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/50">Category</dt>
                <dd class="font-medium text-ink/80">{treatment.category}</dd>
              </div>
            )}
            {treatment.duration && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/50">Duration</dt>
                <dd class="font-medium text-ink/80">{treatment.duration}</dd>
              </div>
            )}
            {treatment.hospitalStay && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/50">Hospital Stay</dt>
                <dd class="font-medium text-ink/80">{treatment.hospitalStay}</dd>
              </div>
            )}
            {treatment.recoveryTime && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink/50">Recovery Time</dt>
                <dd class="font-medium text-ink/80">{treatment.recoveryTime}</dd>
              </div>
            )}
          </dl>
        </div>

        {related.length > 0 && (
          <div data-anim="fade-in-up">
            <h2 class="mb-4 font-display text-lg font-semibold text-ink">{t.treatments.detail.relatedDoctors}</h2>
            <div class="grid gap-4" data-anim="stagger-cards">
              {related.map((doctor: Doctor) => (
                <DoctorCard key={doctor.name} doctor={doctor} bookLabel={t.doctors.bookCta} whatsappLabel={t.doctors.detail.whatsappCta} />
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    {faqs.length > 0 && (
      <section class="mt-16" data-anim="fade-in-up">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{t.treatments.detail.faqTitle}</h2>
        <FAQAccordion items={faqs} client:visible />
      </section>
    )}
  </main>

  <section id="contact" class="bg-cream-200 py-20" data-anim="stagger-children">
    <div class="container grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{t.cta.formTitle}</h2>
        <p class="mt-4 text-lg text-ink/60">{t.cta.subtitle}</p>
      </div>
      <div class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8">
        <h3 class="mb-6 font-display text-xl font-semibold text-ink">{t.cta.formTitle}</h3>
        <LeadForm
          client:load
          source={LEAD_SOURCE.TREATMENT_PAGE}
          defaultTreatment={treatment.name}
          treatments={treatmentOptions}
        />
      </div>
    </div>
  </section>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks('en')}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
