---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { StepTimeline } from '../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/medical-visa-assistance`;

const visaSteps = [
  {
    title: 'Hospital invitation letter',
    description:
      'Once you choose a treatment pathway, the hospital issues an official invitation letter. This letter confirms your treatment, dates, and patient details — it is the core document for your visa application. You will need to share your diagnosis, recent medical reports, and passport details so the hospital can prepare it.',
    duration: '1–2 days',
  },
  {
    title: 'Document checklist',
    description:
      'We provide a country-specific checklist: passport copy (6+ months validity), passport-size photos, invitation letter, medical reports, local doctor referral letter, proof of funds, and completed visa application form. For Bangladesh and Pakistan nationals, a referral from your local doctor is mandatory and the most common rejection reason if missing.',
    duration: 'Same day',
  },
  {
    title: 'Visa application submission',
    description:
      'Depending on your country, you submit online (e-Medical Visa) or at the Indian embassy/visa centre. Citizens of 176 countries can apply online through indianvisaonline.gov.in. Bangladesh and Pakistan nationals must apply in person at IVAC or the Indian High Commission — the e-Visa portal is not available for these nationalities.',
    duration: '1 day',
  },
  {
    title: 'Visa processing',
    description:
      'Processing time varies by country and visa type. E-Medical Visas typically take 3–5 business days. Regular embassy-based medical visas take 5–15 business days. Bangladesh IVAC processing is usually 2–3 working days after submission. We track status and follow up if needed.',
    duration: '3–15 days',
  },
  {
    title: 'Attendant visa (if required)',
    description:
      'Family members travelling with the patient apply for Medical Attendant Visa (MX-Visa) alongside the patient visa. Most nationalities allow up to 2 attendants. Bangladesh nationals can bring up to 3 attendants under a special bilateral provision. Pakistan nationals are limited to 1 attendant. Attendant visas are co-terminus with the patient visa.',
    duration: 'Parallel',
  },
  {
    title: 'Visa approval & travel prep',
    description:
      'Once approved, we confirm your visa details and coordinate flight guidance, airport pickup, and hospital admission timing to align with your visa validity window. E-Medical Visas are valid for 60 days from arrival with triple entry; regular medical visas can be valid up to 1 year with multiple entries.',
    duration: '1–2 days',
  },
  {
    title: 'FRRO registration after arrival',
    description:
      'If your treatment requires a stay longer than 180 days, you must register with the Foreigners Regional Registration Office (FRRO) within 14 days of arrival. Pakistan nationals on medical visa must register within 7 days. We coordinate the registration with the hospital letter and your accommodation proof so you stay compliant throughout treatment.',
    duration: 'Within 14 days of arrival',
  },
];

const requiredDocuments = [
  'Passport with at least 6 months validity and 2 blank pages',
  'Passport-size photographs (white background)',
  'Hospital invitation letter from the Indian hospital',
  'Recent medical reports and diagnosis summary',
  'Referral letter from your local doctor (mandatory for Bangladesh and Pakistan nationals)',
  'Completed medical visa application form with Medical Visa Reference Number',
  'Proof of funds or sponsorship letter',
  'Flight itinerary (return ticket preferred)',
  'Accommodation proof or hospital admission confirmation',
];

const faqs = [
  {
    question: 'What is the difference between e-Medical Visa and regular Medical Visa for India?',
    answer:
      'The e-Medical Visa is applied for entirely online through indianvisaonline.gov.in, processed in 3–5 business days, valid for 60 days from arrival with triple entry, and available to citizens of 176 countries. The regular (paper) Medical Visa is applied for in person at an Indian embassy or visa centre, takes 5–15 business days, can be valid up to 1 year with multiple entries, and is available to all nationalities. If your country is eligible for e-Medical Visa and your treatment is under 60 days, it is usually the faster route.',
  },
  {
    question: 'Which countries are eligible for India e-Medical Visa?',
    answer:
      'Citizens of 176 countries are eligible for the e-Medical Visa, including the US, UK, Canada, Australia, UAE, Saudi Arabia, Nigeria, Kenya, Ethiopia, and most European and Asian nations. Notable exceptions are Bangladesh and Pakistan — nationals of these countries must apply for a regular Medical Visa through the Indian Visa Application Centre (IVAC) or Indian High Commission, not the e-Visa portal. We confirm your eligibility and the correct application route based on your passport.',
  },
  {
    question: 'How much does an Indian medical visa cost?',
    answer:
      'The e-Medical Visa fee ranges from US$25 to US$100 depending on your nationality, plus a 2.5–3% bank processing surcharge. Regular Medical Visa fees range from US$50 to US$150. Bangladesh nationals pay no government visa fee under the India-Bangladesh bilateral agreement — only the IVAC service charge applies. The exact fee for your nationality is shown on the official government portal when you apply. Medical Attendant Visa fees follow the same schedule as the patient visa.',
  },
  {
    question: 'How long does medical visa processing take?',
    answer:
      'E-Medical Visas are typically processed within 3–5 business days. Regular embassy-based medical visas take 5–15 business days depending on your country. Bangladesh IVAC processing is usually 2–3 working days after submission. We advise starting the process as early as possible — ideally 4–6 weeks before your planned travel date — to allow buffer time for document corrections or embassy follow-ups.',
  },
  {
    question: 'Can family members accompany me? How many attendants are allowed?',
    answer:
      'Yes. Family members apply for a Medical Attendant Visa (MX-Visa) alongside the patient visa. Most nationalities allow up to 2 attendants. Bangladesh nationals can bring up to 3 attendants under a special bilateral provision. Pakistan nationals are limited to 1 attendant. Attendants must be blood relatives or close family members, and their visa is co-terminus with the patient visa — same validity period.',
  },
  {
    question: 'Do I need to register with FRRO after arriving in India?',
    answer:
      'If your treatment requires a continuous stay longer than 180 days, you must register with the Foreigners Regional Registration Office (FRRO) within 14 days of arrival. Pakistan nationals on medical visa must register within 7 days. Registration requires your passport, visa, a hospital letter, and proof of accommodation. Children below 12 years are exempt. We coordinate the FRRO registration so you stay compliant throughout your treatment.',
  },
  {
    question: 'Can I extend my medical visa if treatment takes longer than expected?',
    answer:
      'Yes. Medical visas can be extended in India if the hospital confirms in writing that continued treatment is necessary. The FRRO can extend a Medical Visa for up to one additional year on production of a medical certificate from the treating hospital. Extensions are processed through the e-FRRO online portal or at the nearest FRRO office, typically taking a few days to two weeks. We coordinate the extension application with the hospital and FRRO.',
  },
  {
    question: 'What if my visa is delayed or rejected?',
    answer:
      'We track your application status and follow up with the relevant embassy or portal. If there are document issues, we help you correct and resubmit quickly — common rejection reasons include missing local doctor referral, name mismatches between passport and documents, or an invitation letter not sent from the hospital official email. In rare cases of significant delay, we can coordinate with the hospital to adjust treatment dates. Visa approval is at the discretion of the Indian government, but a complete and accurate application significantly improves approval rates.',
  },
  {
    question: 'Do you guarantee visa approval?',
    answer:
      'No. Visa approval is at the discretion of the Indian government and no agency can guarantee it. However, we ensure your application is complete, accurate, and supported by the correct hospital documentation — which significantly improves approval rates. We also review your application before submission to catch common errors that cause rejection.',
  },
  {
    question: 'What documents does the hospital need to issue the invitation letter?',
    answer:
      'To issue the invitation letter, the hospital typically requires your diagnosis summary, recent medical reports (lab results, scans, biopsy reports), passport copy, and the expected treatment plan. Some hospitals may request a referral from your local doctor. We help you gather and organise these documents so the hospital can issue the letter within 24–48 hours in most cases.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Medical Visa Assistance for Travelling to India',
    url: pageUrl,
    description:
      'Step-by-step medical visa guidance for international patients travelling to India for treatment. Document checklists, processing times, fee ranges, FRRO registration, and attendant visa support.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Medical Visa Assistance', url: `${pageUrl}/` },
  ]),
  faqPage({ entries: faqs }),
];
---

<Layout
  title={`Medical Visa to India | Step-by-Step Guidance | ${t.site.name}`}
  description="Complete medical visa guide for travelling to India for treatment. E-Medical Visa and regular Medical Visa process, document checklist, fees, FRRO registration, and attendant visa support for international patients."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Medical Visa Assistance' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            Visa support
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl"
            data-anim="headline-reveal"
          >
            Medical visa to India, made clear
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            When you are facing a serious diagnosis, the last thing you need is visa paperwork
            standing between you and treatment. From hospital invitation letter to FRRO
            registration, we handle every document, deadline, and embassy requirement — so you and
            your family can focus on getting better, not navigating bureaucracy.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div
          class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="text-ink/80 mt-3 text-base leading-relaxed">
            India offers two medical visa routes. The <strong>e-Medical Visa</strong> is applied
            for online, processed in 3–5 business days, valid for 60 days with triple entry, and
            available to citizens of 176 countries — fees range from US$25–$100 by nationality. The
            <strong>regular Medical Visa</strong> is applied for at an Indian embassy or visa centre,
            takes 5–15 business days, and can be valid up to 1 year with multiple entries.
            Bangladesh and Pakistan nationals are not eligible for e-Visa and must apply through
            IVAC or the Indian High Commission. Khan Meditour confirms your eligibility, prepares
            your documents, and coordinates the full process — including attendant visas for family
            members.
          </p>
        </div>
      </div>
    </section>

    {/* ── VISA PROCESS TIMELINE ────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          The visa process — step by step
        </h2>
        <StepTimeline steps={visaSteps} client:load />
      </div>
    </section>

    {/* ── REQUIRED DOCUMENTS ───────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2
          class="mb-8 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Documents you will need
        </h2>
        <div
          class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8"
          data-anim="fade-in-up"
        >
          <ul class="space-y-4">
            {
              requiredDocuments.map((doc) => (
                <li class="text-ink/80 flex items-start gap-3 text-base">
                  <Icon name="check" size={20} className="mt-0.5 text-violet-600" />
                  <span>{doc}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Explore further
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          Related services to help you plan your medical trip to India.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a
            href="/how-it-works"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="list" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              The full 8-step patient journey from enquiry to follow-up after return.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >See the journey <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/travel-accommodation-assistance"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="plane" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Flights, airport pickup, stays, and daily logistics for your arrival in India.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Travel support <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/emergency-urgent-cases"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="alert" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Urgent cases</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Fast-track visa and hospital matching for time-sensitive medical cases.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Urgent pathway <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/countries"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="globe" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Country guides</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Region-specific visa steps and travel notes for your country.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Browse guides <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/cost-calculator"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="stethoscope" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Estimate treatment costs before you apply for your medical visa.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Estimate costs <Icon name="arrow-right" size={14} /></span
            >
          </a>
          <a
            href="/contact"
            class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base"
            data-anim="fade-in-up"
          >
            <div class="flex items-center gap-3">
              <span
                class="bg-ink/10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              >
                <Icon name="phone" size={20} className="text-ink" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Contact us</h3>
            </div>
            <p class="text-ink/70 mt-3 text-sm leading-relaxed">
              Questions about visa documents? Reach us on WhatsApp, phone, or email.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600"
              >Get in touch <Icon name="arrow-right" size={14} /></span
            >
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2
          class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="Begin with a hospital invitation letter"
      body="Share your diagnosis and we will coordinate the hospital invitation letter and full visa document checklist for your country — usually within 24–48 hours."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Questions about your visa eligibility?"
      body="Tell us your country and treatment type — we will confirm the visa pathway, processing time, and documents required for your specific case."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
