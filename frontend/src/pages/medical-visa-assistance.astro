---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { StepTimeline } from '../design-system/components/organisms/StepTimeline';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/medical-visa-assistance`;

const visaSteps = [
  {
    title: 'Hospital invitation letter',
    description: "Once you choose a treatment pathway, the hospital issues an official invitation letter. This letter confirms your treatment, dates, and patient details — it is the core document for your visa application.",
    duration: '1–2 days',
  },
  {
    title: 'Document checklist',
    description: "We provide a country-specific checklist: passport copy (6+ months validity), passport-size photos, invitation letter, medical reports, proof of funds, and completed visa application form.",
    duration: 'Same day',
  },
  {
    title: 'Visa application submission',
    description: "Depending on your country, you submit online (e-visa) or at the Indian embassy/visa centre. We guide you on the correct portal and help review your application before submission.",
    duration: '1 day',
  },
  {
    title: 'Visa processing',
    description: "Processing time varies by country and visa type. E-visas typically take 3–5 business days; embassy visas can take 5–10 business days. We track status and follow up if needed.",
    duration: '3–10 days',
  },
  {
    title: 'Attendant visa (if required)',
    description: "Family members travelling with the patient apply for attendant visas alongside the patient visa. We coordinate the additional documents and submission for attendants.",
    duration: 'Parallel',
  },
  {
    title: 'Visa approval & travel prep',
    description: "Once approved, we confirm your visa details and coordinate flight guidance, airport pickup, and hospital admission timing to align with your visa validity window.",
    duration: '1–2 days',
  },
];

const requiredDocuments = [
  'Passport with at least 6 months validity and 2 blank pages',
  'Passport-size photographs (white background)',
  'Hospital invitation letter from the Indian hospital',
  'Recent medical reports and diagnosis summary',
  'Completed medical visa application form',
  'Proof of funds or sponsorship letter',
  'Flight itinerary (return ticket preferred)',
  'Accommodation proof or hospital admission confirmation',
];

const faqs = [
  {
    question: 'What is a medical visa (M-Visa) for India?',
    answer: 'The Indian medical visa (M-Visa) is a special visa category for foreign nationals seeking medical treatment in India. It is granted based on a hospital invitation letter and is typically valid for up to one year with multiple entries, depending on the treatment duration.',
  },
  {
    question: 'How long does medical visa processing take?',
    answer: 'E-medical visas are typically processed within 3–5 business days. Embassy-based medical visas can take 5–10 business days depending on your country. Urgent cases can sometimes be fast-tracked — we advise starting the process as early as possible.',
  },
  {
    question: 'Can family members get a visa too?',
    answer: 'Yes. Up to two attendants (family members) can apply for an attendant visa (MX-Visa) alongside the patient. The attendant visa is tied to the patient visa and has the same validity period.',
  },
  {
    question: 'What if my visa is delayed?',
    answer: 'We track your application status and follow up with the relevant embassy or portal. If there are document issues, we help you correct and resubmit quickly. In rare cases of significant delay, we can coordinate with the hospital to adjust treatment dates.',
  },
  {
    question: 'Do you guarantee visa approval?',
    answer: 'No. Visa approval is at the discretion of the Indian government. However, we ensure your application is complete, accurate, and supported by the correct hospital documentation — which significantly improves approval rates.',
  },
  {
    question: 'Can I extend my medical visa if treatment takes longer?',
    answer: 'Yes, medical visas can be extended in India if the hospital confirms that continued treatment is necessary. We coordinate the extension application with the hospital and the FRRO (Foreigners Regional Registration Office).',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Medical Visa Assistance for India',
    url: pageUrl,
    description: 'Step-by-step medical visa guidance for international patients travelling to India for treatment. Document checklists, processing times, and attendant visa support.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Medical Visa Assistance', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`Medical Visa Assistance | ${t.site.name}`}
  description="Step-by-step medical visa guidance for international patients travelling to India for treatment. Document checklists, processing times, and attendant visa support."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Medical Visa Assistance' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            Visa support
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            Medical visa assistance for India
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            From hospital invitation letter to visa approval — we coordinate every document, deadline, and embassy requirement so your family can focus on treatment, not paperwork.
          </p>
        </div>
      </div>
    </section>

    {/* ── QUICK ANSWER CARD ────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="scroll-reveal">
      <div class="container">
        <div class="mx-auto max-w-3xl rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8" data-anim="fade-in-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
            Quick answer
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">
            India offers a dedicated medical visa (M-Visa) for patients seeking treatment at recognised hospitals. The process requires a hospital invitation letter, passport, medical reports, and a completed application. E-visas are available for many countries and typically process in 3–5 business days. Khan Meditour coordinates the entire paperwork pathway — including attendant visas for family members.
          </p>
        </div>
      </div>
    </section>

    {/* ── VISA PROCESS TIMELINE ────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-12 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          The visa process — step by step
        </h2>
        <StepTimeline steps={visaSteps} client:load />
      </div>
    </section>

    {/* ── REQUIRED DOCUMENTS ───────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-8 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Documents you will need
        </h2>
        <div class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8" data-anim="fade-in-up">
          <ul class="space-y-4">
            {requiredDocuments.map((doc) => (
              <li class="flex items-start gap-3 text-base text-ink/80">
                <Icon name="check" size={20} className="mt-0.5 text-violet-600" />
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS: EXPLORE FURTHER ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Related services to help you plan your medical trip to India.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/how-it-works" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="list" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">How it works</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">The full 8-step patient journey from enquiry to follow-up after return.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">See the journey <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/travel-accommodation-assistance" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="plane" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Travel & accommodation</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Flights, airport pickup, stays, and daily logistics for your arrival in India.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Travel support <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/emergency-urgent-cases" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-red-600/10">
                <Icon name="alert" size={20} className="text-red-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Urgent cases</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Fast-track visa and hospital matching for time-sensitive medical cases.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Urgent pathway <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/countries" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Country guides</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Region-specific visa steps and travel notes for your country.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Browse guides <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/cost-calculator" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Estimate treatment costs before you apply for your medical visa.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Estimate costs <Icon name="arrow-right" size={14} /></span>
          </a>
          <a href="/contact" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="phone" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Contact us</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">Questions about visa documents? Reach us on WhatsApp, phone, or email.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">Get in touch <Icon name="arrow-right" size={14} /></span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── READY TO START CARD ──────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      variant="light"
      eyebrow="Ready to start?"
      headline="Begin with a hospital invitation letter"
      body="Share your diagnosis and we will coordinate the hospital invitation letter and full visa document checklist for your country — usually within 24–48 hours."
      primaryCta={{ label: 'Get free second opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Get a free quote', href: whatsappInquiryHref }}
    />

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Questions about your visa eligibility?"
      body="Tell us your country and treatment type — we will confirm the visa pathway, processing time, and documents required for your specific case."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
