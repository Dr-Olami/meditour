---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../design-system/components/organisms/Navbar';
import { Footer } from '../../design-system/components/organisms/Footer';
import { Icon } from '../../design-system/components/atoms/Icon';
import Breadcrumb from '../../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../lib/i18n';
import { getNavLinks } from '../../lib/navigation';
import { getFooterLegalLinks } from '../../lib/footer';
import { medicalBusiness, breadcrumbs } from '../../lib/schema';
import { getTopCountryProcedureLinks } from '../../lib/country-procedure-links';
import {
  getCountriesGroupedByRegion,
  getRegionLabel,
  getCountryCount,
  getCountryOgImage,
  getFlagUrl,
} from '../../data/countries';
import type { Region } from '../../data/countries';

// Reason: Phase 3 generates country-procedure pages for all 68 procedures
// for all 31 countries. Showing top procedure links directly on the country
// cards gives users a 2-click path to procedure-specific country content.
const DEFAULT_PROCEDURES = [
  { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
  { name: 'IVF', slug: 'ivf-treatment-in-india' },
  { name: 'Knee Replacement', slug: 'total-knee-replacement-in-india' },
];
const TOP_PROCEDURES_BY_COUNTRY: Record<string, { name: string; slug: string }[]> = {
  nigeria: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
    { name: 'Kidney Transplant', slug: 'kidney-transplant-in-india' },
  ],
  bangladesh: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
    { name: 'Knee Replacement', slug: 'total-knee-replacement-in-india' },
  ],
  uae: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Bone Marrow Transplant', slug: 'bone-marrow-transplant-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
  ],
  'saudi-arabia': [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Chemotherapy', slug: 'chemotherapy-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
  ],
  kenya: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Knee Replacement', slug: 'total-knee-replacement-in-india' },
    { name: 'Kidney Transplant', slug: 'kidney-transplant-in-india' },
  ],
  iraq: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Cancer Surgery', slug: 'cancer-surgery-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
  ],
  sudan: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Chemotherapy', slug: 'chemotherapy-in-india' },
    { name: 'Kidney Transplant', slug: 'kidney-transplant-in-india' },
  ],
  uganda: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Cancer Surgery', slug: 'cancer-surgery-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
  ],
  oman: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
    { name: 'Knee Replacement', slug: 'total-knee-replacement-in-india' },
  ],
  yemen: [
    { name: 'Heart Bypass', slug: 'heart-bypass-surgery-cabg-in-india' },
    { name: 'Chemotherapy', slug: 'chemotherapy-in-india' },
    { name: 'IVF', slug: 'ivf-treatment-in-india' },
  ],
  // Phase 3 additions — use default top procedures for new countries
  afghanistan: DEFAULT_PROCEDURES,
  nepal: DEFAULT_PROCEDURES,
  'sri-lanka': DEFAULT_PROCEDURES,
  maldives: DEFAULT_PROCEDURES,
  kuwait: DEFAULT_PROCEDURES,
  qatar: DEFAULT_PROCEDURES,
  bahrain: DEFAULT_PROCEDURES,
  egypt: DEFAULT_PROCEDURES,
  iran: DEFAULT_PROCEDURES,
  jordan: DEFAULT_PROCEDURES,
  ghana: DEFAULT_PROCEDURES,
  ethiopia: DEFAULT_PROCEDURES,
  tanzania: DEFAULT_PROCEDURES,
  cameroon: DEFAULT_PROCEDURES,
  rwanda: DEFAULT_PROCEDURES,
  zimbabwe: DEFAULT_PROCEDURES,
  usa: DEFAULT_PROCEDURES,
  uk: DEFAULT_PROCEDURES,
  canada: DEFAULT_PROCEDURES,
  australia: DEFAULT_PROCEDURES,
  kazakhstan: DEFAULT_PROCEDURES,
};

const locale = 'en';
const t = getTranslations(locale);

const countriesByRegion = getCountriesGroupedByRegion();
const totalCountries = getCountryCount();
const popularLinks = getTopCountryProcedureLinks('en', 24);

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com';

const jsonLd = [
  medicalBusiness({
    name: t.site.name,
    url: siteUrl,
    whatsapp: whatsappNumber,
    email: contactEmail,
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Countries', url: `${siteUrl}/countries/` },
  ]),
];
---

<Layout
  title={`Countries We Serve | ${t.site.name}`}
  description={`Khan Meditour serves patients from ${totalCountries} countries across South Asia, Middle East, Africa, and Western nations. Find country-specific medical tourism guidance, cost comparisons, and visa information.`}
  locale={locale}
  jsonLd={jsonLd}
>
  {
    /* Reason: /bn/countries now exists as a real Bengali directory page, so
      the language switcher preserves the path and hreflang="bn" is emitted. */
  }
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '#contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-indigo-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Countries' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            {totalCountries} Countries
          </span>

          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl"
            data-anim="headline-reveal"
          >
            Countries we serve
          </h1>

          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            Khan Meditour serves patients from {totalCountries} countries across South Asia, the Middle
            East, Africa, and Western nations. Find country-specific medical tourism guidance, cost comparisons,
            visa information, and patient stories.
          </p>
        </div>
      </div>
    </section>

    {/* ── COUNTRY DIRECTORY ────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20">
      <div class="container">
        {
          (Object.entries(countriesByRegion) as [Region, (typeof countriesByRegion)[Region]][]).map(
            ([region, countries]) => (
              <div class="mb-14 last:mb-0" data-anim="scroll-reveal">
                <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">
                  {getRegionLabel(region)}
                </h2>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {countries.map((country) => (
                    <div class="group relative flex flex-col overflow-hidden rounded-card border border-cream-300 bg-cream-100 transition-all hover:shadow-base">
                      {/* Card image — country-specific when available, OG image fallback */}
                      <a
                        href={`/countries/${country.slug}`}
                        class="block aspect-[16/10] overflow-hidden bg-cream-200"
                      >
                        <img
                          src={country.cardImage || getCountryOgImage(country)}
                          alt={`Medical treatment in India for ${country.nationality} patients`}
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                          loading="lazy"
                        />
                      </a>

                      <div class="flex flex-1 flex-col p-5">
                        {/* Flag + country label */}
                        <div class="flex items-center gap-2">
                          <img
                            src={getFlagUrl(country.flagCode)}
                            alt={`${country.name} flag`}
                            class="h-3.5 w-[18px] rounded-[2px]"
                            loading="lazy"
                          />
                          <span class="text-ink/50 text-xs font-semibold uppercase tracking-wide">
                            {country.name}
                          </span>
                        </div>

                        {/* Heading — links to country page */}
                        <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-ink">
                          <a
                            href={`/countries/${country.slug}`}
                            class="after:absolute after:inset-0 after:content-[''] hover:text-violet-700"
                          >
                            Medical Treatment in India for {country.nationality} Patients
                          </a>
                        </h3>

                        {/* Excerpt */}
                        <p class="text-ink/60 mt-2 line-clamp-3 flex-1 text-sm leading-relaxed">
                          {country.introParagraph}
                        </p>

                        {/* Footer: savings + arrow */}
                        <div class="mt-4 flex items-center justify-between">
                          <span class="text-xs font-semibold text-violet-600">
                            Save {country.costSavingsVsLocal} · {country.flightTime}
                          </span>
                          <Icon
                            name="arrow-right"
                            size={16}
                            className="text-ink/40 transition-all group-hover:translate-x-0.5 group-hover:text-violet-600"
                          />
                        </div>

                        {/* Top procedures for Phase 1 countries */}
                        {TOP_PROCEDURES_BY_COUNTRY[country.slug] && (
                          <div class="relative mt-4 border-t border-cream-300 pt-3">
                            <p class="text-ink/40 mb-2 text-xs font-medium uppercase tracking-wide">
                              Top procedures
                            </p>
                            <div class="flex flex-wrap gap-2">
                              {TOP_PROCEDURES_BY_COUNTRY[country.slug].map((proc) => (
                                <a
                                  href={`/countries/${country.slug}/${proc.slug}`}
                                  class="text-ink/70 relative z-10 rounded-full bg-cream-200 px-3 py-1 text-xs font-medium transition-colors hover:bg-violet-100 hover:text-violet-700"
                                >
                                  {proc.name}
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )
          )
        }
      </div>
    </section>

    {/* ── CTA ──────────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Not sure which guide fits your case?"
      body="Tell us your country and the treatment you need. We'll send you the right guide, a cost estimate, and visa steps — free, on WhatsApp."
      primaryCta={{ label: 'Get Free Second Opinion', href: '/second-opinion' }}
      secondaryCta={{ label: 'Chat on WhatsApp', href: `https://wa.me/${whatsappNumber}` }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
    popularLinksTitle="Popular treatments by country"
    popularLinks={popularLinks}
  />
</Layout>
