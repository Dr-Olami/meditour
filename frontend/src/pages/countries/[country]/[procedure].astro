                  <p class="mt-1 text-xs text-ink/60">{city.flightTime}</p>
                  <p class="mt-1 text-xs text-ink/50">{city.directFlights ? 'Direct' : 'Connecting'} · {city.airlines.join(', ')}</p>
                  <div class="mt-2 flex flex-wrap gap-1">
                    {city.specialties.map((s) => (
                      <span class="rounded-full bg-cream-200 px-2 py-0.5 text-xs text-ink/70">{s}</span>
