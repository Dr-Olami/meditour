      body={pc.shareReports}
      primaryCta={{ label: pc.getFreeQuote, href: procedureWhatsAppHref || '#contact' }}
      secondaryCta={{ label: pc.whatsappUs, href: procedureWhatsAppHref || '#contact' }}
    />

    {/* ── CONTACT / LEAD FORM ───────────────────────────────────────────── */}
    <section id="contact" class="bg-cream-200 py-16 md:py-20">
      <div class="container max-w-xl">
        <LeadForm
          treatments={treatmentOptions}
          source={LEAD_SOURCE.PROCEDURE_COUNTRY_PAGE}
          defaultTreatment={procedure.name}
          client:visible
        />
      </div>
    </section>
  </main>

  {/* ── FLOATING CTAs ──────────────────────────────────────────────────────── */}
  <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
    {procedureWhatsAppHref && (
      <a
        href={procedureWhatsAppHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat on WhatsApp"
        class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-green-600 text-white shadow-xl transition-all hover:scale-105 hover:bg-green-700 hover:shadow-2xl md:h-auto md:w-auto md:gap-2 md:px-5 md:py-3"
      >
        <Icon name="whatsapp" size={16} />
        <span class="hidden text-sm font-semibold md:inline">{pc.whatsappUs}</span>
      </a>
    )}
    <a
      href="#contact"
      class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-accent px-5 py-3 text-sm font-semibold text-white shadow-xl transition-all hover:scale-105 hover:shadow-2xl"
    >
      <Icon name="mail" size={16} />
      <span class="md:hidden">{pc.getFreeQuote}</span>
      <span class="hidden md:inline">{pc.getFreeQuote}</span>
    </a>
  </div>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks('en')}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
    popularLinksTitle="Popular treatments by country"
