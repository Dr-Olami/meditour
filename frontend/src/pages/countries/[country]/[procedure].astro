              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    {/* ── CULTURAL CONSIDERATIONS ───────────────────────────────────────── */}
    {(countryData.culturalConsiderations.length > 0 || countryData.languages.length > 0) && (
      <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container max-w-3xl">
          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.culturalConsiderations)}</h2>
          <div class="flex flex-wrap gap-3">
            {countryData.culturalConsiderations.map((item) => (
              <span class="inline-flex items-center gap-2 rounded-card border border-cream-300 bg-white px-4 py-2 text-sm text-ink/70">
                <Icon name="check" size={16} class="text-green-600" />
                {item}
              </span>
            ))}
            {countryData.languages.map((lang) => (
              <span class="inline-flex items-center gap-2 rounded-card border border-cream-300 bg-white px-4 py-2 text-sm text-ink/70">
                <Icon name="globe" size={16} class="text-violet-600" />
                {lang}
              </span>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ── RECOMMENDED HOSPITALS ─────────────────────────────────────────── */}
    {relatedHospitals.length > 0 && (
