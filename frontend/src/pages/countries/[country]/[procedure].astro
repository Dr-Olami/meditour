          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-green-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem1Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem1Desc}</p>
              </div>
            </div>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem2Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem2Desc}</p>
              </div>
            </div>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem3Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem3Desc}</p>
              </div>
            </div>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem4Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem4Desc}</p>
              </div>
            </div>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem5Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem5Desc}</p>
              </div>
            </div>
          </div>
          <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
            <div class="flex items-start gap-3">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-green-600" />
              <div>
                <p class="text-sm font-semibold text-ink">{t.treatments.detail.packageQuoteItem6Label}</p>
                <p class="mt-1 text-sm text-ink/60">{t.treatments.detail.packageQuoteItem6Desc}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
