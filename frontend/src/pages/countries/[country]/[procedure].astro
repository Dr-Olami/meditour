    {/* ── RECOMMENDED DOCTORS ───────────────────────────────────────────── */}
    {doctorCards.length > 0 && (
      <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container">
          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.recommendedDoctors)}</h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {doctorCards.map((doctor) => (
              <DoctorCard doctor={doctor} imageAlt={`${doctor.name} — ${procedure.name} specialist for ${countryData.nationality} patients`} />
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ── WHAT'S INCLUDED ───────────────────────────────────────────────── */}
