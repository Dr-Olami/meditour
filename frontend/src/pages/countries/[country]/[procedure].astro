                {hospital.image && (
                  <div class="aspect-[16/10] overflow-hidden bg-cream-200">
                    <img
                      src={hospital.image}
                      alt={`${hospital.name} for ${procedure.name} in India — ${countryData.nationality} patients`}
                      class="h-full w-full object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
