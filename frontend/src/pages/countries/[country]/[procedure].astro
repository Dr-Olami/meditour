---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../design-system/components/organisms/Navbar';
import { Footer } from '../../../design-system/components/organisms/Footer';
import { DoctorCard } from '../../../design-system/components/organisms/DoctorCard';
import { LeadForm } from '../../../design-system/components/organisms/LeadForm';
import { FAQAccordion } from '../../../design-system/components/organisms/FAQAccordion';
import { Icon } from '../../../design-system/components/atoms/Icon';
import Breadcrumb from '../../../design-system/components/molecules/Breadcrumb.astro';
import { QuickFacts } from '../../../design-system/components/molecules/QuickFacts';
import type { QuickFactItem } from '../../../design-system/components/molecules/QuickFacts';
import TreatmentsCtaSection from '../../../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../../../lib/i18n';
import { getNavLinks } from '../../../lib/navigation';
import { getFooterLegalLinks } from '../../../lib/footer';
import {
  getProcedures,
  getDoctors,
  getHospitals,
  getTreatments,
  resolveRelatedDoctors,
  resolveHospital,
  resolveRelatedHospitals,
  resolveRelatedProcedures,
  entrySlug,
} from '../../../lib/content';
import { medicalWebPage, faqPage, breadcrumbs } from '../../../lib/schema';
import { getProcedureInquiryLink } from '../../../lib/whatsapp';
import { generateProcedureCountryFaqs } from '../../../lib/procedure-country-faq';
import { convertUsdToLocal, formatWithLocal } from '../../../lib/currency';
import { getCategoryHue } from '../../../lib/treatment-categories';
import type { Doctor } from '../../../design-system/components/organisms/DoctorCard';
import { LEAD_SOURCE } from '../../../lib/crm';
import {
  getCountryMetadata,
  getAllCountrySlugs,
  getFlagUrl,
  ALL_COUNTRIES,
} from '../../../data/countries';
import { hasBnCountryPage } from '../../../data/countries/bn';
import { getTopCountryProcedureLinks } from '../../../lib/country-procedure-links';
import { generateWhyChooseIndia } from '../../../lib/why-choose-india';

export async function getStaticPaths() {
  // ─── Phase 3: All 31 countries × All 68 procedures ────────────────────────
  // Reason: Phase 3 removes the country restriction entirely, generating
  // procedure × country pages for every country in the dataset.
  const [procedures, doctors, hospitals, treatments] = await Promise.all([
    getProcedures('en'),
    getDoctors('en'),
    getHospitals('en'),
    getTreatments('en'),
  ]);

  const paths = [];

  for (const countrySlug of getAllCountrySlugs()) {

    for (const procedureEntry of procedures) {
      const procedureSlug = entrySlug(procedureEntry).split('/').pop()!;

      const parentSlug = procedureEntry.data.parentTreatmentSlug;
      const related = resolveRelatedDoctors(
        procedureEntry.data.relatedDoctorSlugs,
        doctors,
      ).map((d) => {
        const hospital = resolveHospital(d.data.hospitalId, hospitals);
        return {
          name: d.data.name,
          specialty: d.data.specialty,
          qualification: d.data.qualification,
          experienceYears: d.data.experienceYears,
          avatar: d.data.avatar,
          href: `/doctors/${entrySlug(d)}`,
          hospitalName: hospital?.name,
          hospitalHref: hospital?.href,
          whatsappHref: '',
        };
      });
      const relatedHospitals = resolveRelatedHospitals(
        procedureEntry.data.relatedHospitalSlugs,
        hospitals,
      ).map((h) => ({
        name: h.data.name,
        city: h.data.city,
        image: h.data.image,
        href: `/hospitals/${entrySlug(h)}`,
        accreditations: h.data.accreditations,
        description: h.data.description,
      }));
      const relatedProcedures = resolveRelatedProcedures(
        procedureEntry.data.relatedProcedureSlugs,
        procedures,
      )
        .map((p) => ({
          name: p.data.name,
          slug: entrySlug(p).split('/').pop()!,
          parentSlug: p.data.parentTreatmentSlug,
          fromPrice: p.data.fromPrice,
        }));

      // Convert procedure slug: "heart-bypass-surgery-cabg-cost-india" → "heart-bypass-surgery-cabg-in-india"
      const pageSlug = procedureSlug.replace(/-cost-india$/, '-in-india');

      paths.push({
        params: { country: countrySlug, procedure: pageSlug },
        props: {
          countrySlug,
          procedureSlug,
          parentSlug,
          procedure: procedureEntry.data,
          parentTreatment: treatments.find(
            (t) => entrySlug(t) === parentSlug,
          )?.data,
          related,
          relatedHospitals,
          relatedProcedures,
          entry: procedureEntry,
        },
      });
    }
  }

  return paths;
}

const t = getTranslations('en');
const popularLinks = getTopCountryProcedureLinks('en', 24);
const pc = t.procedureCountry;
// Reason: Replace {nationality}, {country}, {procedureName} placeholders in
// i18n heading strings so H2s include the country and procedure name for SEO.
const ph = (s: string) => s
  .replaceAll('{nationality}', countryData.nationality)
  .replaceAll('{country}', countryData.name)
  .replaceAll('{procedureName}', procedure.name);
const {
  countrySlug,
  procedureSlug,
  parentSlug,
  procedure,
  parentTreatment,
  related,
  relatedHospitals,
  relatedProcedures,
  entry,
} = Astro.props;

const countryData = getCountryMetadata(countrySlug);
if (!countryData) {
  throw new Error(`Country not found: ${countrySlug}`);
}


// ─── SEO ────────────────────────────────────────────────────────────────────
// Reason: Spec says "Keep under 60 characters. If too long, shorten procedure
// name." The full pattern "{name} in India for {nationality} Patients | Cost
// from {price}" often exceeds 60 chars. Rather than truncating the procedure
// name (which produces garbage like "Heart Byp…"), we use progressively
// shorter title patterns that preserve the full procedure name.
function buildSeoTitle(name: string, nationality: string, fromPrice: string): string {
  // Remove parentheticals: "Heart Bypass Surgery (CABG)" -> "Heart Bypass Surgery"
  const shortName = name.replace(/\s*\([^)]+\)\s*/g, '').trim();

  // Pattern 1: Full — "{name} in India for {nat} Patients | Cost from {price}"
  const p1 = `${shortName} in India for ${nationality} Patients | Cost from ${fromPrice}`;
  if (p1.length <= 60) return p1;

  // Pattern 2: Drop "Patients" — "{name} in India for {nat} | Cost from {price}"
  const p2 = `${shortName} in India for ${nationality} | Cost from ${fromPrice}`;
  if (p2.length <= 60) return p2;

  // Pattern 3: Drop cost — "{name} in India for {nat} Patients"
  const p3 = `${shortName} in India for ${nationality} Patients`;
  if (p3.length <= 60) return p3;

  // Pattern 4: Compact — "{name} in India for {nat}"
  const p4 = `${shortName} in India for ${nationality}`;
  if (p4.length <= 60) return p4;

  // Pattern 5: Cost only — "{name} Cost in India"
  const p5 = `${shortName} Cost in India`;
  if (p5.length <= 60) return p5;

  // Fallback: hard truncate the procedure name (rare, only for very long names)
  const maxLen = 60 - ' Cost in India'.length;
  return `${shortName.slice(0, maxLen - 1).trimEnd()}\u2026 Cost in India`;
}

// Reason: Spec says "Meta description is under 160 characters." The full
// description pattern often exceeds 160 chars for long procedure names.
// We progressively drop less critical parts, then hard-truncate at sentence
// boundary as a last resort.
function buildSeoDescription(
  name: string,
  nationality: string,
  fromPrice: string,
  savings: string,
  comparisonCountry: string,
  hospitalStay: string,
): string {
  const nat = nationality.toLowerCase();

  // Pattern 1: Full
  const p1 = `${name} in India for ${nat} patients from ${fromPrice}. Save ${savings} vs ${comparisonCountry}. ${hospitalStay} hospital stay. Visa support for ${nat} patients.`;
  if (p1.length <= 160) return p1;

  // Pattern 2: Drop the trailing visa sentence
  const p2 = `${name} in India for ${nat} patients from ${fromPrice}. Save ${savings} vs ${comparisonCountry}. ${hospitalStay} hospital stay.`;
  if (p2.length <= 160) return p2;

  // Pattern 3: Drop hospital stay
  const p3 = `${name} in India for ${nat} patients from ${fromPrice}. Save ${savings} vs ${comparisonCountry}.`;
  if (p3.length <= 160) return p3;

  // Pattern 4: Drop comparison country
  const p4 = `${name} in India for ${nat} patients from ${fromPrice}. Save ${savings}.`;
  if (p4.length <= 160) return p4;

  // Pattern 5: Bare minimum
  const p5 = `${name} in India for ${nat} patients from ${fromPrice}.`;
  if (p5.length <= 160) return p5;

  // Fallback: hard truncate at last word boundary within 157 chars + ellipsis
  const truncated = p5.slice(0, 157);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${truncated.slice(0, lastSpace)}\u2026`;
}

const title = buildSeoTitle(procedure.name, countryData.nationality, procedure.fromPrice);
const headline = `${procedure.name} in India for ${countryData.nationality} Patients`;
const description = buildSeoDescription(
  procedure.name,
  countryData.nationality,
  procedure.fromPrice,
  countryData.costSavingsVsLocal,
  countryData.costComparisonCountries[0],
  procedure.hospitalStay,
);
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();

// ─── "Why choose India" content (data-driven, country-specific) ────────────
const whyChooseContent = generateWhyChooseIndia(
  procedure.name,
  procedure.fromPrice,
  procedure.toPrice,
  countryData,
);

// ─── Currency conversion ───────────────────────────────────────────────────
const { exchangeRate, symbol, code } = countryData.currency;
const fromPriceLocal = procedure.fromPrice
  ? convertUsdToLocal(procedure.fromPrice, exchangeRate, symbol)
  : '';
const toPriceLocal = procedure.toPrice
  ? convertUsdToLocal(procedure.toPrice, exchangeRate, symbol)
  : '';
const priceRangeUsd =
  procedure.fromPrice && procedure.toPrice
    ? `${procedure.fromPrice}–${procedure.toPrice}`
    : procedure.fromPrice || '';
const priceRangeLocal = fromPriceLocal && toPriceLocal ? `${fromPriceLocal}–${toPriceLocal}` : fromPriceLocal;

// ─── FAQs ───────────────────────────────────────────────────────────────────
const faqs = generateProcedureCountryFaqs(procedure, countryData);

// ─── JSON-LD ────────────────────────────────────────────────────────────────
const jsonLd = [
  medicalWebPage({
    name: headline,
    url: pageUrl,
    description,
    inLanguage: 'en',
    audience: `${countryData.nationality} patients seeking ${procedure.name} in India`,
  }),
  faqPage({ entries: faqs }),
  breadcrumbs([
    { name: t.nav.home, url: new URL('/', Astro.url.origin).toString() },
    { name: 'Countries', url: new URL('/countries/', Astro.url.origin).toString() },
    { name: countryData.name, url: new URL(`/countries/${countrySlug}`, Astro.url.origin).toString() },
    { name: `${procedure.name} in India`, url: pageUrl },
  ]),
];

// ─── Quick facts ────────────────────────────────────────────────────────────
const quickFacts: QuickFactItem[] = [
  ...(procedure.duration ? [{ icon: 'clock' as const, label: pc.durationLabel, value: procedure.duration }] : []),
  ...(procedure.hospitalStay ? [{ icon: 'building' as const, label: pc.stayLabel, value: procedure.hospitalStay }] : []),
  ...(procedure.recoveryTime ? [{ icon: 'heart-pulse' as const, label: pc.recoveryLabel, value: procedure.recoveryTime }] : []),
  ...(priceRangeUsd ? [{ icon: 'tag' as const, label: pc.priceLabel, value: priceRangeUsd }] : []),
  ...(countryData.flightTime ? [{ icon: 'plane' as const, label: pc.flightTimeLabel, value: countryData.flightTime }] : []),
];

// ─── WhatsApp ───────────────────────────────────────────────────────────────
const procedureWhatsAppHref = getProcedureInquiryLink(procedure.name, {
  costRange: priceRangeUsd,
  recoveryTime: procedure.recoveryTime,
});

// ─── Treatment options for lead form ────────────────────────────────────────
const allTreatments = await getTreatments('en');
const treatmentOptions = allTreatments.map((e) => ({
  value: e.data.name,
  label: e.data.name,
}));

// ─── Related procedure × country links ──────────────────────────────────────
const relatedProcCountryLinks = relatedProcedures.map((rp) => ({
  name: rp.name,
  href: `/countries/${countrySlug}/${rp.slug.replace(/-cost-india$/, '-in-india')}`,
  fromPrice: rp.fromPrice,
}));

// ─── Hue for category styling ───────────────────────────────────────────────
const hue = getCategoryHue(parentTreatment?.category);

// ─── BN alternate ───────────────────────────────────────────────────────────
const bnAlternate = hasBnCountryPage(countrySlug);

// ─── Doctor type mapping ────────────────────────────────────────────────────
const doctorCards: Doctor[] = related.map((d) => ({
  name: d.name,
  specialty: d.specialty,
  qualification: d.qualification,
  experienceYears: d.experienceYears,
  avatar: d.avatar,
  href: d.href,
  hospitalName: d.hospitalName,
  hospitalHref: d.hospitalHref,
  whatsappHref: d.whatsappHref || undefined,
}));
---

<Layout title={title} description={description} locale="en" image={procedure.image} jsonLd={jsonLd} bnAlternate={bnAlternate}>
  <Navbar
    brand={t.site.name}
    links={getNavLinks('en')}
    cta={{ label: t.nav.cta, href: '#contact' }}
    locale="en"
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER}`}
    whatsappLabel={t.nav.whatsapp}
    localeFallbacks={bnAlternate ? undefined : { bn: '/bn' }}
    client:load
  />

  <main class="pt-20">
    {/* ── BREADCRUMB ─────────────────────────────────────────────────────── */}
    <div class="bg-white py-4">
      <div class="container">
        <Breadcrumb
          items={[
            { label: t.nav.home, href: '/' },
            { label: 'Countries', href: '/countries/' },
            { label: countryData.name, href: `/countries/${countrySlug}` },
            { label: `${procedure.name} in India` },
          ]}
          data-anim="fade-in-up"
        />
      </div>
    </div>

    {/* ── HERO ───────────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-12 md:py-16">
      <div class="container">
        <div class="mx-auto max-w-4xl" data-anim="stagger-children">
          {/* Country badge with flag */}
          <span class="inline-flex items-center gap-2 rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white shadow-lg">
            <img
              src={getFlagUrl(countryData.flagCode)}
              alt={`${countryData.name} flag — ${procedure.name} in India for ${countryData.nationality} patients`}
              class="h-4 w-5 rounded-[2px]"
              loading="eager"
            />
            For {countryData.nationality} Patients
          </span>

          {/* H1 */}
          <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl lg:text-5xl">
            {headline}
          </h1>

          {/* Cost badge */}
          {priceRangeUsd && (
            <div class="mt-6 inline-flex items-center gap-3 rounded-card border border-cream-300 bg-white px-5 py-3 shadow-sm">
              <Icon name="tag" size={20} class="text-violet-600" />
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-ink/50">{pc.priceLabel}</p>
                <p class="text-lg font-bold text-ink">{priceRangeUsd} USD</p>
                {priceRangeLocal && (
                  <p class="text-sm text-ink/60">≈ {priceRangeLocal} {code}</p>
                )}
              </div>
            </div>
          )}

          {/* Quick facts */}
          {quickFacts.length > 0 && (
            <div class="mt-6">
              <QuickFacts facts={quickFacts} />
            </div>
          )}

          {/* CTAs */}
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={procedureWhatsAppHref || '#contact'}
              target={procedureWhatsAppHref ? '_blank' : undefined}
              rel={procedureWhatsAppHref ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 rounded-full bg-green-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-green-700 hover:shadow-md"
            >
              <Icon name="whatsapp" size={16} />
              {pc.whatsappUs}
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 rounded-full bg-gradient-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md"
            >
              <Icon name="mail" size={16} />
              {pc.getFreeQuote}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── IN SHORT ───────────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-10 md:py-12">
      <div class="container max-w-3xl">
        <div class="rounded-card border border-cream-300 bg-white p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wide text-violet-600">{pc.inShortLabel}</p>
          <p class="mt-3 text-base leading-relaxed text-ink/80">{procedure.summary}</p>
          {priceRangeUsd && (
            <p class="mt-4 text-sm text-ink/60">
              <strong class="text-ink">{pc.priceLabel}:</strong> {priceRangeUsd} USD
              {priceRangeLocal && ` (≈ ${priceRangeLocal} ${code})`}
              {' · '}
              <strong class="text-ink">{pc.savingsLabel}:</strong> {countryData.costSavingsVsLocal} vs {countryData.costComparisonCountries[0]}
            </p>
          )}
        </div>
      </div>
    </section>

    {/* ── COST IN YOUR CURRENCY ───────────────────────────────────────────── */}
    {priceRangeUsd && (
      <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container max-w-3xl">
          <h2 class="mb-4 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.costInCurrency)}</h2>
          <div class="rounded-card border border-cream-300 bg-white p-6 shadow-sm">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-ink/50">USD</p>
                <p class="mt-1 text-xl font-bold text-ink">{priceRangeUsd}</p>
              </div>
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-ink/50">{code}</p>
                <p class="mt-1 text-xl font-bold text-ink">{priceRangeLocal}</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-ink/50">
              Exchange rate: 1 USD ≈ {exchangeRate} {code}. Prices in {code} are approximate — request a written quote for the current price.
            </p>
          </div>
        </div>
      </section>
    )}

    {/* ── COST COMPARISON ────────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-4xl">
        <h2 class="mb-4 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.costComparisonTitle)}</h2>
        <p class="mb-6 text-sm text-ink/60">{pc.costComparisonNote}</p>
        <div class="overflow-x-auto rounded-card border border-cream-300 bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-cream-300 bg-cream-100">
                <th class="px-4 py-3 text-left font-semibold text-ink">Country</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">Cost</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">vs India</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-cream-300">
                <td class="px-4 py-3 text-ink">India (Bangalore)</td>
                <td class="px-4 py-3 font-semibold text-ink">{priceRangeUsd}</td>
                <td class="px-4 py-3 text-ink/60">Baseline</td>
              </tr>
              <tr class="border-b border-cream-300">
                <td class="px-4 py-3 text-ink">{countryData.costComparisonCountries[0]}</td>
                <td class="px-4 py-3 text-ink/70">Higher</td>
                <td class="px-4 py-3 font-semibold text-green-600">{countryData.costSavingsVsLocal} less</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-ink">USA</td>
                <td class="px-4 py-3 text-ink/70">Significantly higher</td>
                <td class="px-4 py-3 text-ink/60">Reference</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── WHO IS THIS FOR? ───────────────────────────────────────────────── */}
    {procedure.eligibility && procedure.eligibility.length > 0 && (
      <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container max-w-3xl">
          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.whoIsThisFor)}</h2>
          <ul class="space-y-3">
            {procedure.eligibility.map((item) => (
              <li class="flex items-start gap-2 text-sm text-ink/70">
                <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-violet-600" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* ── PROCEDURE OVERVIEW (summary + link to canonical page) ─────────── */}
    <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-3xl">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.procedureOverview)}</h2>
        <p class="text-base leading-relaxed text-ink/70">{procedure.description}</p>
        <a
          href={`/treatments/${parentSlug}/${procedureSlug}`}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-violet-600 shadow-sm transition-all hover:shadow-md"
        >
          Read the full {procedure.name} guide
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </section>

    {/* ── WHAT HAPPENS DURING ───────────────────────────────────────────── */}
    <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
      <div class="container max-w-3xl">
        <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.whatHappensDuring)}</h2>
        <div class="space-y-4 text-base leading-relaxed text-ink/70">
          <p>
            {procedure.name} is performed under appropriate anesthesia by an experienced surgical team at a JCI/NABH-accredited hospital in Bangalore.
            {procedure.duration && ` The procedure itself typically takes ${procedure.duration.toLowerCase()}.`}
            {procedure.hospitalStay && ` After the procedure, you will stay in the hospital for ${procedure.hospitalStay.toLowerCase()} for monitoring and initial recovery.`}
          </p>
          <p>
            Your surgical team will explain the specific steps of your procedure, the anesthesia approach, and what to expect during your hospital stay before you provide consent. The exact technique and duration vary based on your individual condition and case complexity.
          </p>
          <p class="rounded-card bg-cream-200 p-4 text-sm text-ink/60">
            For a detailed step-by-step explanation of the procedure, anesthesia, and what you will experience, see the full <a href={`/treatments/${parentSlug}/${procedureSlug}`} class="font-semibold text-violet-600 underline">{procedure.name} guide</a>.
          </p>
        </div>
      </div>
    </section>

    {/* ── RECOVERY & FIT-TO-FLY ──────────────────────────────────────────── */}
    {procedure.recoveryTimeline && procedure.recoveryTimeline.length > 0 && (
      <section class="bg-cream-100 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container max-w-3xl">
          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{ph(pc.recoveryAndFitToFly)}</h2>
          <div class="overflow-x-auto rounded-card border border-cream-300 bg-white shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-cream-300 bg-cream-100">
                  <th class="px-4 py-3 text-left font-semibold text-ink">Phase</th>
                  <th class="px-4 py-3 text-left font-semibold text-ink">Duration</th>
                  <th class="px-4 py-3 text-left font-semibold text-ink">What to expect</th>
                </tr>
              </thead>
              <tbody>
                {procedure.recoveryTimeline.map((phase) => (
