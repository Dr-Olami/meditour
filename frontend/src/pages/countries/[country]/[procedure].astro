            <li class="flex items-start gap-2 text-sm text-ink/70">
              <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-violet-600" />
              <span>{t.treatments.detail.decisionFrameworkItem8}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* ── FAQ ───────────────────────────────────────────────────────────── */}
    {faqs.length > 0 && (
      <section class="bg-cream-200 py-12 md:py-16" data-anim="fade-in-up">
        <div class="container max-w-3xl">
          <h2 class="mb-8 text-center font-display text-2xl font-bold text-ink md:text-3xl">{pc.faqTitle}</h2>
          <FAQAccordion items={faqs} client:visible />
        </div>
      </section>
    )}

    {/* ── RELATED PROCEDURES ────────────────────────────────────────────── */}
