            {procedure.costExclusions && procedure.costExclusions.length > 0 && (
              <div class="rounded-card border border-cream-300 bg-white p-5 shadow-sm">
                <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-ink">
                  <Icon name="x" size={18} class="text-amber-600" />
                  {pc.notIncludedLabel}
                </h3>
                <ul class="space-y-2">
                  {procedure.costExclusions.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-ink/70">
                      <Icon name="x" size={14} class="mt-1 shrink-0 text-amber-600" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ── HOW TO READ YOUR PACKAGE QUOTE ──────────────────────────────── */}
