          <h2 class="mb-6 font-display text-2xl font-bold text-ink md:text-3xl">{pc.whatsIncluded}</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {procedure.costInclusions && procedure.costInclusions.length > 0 && (
