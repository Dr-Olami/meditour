---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getHospitals, entrySlug } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const hospitals = await getHospitals(locale);
const hospitalAccreditations = hospitals
  .filter((h) => h.data.accreditations && h.data.accreditations.length > 0)
  .map((h) => ({
    name: h.data.name,
    slug: entrySlug(h),
    city: h.data.city,
    accreditations: h.data.accreditations!,
  }));

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/accreditations-certifications`;

const accreditations = [
  {
    abbr: 'JCI',
    full: 'Joint Commission International',
    origin: 'USA',
    color: 'bg-blue-600',
    description: 'The global arm of the Joint Commission — the same body that accredits Johns Hopkins, Mayo Clinic, and Cleveland Clinic in the United States. JCI surveys hospitals against more than 1,400 measurable elements covering patient safety, infection control, surgical safety, medication management, and patient rights.',
    whatItMeans: [
      'Hospital meets the same standards as top US hospitals',
      'Rigorous on-site surveys every 3 years',
      'Focus on patient safety and clinical process quality',
      'Internationally recognised as the gold standard',
    ],
    indiaCount: '40+ JCI-accredited hospitals in India',
    verifyLabel: 'Verify on JCI official site',
    verifyUrl: 'https://www.jointcommission.org/en',
  },
  {
    abbr: 'NABH',
    full: 'National Accreditation Board for Hospitals & Healthcare Providers',
    origin: 'India (ISQua recognised)',
    color: 'bg-violet-600',
    description: 'NABH is the Indian accreditation body for hospitals, recognised by the International Society for Quality in Health Care (ISQua). It sets standards for clinical care, patient safety, hospital infrastructure, and staff qualifications. NABH accreditation is a mark of a well-run hospital that meets documented quality benchmarks.',
    whatItMeans: [
      'Documented standards for clinical and non-clinical processes',
      'Regular surveillance audits to maintain accreditation',
      'ISQua recognition means standards meet global benchmarks',
      'Required by many insurers for cashless treatment',
    ],
    indiaCount: '500+ NABH-accredited hospitals in India',
    verifyLabel: 'Verify on NABH official site',
    verifyUrl: 'https://nabh.co/',
  },
  {
    abbr: 'NABL',
    full: 'National Accreditation Board for Testing and Calibration Laboratories',
    origin: 'India (ILAC MRA)',
    color: 'bg-green-600',
    description: 'NABL accredits diagnostic laboratories that meet ISO 15189 standards for medical laboratories. A NABL-accredited lab means your blood tests, biopsies, and imaging reports are processed to internationally accepted accuracy and quality levels — critical for correct diagnosis and treatment planning.',
    whatItMeans: [
      'Labs meet ISO 15189 international standard',
      'Equipment calibrated and tested regularly',
      'Reports accepted by hospitals worldwide',
      'Reduces risk of diagnostic errors',
    ],
    indiaCount: 'Thousands of NABL-accredited labs across India',
    verifyLabel: 'Verify on NABL official site',
    verifyUrl: 'https://nabl-india.org/',
  },
];

const faqs = [
  {
    question: 'Why do hospital accreditations matter for medical tourists?',
    answer: 'Accreditations are an independent verification that a hospital meets documented quality and safety standards. For medical tourists who cannot visit a hospital before travelling, accreditations like JCI and NABH provide assurance that the hospital follows the same protocols as top hospitals in your home country — for surgery, infection control, medication safety, and patient rights.',
  },
  {
    question: 'Is JCI accreditation the same as what US hospitals have?',
    answer: 'JCI is the international arm of the Joint Commission, which accredits most major US hospitals. The standards are closely aligned, though JCI includes additional criteria for international patients such as language access, medical record translation, and cross-border care coordination. A JCI-accredited hospital in India meets the same core standards as a Joint Commission-accredited hospital in the US.',
  },
  {
    question: 'What does NABH accreditation mean for my treatment?',
    answer: 'NABH accreditation means the hospital has been independently assessed against standards for clinical care, patient safety, infrastructure, and staff qualifications. It is recognised by the International Society for Quality in Health Care (ISQua), so the standards meet global benchmarks. Many Indian insurers also require NABH for cashless treatment, which can simplify your billing process.',
  },
  {
    question: 'Do all hospitals in India have these accreditations?',
    answer: 'No. Only a minority of Indian hospitals are JCI or NABH accredited. We only work with accredited hospitals because accreditation is the most reliable independent signal of quality and safety. When we share hospital options with you, we include the accreditation status of each hospital so you can make an informed choice.',
  },
  {
    question: 'Can I verify a hospital\'s accreditation myself?',
    answer: 'Yes. JCI maintains a public directory of accredited organisations on its website. NABH and NABL also have searchable directories. We share the accreditation details of every hospital we recommend, and you are welcome to verify them independently before committing to treatment.',
  },
  {
    question: 'What about doctor qualifications — are those accredited too?',
    answer: 'Doctor qualifications are verified through medical council registration rather than accreditation. Indian doctors must be registered with the Medical Council of India or state medical councils. Many of our partner doctors also hold fellowships or certifications from US, UK, or German institutions. We share each doctor\'s qualifications and training history on their profile page.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Accreditations & Certifications',
    url: pageUrl,
    description: 'Understand JCI, NABH, and NABL accreditations — what the badges mean for your care when choosing a hospital in India for medical treatment.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Accreditations', url: `${pageUrl}/` },
  ]),
];
---

<Layout
  title={`Accreditations & Certifications | ${t.site.name}`}
  description="Understand JCI, NABH, and NABL accreditations — what the badges mean for your care when choosing a hospital in India for medical treatment."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-blue-600/5 blur-3xl" aria-hidden="true" />

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Accreditations' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white">
            Quality standards
          </span>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl" data-anim="headline-reveal">
            JCI, NABH, and NABL — what the badges mean for your care
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">
            When you travel for treatment, you need to know the hospital meets international quality standards. Here is what each accreditation means — and why we only work with accredited hospitals.
          </p>
        </div>
      </div>
    </section>

    {/* ── ACCREDITATION CARDS ──────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="space-y-6">
          {accreditations.map((acc) => (
            <div class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8" data-anim="fade-in-up">
              <div class="grid gap-6 lg:grid-cols-[auto_1fr] lg:gap-8">
                {/* Badge */}
                <div class="flex flex-col items-start gap-3">
                  <span class={`inline-flex items-center justify-center rounded-2xl ${acc.color} px-5 py-3 font-display text-2xl font-bold text-white shadow-base`}>
                    {acc.abbr}
                  </span>
                  <span class="rounded-full bg-cream-200 px-3 py-1 text-xs font-medium text-ink/60">
                    {acc.origin}
                  </span>
                </div>

                {/* Content */}
                <div>
                  <h2 class="font-display text-xl font-bold text-ink">{acc.full}</h2>
                  <p class="mt-3 text-sm leading-relaxed text-ink/70">
                    {acc.description}
                  </p>

                  {/* What it means */}
                  <div class="mt-5">
                    <p class="text-xs font-semibold uppercase tracking-widest text-ink">
                      What it means for you
                    </p>
                    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                      {acc.whatItMeans.map((item) => (
                        <li class="flex items-start gap-2 text-sm text-ink/70">
                          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10 text-violet-600">
                            <Icon name="check" size={12} className="text-violet-600" />
                          </span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-cream-200 px-3 py-1.5 text-xs font-semibold text-ink/70">
                    <Icon name="globe" size={12} className="text-ink/50" />
                    {acc.indiaCount}
                  </p>

                  <a
                    href={acc.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
                  >
                    {acc.verifyLabel}
                    <Icon name="arrow-right" size={14} />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── OUR ACCREDITED HOSPITALS ─────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Our accredited partner hospitals
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Every hospital we recommend holds at least one of these accreditations. Here are our partner hospitals in Bangalore and their accreditation status.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {hospitalAccreditations.map((h) => (
            <a href={`/hospitals/${h.slug}`} class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
              <h3 class="font-display text-base font-bold text-ink">{h.name}</h3>
              <p class="mt-1 text-xs text-ink/50">{h.city}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {h.accreditations.map((acc) => (
                  <span class="inline-flex items-center gap-1 rounded-full bg-cream-200 px-2.5 py-1 text-xs font-semibold text-ink/70">
                    <Icon name="check" size={10} className="text-violet-600" />
                    {acc}
                  </span>
                ))}
              </div>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
                View hospital
                <Icon name="arrow-right" size={14} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ── INTERNAL LINKS ───────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <h2 class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Explore further
        </h2>
        <p class="mb-10 max-w-2xl text-sm text-ink/60" data-anim="fade-in-up">
          Learn more about hospital quality, treatment costs, and the patient journey.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/hospitals" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="hospital" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Compare hospitals</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              See specialties, infrastructure, and accreditation status for each of our partner hospitals in Bangalore.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              View hospitals
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          <a href="/why-india-for-medical-treatment" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="globe" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Why India</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Understand why India is a global leader in medical tourism — cost savings, accredited hospitals, and experienced specialists.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Read more
              <Icon name="arrow-right" size={14} />
            </span>
          </a>

          <a href="/cost-calculator" class="group rounded-card border border-cream-300 bg-cream-100 p-6 transition-shadow hover:shadow-base" data-anim="fade-in-up">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-violet-600/10">
                <Icon name="stethoscope" size={20} className="text-violet-600" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Cost calculator</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">
              Get indicative cost ranges for your treatment at accredited hospitals in India.
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
              Estimate costs
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-3xl">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-ink md:text-4xl" data-anim="fade-in-up">
          Frequently asked questions
        </h2>
        <FAQAccordion items={faqs} client:visible />
      </div>
    </section>

    {/* ── CTA ──────────────────────────────────────────────────────── */}
    <TreatmentsCtaSection
      locale="en"
      eyebrow="We're here to help"
      headline="Want to verify a hospital's accreditation?"
      body="We share the accreditation status of every hospital we recommend. Tell us your treatment type and we will match you with accredited hospitals that fit your needs."
      primaryCta={{ label: 'Get free quote', href: whatsappInquiryHref }}
      secondaryCta={{ label: 'Contact us', href: '/contact' }}
      tertiaryCta={{ label: 'WhatsApp us', href: whatsappInquiryHref }}
    />
  </main>

  <Footer
    brand={t.site.name}
    legalLinks={getFooterLegalLinks(locale)}
    conciergeLabel={t.footer.concierge}
    conciergePrefix={t.footer.conciergePrefix}
    conciergeSuffix={t.footer.conciergeSuffix}
    copyright={`© ${new Date().getFullYear()} ${t.site.name}. ${t.footer.rights}`}
    address={t.footer.address}
  />
</Layout>
