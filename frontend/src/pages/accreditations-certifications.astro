---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import TreatmentsCtaSection from '../design-system/components/organisms/TreatmentsCtaSection.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getHospitals, entrySlug } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { medicalWebPage, breadcrumbs, faqPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const hospitals = await getHospitals(locale);
const hospitalAccreditations = hospitals
  .filter((h) => h.data.accreditations && h.data.accreditations.length > 0)
  .map((h) => ({
    name: h.data.name,
    slug: entrySlug(h),
    city: h.data.city,
    accreditations: h.data.accreditations!,
  }));

// Verified JCI-accredited hospitals in Bengaluru (Bangalore).
// Sources: JCI / India Healthcare Tourism official list (55 hospitals, 2024)
// and The Hindu + IndiaMedToday (Ramaiah Memorial, June 2025).
// Accreditation status changes — patients should re-verify via the JCI directory.
const partnerSlugs = new Set(hospitalAccreditations.map((h) => h.slug));
const bangaloreJciHospitals = [
  {
    name: 'Apollo Hospitals, Bannerghatta Road',
    area: 'Bannerghatta Road',
    beds: '250+',
    specialties: 'Multi-specialty — Cardiac, Oncology, Neuro, Ortho, ICU',
    otherAccreditations: 'NABH',
    slug: 'apollo-hospitals-bannerghatta',
  },
  {
    name: 'Fortis Hospital, Bannerghatta Road',
    area: 'Bannerghatta Road',
    beds: '284',
    specialties: 'Multi-specialty — Cardiac, Neuro, Oncology, Ortho, Transplants',
    otherAccreditations: 'NABH, NABL, MTQUA',
    slug: 'fortis-hospital-bannerghatta',
  },
  {
    name: 'Manipal Hospital, Old Airport Road',
    area: 'Old Airport Road',
    beds: '600+',
    specialties: 'Multi-specialty quaternary care',
    otherAccreditations: 'NABH, NABL, AAHRPP, ISO 9001:2015',
    slug: 'manipal-hospital-old-airport-road',
  },
  {
    name: 'Manipal Hospital, Whitefield',
    area: 'Whitefield',
    beds: '280+',
    specialties: 'Multi-specialty — Cardiac, Oncology, Neuro, Ortho',
    otherAccreditations: 'NABH',
    slug: '',
  },
  {
    name: 'Narayana Institute of Cardiac Sciences (Narayana Health City)',
    area: 'Bommasandra',
    beds: '600+',
    specialties: 'Cardiac surgery, interventional cardiology, heart transplant + multi-specialty',
    otherAccreditations: 'NABH',
    slug: 'narayana-institute-cardiac-sciences',
  },
  {
    name: 'Aster CMI Hospital',
    area: 'Hebbal',
    beds: '500+',
    specialties: 'Multi-specialty — Cardiac, Neuro, Oncology, Transplants',
    otherAccreditations: 'NABH',
    slug: '',
  },
  {
    name: 'Ramaiah Memorial Hospital',
    area: 'New BEL Road, MSRIT Post',
    beds: '500',
    specialties: 'Quaternary care multi-super-specialty',
    otherAccreditations: 'NABH, NABL',
    slug: '',
  },
].map((h) => ({ ...h, isPartner: h.slug ? partnerSlugs.has(h.slug) : false }));

// India-wide JCI hospital count by city (indicative, based on the 55-hospital
// 2024 list plus Ramaiah 2025). Counts shift as hospitals gain or lapse —
// re-verify via the JCI directory before relying on these for a decision.
const jciByCity = [
  { city: 'Bengaluru (Bangalore)', count: 7, note: 'Largest JCI cluster in south India' },
  {
    city: 'Delhi NCR (Delhi, Gurugram, Noida)',
    count: 12,
    note: 'Indraprastha Apollo, Medanta, Artemis, Max, Fortis, BLK-Max',
  },
  {
    city: 'Mumbai & Navi Mumbai',
    count: 7,
    note: 'Kokilaben, Reliance Foundation, Asian Heart, Fortis Mulund, Wockhardt',
  },
  { city: 'Chennai', count: 3, note: 'Apollo Chennai, Apollo Proton Cancer Centre' },
  { city: 'Hyderabad', count: 1, note: 'Apollo Hospitals Hyderabad' },
  {
    city: 'Kolkata',
    count: 3,
    note: 'Apollo Multispeciality, Fortis Anandapur, Dharamshila Narayana',
  },
  {
    city: 'Kochi & Thiruvananthapuram',
    count: 4,
    note: 'Aster Medcity, VPS Lakeshore, Amrita, KIMSHEALTH',
  },
  { city: 'Pune & Nagpur', count: 3, note: 'Ruby Hall Clinic, Alexis Multispeciality' },
];

const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/accreditations-certifications`;

const accreditations = [
  {
    abbr: 'JCI',
    full: 'Joint Commission International',
    origin: 'USA',
    color: 'bg-blue-600',
    description:
      'The global arm of the Joint Commission — the same body that accredits Johns Hopkins, Mayo Clinic, and Cleveland Clinic in the United States. JCI surveys hospitals against more than 1,400 measurable elements covering patient safety, infection control, surgical safety, medication management, and patient rights. The 8th edition standards (effective January 2025) add new chapters on healthcare technology (EHR, telehealth, cybersecurity), patient safety event reporting, and expanded requirements for transplant programs and vulnerable patient care.',
    whatItMeans: [
      'Hospital meets the same standards as top US hospitals',
      'Rigorous on-site surveys every 3 years by independent assessors',
      'Focus on patient safety, clinical process quality, and infection control',
      'Internationally recognised as the gold standard for hospital quality',
    ],
    indiaCount: '60+ JCI-accredited hospitals and healthcare organisations in India',
    verifyLabel: 'Verify on JCI official site',
    verifyUrl: 'https://www.jointcommission.org/en',
  },
  {
    abbr: 'NABH',
    full: 'National Accreditation Board for Hospitals & Healthcare Providers',
    origin: 'India (ISQua recognised)',
    color: 'bg-violet-600',
    description:
      'NABH is the Indian accreditation body for hospitals, recognised by the International Society for Quality in Health Care (ISQua). It sets standards for clinical care, patient safety, hospital infrastructure, and staff qualifications across 10 chapters including access to care, patient rights, infection control, and medication management. NABH accreditation is a mark of a well-run hospital that meets documented quality benchmarks.',
    whatItMeans: [
      'Documented standards for clinical and non-clinical processes',
      'Regular surveillance audits to maintain accreditation',
      'ISQua recognition means standards meet global benchmarks',
      'Required by many insurers for cashless treatment',
    ],
    indiaCount: '700+ NABH-accredited hospitals, 29,000+ facilities across all NABH programs',
    verifyLabel: 'Verify on NABH official site',
    verifyUrl: 'https://nabh.co/',
  },
  {
    abbr: 'NABL',
    full: 'National Accreditation Board for Testing and Calibration Laboratories',
    origin: 'India (ILAC MRA)',
    color: 'bg-green-600',
    description:
      'NABL accredits diagnostic laboratories that meet ISO 15189 standards for medical laboratories. A NABL-accredited lab means your blood tests, biopsies, and imaging reports are processed to internationally accepted accuracy and quality levels — critical for correct diagnosis and treatment planning.',
    whatItMeans: [
      'Labs meet ISO 15189 international standard',
      'Equipment calibrated and tested regularly',
      'Reports accepted by hospitals worldwide',
      'Reduces risk of diagnostic errors',
    ],
    indiaCount: 'Thousands of NABL-accredited labs across India',
    verifyLabel: 'Verify on NABL official site',
    verifyUrl: 'https://nabl-india.org/',
  },
  {
    abbr: 'MTQUA',
    full: 'Medical Travel Quality Alliance Certification',
    origin: 'USA (medical tourism specific)',
    color: 'bg-rose-600',
    description:
      'MTQUA is the only international certification specifically for medical tourism quality. It evaluates hospitals on 10 non-clinical areas that directly affect medical tourists: inquiry process, intake procedure, care management after discharge, website and marketing transparency, communication procedures, privacy and security, multicultural sensitivity, international patient services department, care support services, and operations. Fortis Hospital Bannerghatta was the first Indian hospital to achieve MTQUA certification (2014).',
    whatItMeans: [
      'Only certification focused specifically on medical tourist care',
      'Evaluates the full international patient journey, not just clinical care',
      'Reviews multicultural sensitivity and international patient services',
      'Checks post-discharge follow-up for patients returning home',
    ],
    indiaCount: 'Select Indian hospitals hold MTQUA certification',
    verifyLabel: 'Learn more on MTQUA site',
    verifyUrl: 'https://mtqua.org/',
  },
  {
    abbr: 'AAHRPP',
    full: 'Association for Accreditation of Human Research Protection Programs',
    origin: 'USA',
    color: 'bg-indigo-600',
    description:
      'AAHRPP accredits organisations that conduct human research, ensuring they meet rigorous standards for ethical research practices, participant protection, and informed consent. Hospitals with AAHRPP accreditation demonstrate institutional commitment to research ethics and patient protection in clinical trials — important if your treatment involves experimental therapies or clinical studies.',
    whatItMeans: [
      'Ethical oversight of human research and clinical trials',
      'Informed consent and participant protection standards',
      'Independent review of research protocols',
      'Commitment to research ethics and patient safety',
    ],
    indiaCount: 'Select Indian hospitals and research institutions hold AAHRPP',
    verifyLabel: 'Verify on AAHRPP official site',
    verifyUrl: 'https://www.aahrpp.org/',
  },
  {
    abbr: 'ISO 9001',
    full: 'ISO 9001:2015 Quality Management System',
    origin: 'International (ISO)',
    color: 'bg-amber-600',
    description:
      'ISO 9001 is the world\u2019s most widely used quality management standard. It assesses an organisation\u2019s processes for leadership, document management, internal audits, performance measurement, and continuous improvement. ISO 9001 is not healthcare-specific — it is used by organisations across many industries. In hospitals, it provides a foundation for process consistency, but it does not replace clinical accreditation like JCI or NABH.',
    whatItMeans: [
      'Documented quality management system',
      'Regular internal audits and corrective action processes',
      'Process consistency across departments',
      'Foundation for quality, but not a clinical accreditation',
    ],
    indiaCount: 'Widely held across Indian hospitals and organisations',
    verifyLabel: 'Learn more about ISO 9001',
    verifyUrl: 'https://www.iso.org/standard/62085.html',
  },
  {
    abbr: 'IFEM',
    full: 'International Federation for Emergency Medicine',
    origin: 'International (IFEM)',
    color: 'bg-teal-600',
    description:
      'IFEM Gold Level certification recognises excellence in emergency care. It evaluates emergency departments against international standards for trauma care, resuscitation, emergency protocols, and staff training. SPARSH Hospital Hennur was the first hospital in India to achieve IFEM Gold Level certification — a signal of strong emergency response capability, which matters for surgical patients who may need rapid emergency intervention.',
    whatItMeans: [
      'Emergency department meets international standards',
      'Trained emergency staff and resuscitation protocols',
      'Rapid response capability for surgical complications',
      'Important for surgical patients who may need emergency care',
    ],
    indiaCount: 'First in India — SPARSH Hospital Hennur holds IFEM Gold Level',
    verifyLabel: 'Learn more on IFEM site',
    verifyUrl: 'https://www.ifem.cc/',
  },
];

const faqs = [
  {
    question: 'Why do hospital accreditations matter for medical tourists?',
    answer:
      'Accreditations are an independent verification that a hospital meets documented quality and safety standards. For medical tourists who cannot visit a hospital before travelling, accreditations like JCI and NABH provide assurance that the hospital follows the same protocols as top hospitals in your home country — for surgery, infection control, medication safety, and patient rights.',
  },
  {
    question: 'Is JCI accreditation the same as what US hospitals have?',
    answer:
      'JCI is the international arm of the Joint Commission, which accredits most major US hospitals. The standards are closely aligned, though JCI includes additional criteria for international patients such as language access, medical record translation, and cross-border care coordination. A JCI-accredited hospital in India meets the same core standards as a Joint Commission-accredited hospital in the US. The 8th edition standards (effective January 2025) add new chapters on healthcare technology, patient safety event reporting, and expanded transplant requirements.',
  },
  {
    question: 'What does NABH accreditation mean for my treatment?',
    answer:
      'NABH accreditation means the hospital has been independently assessed against standards for clinical care, patient safety, infrastructure, and staff qualifications. It is recognised by the International Society for Quality in Health Care (ISQua), so the standards meet global benchmarks. Many Indian insurers also require NABH for cashless treatment, which can simplify your billing process.',
  },
  {
    question: 'Do all hospitals in India have these accreditations?',
    answer:
      'No. Only a minority of Indian hospitals are JCI or NABH accredited. We only work with accredited hospitals because accreditation is the most reliable independent signal of quality and safety. When we share hospital options with you, we include the accreditation status of each hospital so you can make an informed choice.',
  },
  {
    question: "Can I verify a hospital's accreditation myself?",
    answer:
      'Yes. JCI maintains a public directory of accredited organisations on its website. NABH and NABL also have searchable directories. We share the accreditation details of every hospital we recommend, and you are welcome to verify them independently before committing to treatment. See the step-by-step verification guide below.',
  },
  {
    question: 'What about doctor qualifications — are those accredited too?',
    answer:
      "Doctor qualifications are verified through medical council registration rather than accreditation. Indian doctors must be registered with the Medical Council of India or state medical councils. Many of our partner doctors also hold fellowships or certifications from US, UK, or German institutions. We share each doctor's qualifications and training history on their profile page.",
  },
  {
    question: 'What does MTQUA certification mean?',
    answer:
      'MTQUA (Medical Travel Quality Alliance) certification is the only international accreditation specifically for medical tourism quality. It evaluates hospitals on 10 non-clinical areas that directly affect medical tourists: the inquiry process, intake procedure, care management after discharge, website transparency, communication, privacy, multicultural sensitivity, international patient services, care support, and operations. Fortis Hospital Bannerghatta was the first Indian hospital to achieve MTQUA certification in 2014. It is a strong signal that a hospital is set up specifically to serve international patients well.',
  },
  {
    question: 'What is AAHRPP accreditation and why does it matter?',
    answer:
      'AAHRPP (Association for Accreditation of Human Research Protection Programs) accredits organisations that conduct human research, ensuring they meet rigorous standards for ethical research practices, participant protection, and informed consent. Manipal Hospital Old Airport Road holds AAHRPP accreditation. This matters if your treatment involves clinical trials, experimental therapies, or research studies — it ensures your rights and safety are protected if you participate in research.',
  },
  {
    question: 'What does ISO 9001 certification mean for a hospital?',
    answer:
      'ISO 9001:2015 is the world\u2019s most widely used quality management standard. It assesses an organisation\u2019s processes for leadership, document management, internal audits, and continuous improvement. ISO 9001 is not healthcare-specific — it is used across many industries. In a hospital, it provides a foundation for process consistency, but it does not replace clinical accreditation like JCI or NABH. Think of it as a quality management baseline, not a clinical quality certification.',
  },
  {
    question: 'What does accreditation NOT guarantee?',
    answer:
      'Accreditation is a strong signal of quality, but it is not a guarantee. It does not guarantee perfect outcomes — complications can still occur at any accredited hospital. It does not cover complications insurance — your home health insurance and standard travel insurance typically will not pay for treatment abroad or for complications after you return home. It does not guarantee the skill of an individual doctor — you should still check your surgeon\u2019s qualifications, experience, and case volume. And it does not replace your own due diligence: ask about success rates, infection rates, and patient reviews for your specific procedure.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Hospital Accreditations in India — JCI, NABH, NABL, MTQUA Explained',
    url: pageUrl,
    description:
      'Understand JCI, NABH, NABL, MTQUA, AAHRPP, ISO 9001, and IFEM accreditations — what each badge means for your care, how to verify any hospital yourself, and what accreditation does and does not guarantee.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Accreditations', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`Hospital Accreditations in India — JCI, NABH, NABL, MTQUA | ${t.site.name}`}
  description="Understand JCI, NABH, NABL, MTQUA, AAHRPP, ISO 9001, and IFEM accreditations — what each badge means for your care, how to verify any hospital yourself, and what accreditation does and does not guarantee."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-cream-100 text-ink">
      <div
        class="bg-ink/10 pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-blue-600/5 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Accreditations' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div data-anim="stagger-children">
          <span
            class="inline-block rounded-full bg-gradient-accent px-3 py-1 text-xs font-semibold text-white"
          >
            Quality standards
          </span>
          <h1
            class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            JCI, NABH, NABL, MTQUA — what each badge means for your care
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            When you travel for treatment, you need to know the hospital meets international quality
            standards. Here is what each accreditation means, how to verify any hospital yourself,
            and what accreditation does and does not guarantee — so you can choose with confidence.
          </p>
        </div>
      </div>
    </section>

    {/* ── ACCREDITATION CARDS ──────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container">
        <div class="space-y-6">
          {
            accreditations.map((acc) => (
              <div
                class="rounded-card border border-cream-300 bg-cream-100 p-6 md:p-8"
                data-anim="fade-in-up"
              >
                <div class="grid gap-6 lg:grid-cols-[auto_1fr] lg:gap-8">
                  {/* Badge */}
                  <div class="flex flex-col items-start gap-3">
                    <span
                      class={`inline-flex items-center justify-center rounded-2xl ${acc.color} px-5 py-3 font-display text-2xl font-bold text-white shadow-base`}
                    >
                      {acc.abbr}
                    </span>
                    <span class="text-ink/60 rounded-full bg-cream-200 px-3 py-1 text-xs font-medium">
                      {acc.origin}
                    </span>
                  </div>

                  {/* Content */}
                  <div>
                    <h2 class="font-display text-xl font-bold text-ink">{acc.full}</h2>
                    <p class="text-ink/70 mt-3 text-sm leading-relaxed">{acc.description}</p>

                    {/* What it means */}
                    <div class="mt-5">
                      <p class="text-xs font-semibold uppercase tracking-widest text-ink">
                        What it means for you
                      </p>
                      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                        {acc.whatItMeans.map((item) => (
                          <li class="text-ink/70 flex items-start gap-2 text-sm">
                            <span class="bg-ink/10 mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-violet-600">
                              <Icon name="check" size={12} className="text-ink" />
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <p class="text-ink/70 mt-5 inline-flex items-center gap-2 rounded-full bg-cream-200 px-3 py-1.5 text-xs font-semibold">
                      <Icon name="globe" size={12} className="text-ink/50" />
                      {acc.indiaCount}
                    </p>

                    <a
                      href={acc.verifyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 hover:text-violet-700"
                    >
                      {acc.verifyLabel}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── WHAT ACCREDITATION DOES NOT COVER ────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          What accreditation does not guarantee
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          Accreditation is a strong signal of quality, but it is not a guarantee. Knowing what it
          does not cover helps you ask the right questions before committing to treatment.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Perfect outcomes</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              Complications can still occur at any accredited hospital. Accreditation verifies that
              safety protocols exist and are followed — it does not eliminate clinical risk.
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Complications insurance</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              Your home health insurance and standard travel insurance typically will not pay for
              treatment abroad or for complications after you return home. Ask about medical travel
              insurance that covers complications.
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">Individual doctor skill</h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              Accreditation covers the hospital, not the individual surgeon. You should still check
              your doctor\u2019s qualifications, experience, and case volume for your specific
              procedure.
            </p>
          </div>

          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <div class="mb-3 flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-rose-100"
                aria-hidden="true"
              >
                <Icon name="close" size={16} className="text-rose-700" />
              </span>
              <h3 class="font-display text-base font-bold text-ink">
                A substitute for due diligence
              </h3>
            </div>
            <p class="text-ink/70 text-sm leading-relaxed">
              Accreditation is a baseline check, not a complete answer. Ask about success rates,
              infection rates, and patient reviews for your specific procedure before deciding.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── HOW TO VERIFY ────────────────────────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-4xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          How to verify a hospital\u2019s accreditation yourself
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          You can check any hospital\u2019s accreditation status in under 2 minutes using the
          official directories. Always check the expiry date, not just whether a certificate exists
          \u2014 accreditation can lapse if a hospital does not maintain standards.
        </p>
