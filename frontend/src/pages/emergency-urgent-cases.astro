---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../design-system/components/organisms/Navbar';
import { Footer } from '../design-system/components/organisms/Footer';
import { LeadForm } from '../design-system/components/organisms/LeadForm';
import { FAQAccordion } from '../design-system/components/organisms/FAQAccordion';
import { Icon } from '../design-system/components/atoms/Icon';
import Breadcrumb from '../design-system/components/molecules/Breadcrumb.astro';
import { getTranslations } from '../lib/i18n';
import { getNavLinks } from '../lib/navigation';
import { getFooterLegalLinks } from '../lib/footer';
import { getTreatments } from '../lib/content';
import { getInquiryLink } from '../lib/whatsapp';
import { LEAD_SOURCE } from '../lib/crm';
import { medicalWebPage, breadcrumbs, faqPage } from '../lib/schema';

const locale = 'en';
const t = getTranslations(locale);

const treatmentEntries = await getTreatments(locale);
const treatmentOptions = treatmentEntries.map((entry) => ({
  value: entry.data.name,
  label: entry.data.name,
}));

const _whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986';
const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861';
const whatsappInquiryHref = getInquiryLink();

const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const pageUrl = `${siteUrl}/emergency-urgent-cases`;

const urgentPathways = [
  'Oncology — biopsy pending, staging needed, or treatment delay at home',
  'Cardiac — angioplasty, bypass, or valve surgery with worsening symptoms',
  'Transplant — liver or kidney evaluation with limited local options',
  'Neurosurgery — brain or spine cases needing rapid specialist access',
];

const urgentSteps = [
  'Coordinator acknowledges receipt — WhatsApp is fastest.',
  'Reports are sent to relevant hospital international desks same day when possible.',
  'You receive hospital fit, timeline, and indicative cost range as soon as reviewed.',
  'Visa invitation and travel planning are accelerated for confirmed pathways.',
];

// Condition-by-urgency table — what genuinely qualifies as fast-track and why.
// Based on clinical guidance summarised by Shifam Health and Afiya India (2025).
const urgencyConditions = [
  {
    condition: 'Acute cardiac event',
    examples: 'Heart attack, unstable angina at rest, critical valve disease',
    whyUrgent:
      'Every hour of delay increases muscle damage and mortality. Revascularisation within hours, not days, is the standard of care.',
    fastTrack: true,
  },
  {
    condition: 'Stroke requiring intervention',
    examples: 'Ischaemic stroke within thrombolysis window, large haemorrhage',
    whyUrgent:
      'Time-critical. Thrombolysis and thrombectomy windows are measured in minutes and hours from symptom onset.',
    fastTrack: true,
  },
  {
    condition: 'Rapidly progressing cancer',
    examples:
      'New diagnosis with biopsy pending, staging needed, treatment delay worsening prognosis',
    whyUrgent:
      'Tumour biology can shift quickly. Delay in staging or starting therapy can reduce survival chances for aggressive cancers.',
    fastTrack: true,
  },
  {
    condition: 'Organ failure or transplant evaluation',
    examples:
      'Liver or kidney failure with limited local transplant options, confirmed donor match',
    whyUrgent:
      'A confirmed donor match has a narrow window. Decompensating organ failure can make the patient too sick to transplant.',
    fastTrack: true,
  },
  {
    condition: 'Neurosurgical emergency',
    examples:
      'Spinal cord compression, raised intracranial pressure, brain tumour with mass effect',
    whyUrgent:
      'Neurological deficit can become irreversible within hours to days. Early decompression or resection preserves function.',
    fastTrack: true,
  },
  {
    condition: 'Sepsis or critical infection',
    examples: 'Severe sepsis, necrotising infection, uncontrolled diabetic infection',
    whyUrgent:
      'Sepsis mortality rises hourly without appropriate source control and antibiotics. Travel may not be safe — stabilise locally first.',
    fastTrack: false,
  },
];

// Emergency medical visa reality — official e-Visa portal + Shifam/HeyDocta 2025.
// No facilitator, hospital, or embassy can guarantee visa approval timing.
const visaOptions = [
  {
    type: 'e-Medical Visa (e-Medical)',
    standardTime: '3–5 working days',
    urgentTime: '24–72 hours (case-dependent, not guaranteed)',
    validity: '60 days from arrival, triple entry',
    notes:
      'Online application via indianvisaonline.gov.in. Hospital invitation letter required. Apply minimum 4 days before arrival.',
  },
  {
    type: 'Regular Medical Visa (embassy/consulate)',
    standardTime: '5–10 working days',
    urgentTime: '2–3 days with strong medical documentation',
    validity: 'Up to 1 year, multiple entry',
    notes:
      'For nationalities not eligible for e-Visa, or for longer treatment courses. Extension possible via FRRO in India.',
  },
  {
    type: 'Medical Attendant Visa (MX-Visa)',
    standardTime: 'Processed alongside patient visa',
    urgentTime: 'Same timeline as patient visa',
    validity: 'Matches patient visa',
    notes:
      'Up to 2 attendants. We prioritise attendant documentation so a family member travels with the patient.',
  },
];

// Air ambulance & medical evacuation options — verified against AeroCare,
// EMSOS, Healers Global, REVA, and HappyFares 2025 cost data.
const airAmbulanceOptions = [
  {
    option: 'Dedicated air ambulance (ICU-equipped jet)',
    bestFor:
      'Critically ill patients needing ICU-level care in transit — ventilator, cardiac monitoring, ECMO',
    crew: 'Critical-care doctor + flight nurse',
    indicativeCost:
      'Domestic India: ₹2.5–18 lakh. International: ₹15 lakh–₹1.5 crore+ depending on distance',
    mobilisation: 'Typically 4–6 hours once approved',
  },
  {
    option: 'Commercial stretcher on scheduled flight',
    bestFor: 'Stable patients who cannot sit but do not need full ICU support',
    crew: 'Medical escort (doctor or nurse)',
    indicativeCost:
      'Domestic: ₹3–5 lakh. International: lower than dedicated jet, varies by airline and route',
    mobilisation: 'Subject to airline schedule — usually 24–48 hours',
  },
  {
    option: 'Medical escort on regular flight',
    bestFor: 'Stable, ambulatory patients who need monitoring but can sit upright',
    crew: 'Doctor or nurse escort',
    indicativeCost:
      'Cost of business/first-class seats + medical escort fee (typically $5,000–$25,000 international)',
    mobilisation: 'Next available commercial flight',
  },
  {
    option: 'Ground ambulance (airport to hospital)',
    bestFor: 'Both ends of any air transfer — never optional for a sick patient',
    crew: 'Paramedic crew',
    indicativeCost: '₹5,000–₹50,000 depending on city and distance',
    mobilisation: 'Pre-arranged before flight lands',
  },
];

// Legal protections for foreign patients in India — verified primary sources.
const legalProtections = [
  {
    source: 'Parmanand Katara v. Union of India (1989) 4 SCC 286',
    body: 'Supreme Court of India',
    what: 'Every doctor — government or private — has a professional obligation to provide immediate medical treatment to preserve life. No procedural law can interfere with this duty.',
  },
  {
    source: 'Indian Medical Council Regulations, 2002 §2.1',
    body: 'Medical Council of India',
    what: 'In case of emergency, a physician must treat the patient. Arbitrary refusal of treatment is professional misconduct, punishable by suspension or removal from the medical register.',
  },
  {
    source: 'Consumer Protection Act, 2019',
    body: 'Government of India',
    what: 'Healthcare services are covered. Foreign patients have the same consumer rights as Indian citizens for deficiency in service or medical negligence.',
  },
];

// "Too sick to travel" decision framework — who decides, what happens.
const travelFitnessOptions = [
  {
    scenario: 'Patient is stable enough to fly commercially',
    action:
      'Medical escort on a scheduled flight. Cheapest option that is still safe for a monitored patient.',
  },
  {
    scenario: 'Patient needs monitoring but cannot sit for hours',
    action:
      'Commercial stretcher on a scheduled flight with medical escort. Subject to airline availability.',
  },
  {
    scenario: 'Patient needs ICU-level care throughout the flight',
    action:
      'Dedicated air ambulance with critical-care doctor and nurse. Most expensive, but the only safe option for unstable patients.',
  },
  {
    scenario: 'Patient is too unstable to move at all',
    action:
      'Hospital advises stabilising treatment locally first, or a teleconsultation with the Indian specialist. Travel is reconsidered once the patient is fit to fly. The treating hospital — not the facilitator — makes this call.',
  },
];

// Insurance for emergency medical travel — what standard policies do and do not cover.
const insurancePoints = [
  {
    covers: false,
    point:
      'Most home-country health insurance does not cover treatment abroad. Check your policy before assuming coverage.',
  },
  {
    covers: false,
    point:
      'Standard travel insurance usually excludes treatment for pre-existing conditions and planned medical procedures.',
  },
  {
    covers: false,
    point:
      'Neither standard health nor travel insurance typically covers complications after you return home from treatment abroad.',
  },
  {
    covers: true,
    point:
      'Dedicated medical travel insurance can cover complications during and after treatment abroad. Ask for a policy that explicitly covers medical tourism complications and medical evacuation.',
  },
  {
    covers: true,
    point:
      'Travel insurance with emergency medical evacuation benefit can cover air ambulance costs. Experts recommend at least $100,000 medical coverage and $500,000 evacuation coverage for India travel.',
  },
  {
    covers: true,
    point:
      'We help coordinate insurance claim documentation — hospital letters, medical reports, and itemised bills — but we do not sell insurance and cannot guarantee claim approval.',
  },
];

const faqs = [
  {
    question: 'How quickly can you respond to an urgent enquiry?',
    answer:
      'We acknowledge urgent enquiries on WhatsApp within hours, not days. Once reports are received, we send them to relevant hospital international desks the same day when possible. Hospital fit, timeline, and indicative cost range are shared as soon as the hospital reviews the case — typically within 24–48 hours.',
  },
  {
    question: 'What documents should I send for an urgent case?',
    answer:
      'Send whatever you have immediately — even partial files help us start hospital outreach. Useful documents include: biopsy or pathology reports, imaging summaries (CT/MRI/echo), doctor notes or referral letters, current medication list, and passport copy. We tell you exactly what else is needed while the review is underway.',
  },
  {
    question: 'Can you fast-track a medical visa for urgent cases?',
    answer:
      'Yes. Once a hospital confirms a treatment pathway, we expedite the invitation letter and coordinate with the embassy or e-visa portal to accelerate processing. In some cases, hospitals can issue a priority invitation letter that supports emergency visa applications. Visa approval timing still depends on the Indian government and your country of application.',
  },
  {
    question: 'What if the patient is too sick to travel?',
    answer:
      'We coordinate with the hospital to assess whether the patient is fit to travel based on the medical reports. If air travel is not advisable, the hospital may advise a teleconsultation first or recommend stabilising treatment locally before travel. For patients who can travel with medical support, we arrange ambulance transfers and medical escort on the flight.',
  },
  {
    question: 'Is there an extra charge for urgent case coordination?',
    answer:
      'No. Our coordination service is the same regardless of urgency. You pay the hospital directly for treatment. We do not charge patients for hospital matching, report review, visa coordination, or travel planning. Our role is to make the pathway faster and clearer for your family.',
  },
  {
    question: 'Can a family member travel with an urgent patient?',
    answer:
      'Yes. Attendant visas are arranged alongside the patient visa, even on expedited timelines. We prioritise attendant visa documentation so a family member can travel with the patient from the start. Up to two attendants are typically allowed on an MX-Visa.',
  },
  {
    question: 'What emergency numbers should I save before travelling to India?',
    answer:
      "Save 112 — India's all-emergencies number (works from foreign SIMs, even on locked phones, in English). 108 is the free government ambulance service in most states. 100 reaches police. Also save your hospital's emergency department number and our 24/7 concierge line (+8801611892986). If someone is in immediate life-threatening danger, call 112 first, then contact us.",
  },
  {
    question: 'How much does an air ambulance to India cost?',
    answer:
      "Indicative costs (2025): a dedicated domestic air ambulance within India ranges from ₹2.5 lakh to ₹18 lakh depending on distance and aircraft type. International medical evacuation ranges from ₹15 lakh to ₹1.5 crore or more — a regional mission to the Gulf or East Africa sits at the lower end, long-haul to Europe or North America at the higher end. A commercial stretcher with medical escort is cheaper (domestic ₹3–5 lakh). A medical escort on a regular flight is the most affordable option for stable patients. Costs are not fixed — we coordinate quotes from vetted providers once we know the patient's condition and route.",
  },
  {
    question: 'What happens if complications arise during treatment in India?',
    answer:
      'JCI- and NABH-accredited hospitals maintain 24/7 ICU teams, emergency blood banks, and structured complication response protocols. When a complication occurs, the surgical and anaesthesia team stabilises the patient first, then escalates to the relevant specialist if needed. Indian law (Parmanand Katara v. Union of India, 1989) requires every hospital to provide emergency treatment regardless of nationality or ability to pay. Refusing emergency care is professional misconduct under the Indian Medical Council Regulations, 2002. Foreign patients have the same consumer protection rights as Indian citizens. Our coordinator supports family communication, visa extensions, and insurance documentation — but clinical decisions are made by the treating hospital, not by us.',
  },
  {
    question: 'What are my legal rights as a foreign patient in India?',
    answer:
      'You have the right to informed consent, a second opinion, access to your medical records, language interpretation, and a formal complaint process. JCI and NABH accreditation requires hospitals to uphold these rights. Under the Consumer Protection Act, 2019, healthcare services are covered — so you have legal recourse for deficiency in service or negligence, the same as an Indian citizen. The Supreme Court of India (Parmanand Katara, 1989) established that every doctor has a duty to provide emergency treatment, and the Indian Medical Council Regulations, 2002 §2.1 make refusal of emergency care professional misconduct.',
  },
  {
    question: 'Does my insurance cover emergency medical travel to India?',
    answer:
      'Most home-country health insurance does not cover treatment abroad. Standard travel insurance usually excludes pre-existing conditions and planned medical procedures, and typically does not cover complications after you return home. You need dedicated medical travel insurance that explicitly covers medical tourism complications and medical evacuation. Experts recommend at least $100,000 in medical coverage and $500,000 in evacuation coverage for India. We help coordinate claim documentation — hospital letters, reports, itemised bills — but we do not sell insurance and cannot guarantee claim approval. Ask your insurer before travelling.',
  },
];

const jsonLd = [
  medicalWebPage({
    name: 'Emergency & Urgent Medical Cases',
    url: pageUrl,
    description:
      'Fast-track support for time-sensitive medical travel to India — oncology, cardiac, transplant, and neurosurgery cases that cannot wait.',
    inLanguage: 'en',
  }),
  breadcrumbs([
    { name: t.nav.home, url: `${siteUrl}/` },
    { name: 'Emergency & Urgent Cases', url: `${pageUrl}/` },
  ]),
];

jsonLd.push(faqPage({ entries: faqs }));
---

<Layout
  title={`Emergency & Urgent Cases | ${t.site.name}`}
  description="Fast-track support for time-sensitive medical travel to India — oncology, cardiac, transplant, and neurosurgery cases that cannot wait."
  locale={locale}
  jsonLd={jsonLd}
>
  <Navbar
    brand={t.site.name}
    links={getNavLinks(locale)}
    cta={{ label: t.nav.cta, href: '/contact' }}
    locale={locale}
    currentPath={Astro.url.pathname}
    phoneNumber={import.meta.env.PUBLIC_PHONE_NUMBER || '919606624861'}
    callLabel={t.nav.call}
    whatsappHref={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986'}`}
    whatsappLabel={t.nav.whatsapp}
    client:load
  />

  <main>
    {/* ── HERO (warning-red soft background) ───────────────────────── */}
    <section class="relative overflow-hidden bg-red-50 text-ink">
      <div
        class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-red-200/40 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-48 -left-24 h-[26rem] w-[26rem] rounded-full bg-red-100/50 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
        <Breadcrumb
          items={[{ label: t.nav.home, href: '/' }, { label: 'Emergency & Urgent Cases' }]}
          class="mb-10"
          data-anim="fade-in-up"
        />

        <div
          class="rounded-2xl border border-red-200 bg-white/80 px-6 py-12 shadow-base md:px-12 md:py-14"
          data-anim="stagger-children"
        >
          <span
            class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-red-700"
          >
            <Icon name="alert" size={14} />
            Urgent pathway
          </span>
          <h1
            class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl"
            data-anim="headline-reveal"
          >
            Fast-track support for time-sensitive cases
          </h1>
          <p class="text-ink/70 mt-4 max-w-2xl text-lg leading-relaxed">
            If cancer, cardiac, transplant, or neurosurgery cannot wait, contact us immediately. We
            prioritize urgent enquiries for hospital matching, invitation letters, and travel
            planning.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={whatsappInquiryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-card bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-700"
              data-anim="press-button"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp urgent line
            </a>
            <a
              href={`tel:+${phoneNumber}`}
              class="inline-flex items-center justify-center gap-2 rounded-card border-2 border-red-600 px-6 py-3 text-sm font-semibold text-red-700 hover:bg-red-50"
              data-anim="press-button"
            >
              <Icon name="phone" size={18} />
              Call +{phoneNumber}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── TWO-COLUMN: LEFT INFO + RIGHT LEAD FORM ──────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container grid gap-8 lg:grid-cols-2 lg:gap-12">
        {/* ── LEFT: stacked info cards ─────────────────────────────── */}
        <div class="space-y-6">
          {/* Important warning */}
          <div class="rounded-card border border-red-200 bg-red-50 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-red-700">Important</p>
            <p class="text-ink/80 mt-3 text-sm leading-relaxed">
              This page is for urgent medical travel coordination — not emergency ambulance care in
              your home country. If someone is in immediate life-threatening danger, call local
              emergency services first, then contact us for India treatment planning.
            </p>
          </div>

          {/* Common urgent pathways */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">
              Common urgent pathways
            </p>
            <h2 class="mt-2 font-display text-xl font-bold text-ink">
              Cases we fast-track most often
            </h2>
            <ul class="mt-4 space-y-3">
              {
                urgentPathways.map((item) => (
                  <li class="text-ink/80 flex items-start gap-3 text-sm">
                    <Icon name="check" size={18} className="mt-0.5 text-violet-600" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <p class="text-ink/60 mt-4 text-sm">
              Share available reports immediately — even partial files help us start hospital
              outreach while you gather remaining documents.
            </p>
          </div>

          {/* What happens on an urgent enquiry */}
          <div class="rounded-card border border-cream-300 bg-cream-100 p-6" data-anim="fade-in-up">
            <p class="text-xs font-semibold uppercase tracking-widest text-ink">
              What happens on an urgent enquiry
            </p>
            <ol class="mt-4 space-y-4">
              {
                urgentSteps.map((step, index) => (
                  <li class="text-ink/80 flex items-start gap-4 text-sm">
                    <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border-2 border-ink text-xs font-bold text-ink">
                      {index + 1}
                    </span>
                    <span class="pt-0.5">{step}</span>
                  </li>
                ))
              }
            </ol>
            <p class="text-ink/60 mt-5 text-sm">
              Learn the full journey on our <a
                href="/how-it-works"
                class="font-semibold text-violet-600 hover:text-violet-700">how it works page</a
              >.
            </p>
          </div>
        </div>

        {/* ── RIGHT: lead form ─────────────────────────────────────── */}
        <div
          class="rounded-card border border-cream-300 bg-cream-100 p-6 shadow-base md:p-8 lg:sticky lg:top-8 lg:self-start"
          data-anim="fade-in-up"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-red-600">Urgent enquiry</p>
          <h2 class="mt-2 font-display text-2xl font-bold text-ink">Send your case now</h2>
          <p class="text-ink/60 mt-2 text-sm">
            Mark your case as urgent. A coordinator will acknowledge receipt on WhatsApp — usually
            within hours, not days.
          </p>
          <div class="mt-6">
            <LeadForm source={LEAD_SOURCE.EMERGENCY} treatments={treatmentOptions} client:load />
          </div>
        </div>
      </div>
    </section>

    {/* ── WHEN A CASE IS GENUINELY URGENT ──────────────────────────── */}
    <section class="bg-cream-100 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-5xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          When a case is genuinely urgent
        </h2>
        <p class="text-ink/60 mb-10 max-w-2xl text-sm" data-anim="fade-in-up">
          "Urgent" is a clinical judgement, not a feeling. The table below explains which conditions
          genuinely qualify for fast-track and why time matters. If your situation matches one of
          these, contact us immediately — and share whatever reports you have.
        </p>
        {/* Mobile: stacked cards */}
        <div class="space-y-4 md:hidden">
          {
            urgencyConditions.map((c) => (
              <div class="rounded-card border border-cream-300 bg-cream-100 p-5">
                <div class="flex items-start justify-between gap-3">
                  <p class="text-sm font-semibold text-ink">{c.condition}</p>
                  {c.fastTrack ? (
                    <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">
                      <Icon name="check" size={10} /> Yes
                    </span>
                  ) : (
                    <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">
                      Stabilise first
                    </span>
                  )}
                </div>
                <dl class="mt-3 space-y-2 text-sm">
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      Examples
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{c.examples}</dd>
                  </div>
                  <div>
                    <dt class="text-ink/50 text-xs font-semibold uppercase tracking-widest">
                      Why time matters
                    </dt>
                    <dd class="text-ink/70 mt-0.5">{c.whyUrgent}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>
        {/* Desktop: table */}
        <div class="hidden md:block">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
              <tr class="text-ink/60 border-b border-cream-300 text-xs uppercase tracking-widest">
                <th class="py-3 pr-4 font-semibold">Condition</th>
                <th class="py-3 pr-4 font-semibold">Examples</th>
                <th class="py-3 pr-4 font-semibold">Why time matters</th>
                <th class="py-3 font-semibold">Fast-track?</th>
              </tr>
            </thead>
            <tbody>
              {
                urgencyConditions.map((c) => (
                  <tr class="border-b border-cream-200 align-top">
                    <td class="py-4 pr-4 font-semibold text-ink">{c.condition}</td>
                    <td class="text-ink/70 py-4 pr-4">{c.examples}</td>
                    <td class="text-ink/70 py-4 pr-4">{c.whyUrgent}</td>
                    <td class="py-4">
                      {c.fastTrack ? (
                        <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">
                          <Icon name="check" size={10} /> Yes
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">
                          Stabilise first
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-ink/50 mt-6 text-xs">
          This table is a general guide, not medical advice. The treating hospital makes the final
          call on whether a case qualifies for fast-track based on your reports.
        </p>
      </div>
    </section>

    {/* ── EMERGENCY MEDICAL VISA REALITY ──────────────────────────── */}
    <section class="bg-cream-200 py-16 md:py-20" data-anim="scroll-reveal">
      <div class="container max-w-5xl">
        <h2
          class="mb-4 font-display text-3xl font-bold text-ink md:text-4xl"
          data-anim="fade-in-up"
        >
          Emergency medical visa: the honest reality
        </h2>
