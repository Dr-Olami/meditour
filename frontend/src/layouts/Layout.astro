---
import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/500.css';
import '@fontsource/noto-sans/700.css';
import '@fontsource/noto-sans-bengali/400.css';
import '@fontsource/noto-sans-bengali/700.css';
import '../styles/main.css';
import { medicalBusiness } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  locale?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Whether a Bengali version of this page exists. Reason: country landing
   * pages are English-only for MVP, so they pass false to avoid emitting an
   * hreflang="bn" tag that points to a 404 — hreflang targets must return 200.
   */
  bnAlternate?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  image,
  type = 'website',
  jsonLd,
  bnAlternate = true,
} = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const siteName = locale === 'bn' ? 'খান মেডিট্যুর' : 'Khan Meditour';
const defaultImage =
  'https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=1200&auto=format&fit=crop';
const ogImage = image && (image.startsWith('http') ? image : `${siteUrl}${image}`);

function alternateHref(targetLocale: string): string {
  const path = Astro.url.pathname;
  const withoutPrefix = path.replace(/^\/(en|bn)\//, '/');
  if (targetLocale === 'en') {
    return new URL(withoutPrefix, siteUrl).toString();
  }
  const bnPath = withoutPrefix === '/' ? '/bn/' : `/bn${withoutPrefix}`;
  return new URL(bnPath, siteUrl).toString();
}

const fallbackSchema = medicalBusiness({
  name: siteName,
  url: siteUrl,
  description,
  whatsapp: import.meta.env.PUBLIC_WHATSAPP_NUMBER || '8801611892986',
  email: import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@khanmeditour.com',
  // Reason: listing core specialties helps Google understand the business
  // scope and reduces "field missing" warnings in GSC Enhancements.
  specialties: [
    'Cardiology',
    'Oncology',
    'Orthopedics',
    'Neurology',
    'Nephrology',
    'Bariatric Surgery',
    'Infertility Treatment',
  ],
});
const schemaPayloads = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [fallbackSchema];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager — placed as high in <head> as possible -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-5H9C6TV4');
    </script>
    <!-- End Google Tag Manager -->
    <!-- Display font: General Sans (Fontshare) — closest free match to the reference headline face -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700,800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700,800&display=swap"
      />
    </noscript>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternateHref('en')} />
    {bnAlternate && <link rel="alternate" hreflang="bn" href={alternateHref('bn')} />}
    <link rel="alternate" hreflang="x-default" href={alternateHref('en')} />
    <meta name="description" content={description || 'Khan Meditour'} />

    <!-- Open Graph / Twitter Card -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || 'Khan Meditour'} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage || defaultImage} />
    <meta property="og:locale" content={locale === 'bn' ? 'bn_BD' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || 'Khan Meditour'} />
    <meta name="twitter:image" content={ogImage || defaultImage} />

    {
      schemaPayloads.map((payload) => (
        <script type="application/ld+json" set:html={JSON.stringify(payload)} />
      ))
    }

    <title>{title}</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) — placed immediately after opening <body> -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5H9C6TV4"
        title="Google Tag Manager"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
    <script>
      import { initPageAnimations } from '../design-system/motion/astro';
      initPageAnimations();
    </script>
  </body>
</html>
